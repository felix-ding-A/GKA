{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["hkg1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/images/(.*)",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=31536000, immutable" },
        { "key": "x-sanity-cache-status",  "value": "" },
        { "key": "x-sanity-project-id",    "value": "" },
        { "key": "x-sanity-request-id",    "value": "" },
        { "key": "x-sanity-api-version",   "value": "" },
        { "key": "server",                 "value": "" },
        { "key": "via",                    "value": "" }
      ]
    },
    {
      "source": "/media/files/(.*)",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=31536000, immutable" },
        { "key": "x-sanity-cache-status",  "value": "" },
        { "key": "x-sanity-project-id",    "value": "" },
        { "key": "x-sanity-request-id",    "value": "" },
        { "key": "x-sanity-api-version",   "value": "" },
        { "key": "server",                 "value": "" },
        { "key": "via",                    "value": "" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/media/images/:path*", "destination": "https://cdn.sanity.io/:path*" },
    { "source": "/media/files/:path*", "destination": "https://cdn.sanity.io/files/:path*" }
  ],
  "redirects": [
    { "source": "/blog/egcg-98-percent-green-tea-extract", "destination": "/insights/green-tea-extract-egcg-98-percent-ingredient", "permanent": true },
    { "source": "/blog/glabridin-complete-guide-benefits-mechanism", "destination": "/insights/glabridin-complete-guide", "permanent": true },
    { "source": "/insights/egcg-98-percent-green-tea-extract", "destination": "/insights/green-tea-extract-egcg-98-percent-ingredient", "permanent": true },
    { "source": "/insights/glabridin-complete-guide-benefits-mechanism", "destination": "/insights/glabridin-complete-guide", "permanent": true },
    { "source": "/blog/palmitoyl-tripeptide-38-matrixyl-synthe-6", "destination": "/products/palmitoyl-tripeptide-38", "permanent": true },
    { "source": "/blog/phloretin", "destination": "/products/phloretin", "permanent": true },
    { "source": "/blog/:path*", "destination": "/insights/:path*", "permanent": true },
    { "source": "/es/ru", "destination": "/es", "permanent": true },
    { "source": "/ar/ru", "destination": "/ar", "permanent": true },
    { "source": "/ru/ru", "destination": "/ru", "permanent": true },
    { "source": "/es/ru/:path*", "destination": "/es/:path*", "permanent": true },
    { "source": "/ar/ru/:path*", "destination": "/ar/:path*", "permanent": true },
    { "source": "/ru/ru/:path*", "destination": "/ru/:path*", "permanent": true },
