---

<section class="company-video-section section" id="company-tour" aria-label="Company Tour Video">
  <!-- Subtle ambient glow matching the brand emerald & gold palette -->
  <div class="video-ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <!-- Header -->
    <div class="section-header text-center reveal">
      <span class="section-label">{text.label}</span>
      <h2 class="section-title">
        {text.title_1} <span class="gradient-text--gold">{text.title_2}</span>
      </h2>
      <p class="section-desc">
        {text.desc}
      </p>
    </div>

    <!-- Video Showcase Card (High-Performance Facade Pattern) -->
    <div class="video-showcase-wrapper reveal">
      <div
        class="video-frame"
        id="gkv-video-frame"
        data-video-id={videoId}
        role="region"
        aria-label="Ginkvora Corporate Video Player"
      >
        <!-- High-res thumbnail poster -->
        <img
          src={`https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`}
          alt="Happy New Year from Ginkvora Team! Office Tour & Festive Greetings"
          class="video-poster"
          loading="lazy"
          decoding="async"
          width="1280"
          height="720"
        />

        <!-- Cinematic dark gradient overlay -->
        <div class="video-overlay" aria-hidden="true"></div>

        <!-- Top pill badge -->
        <div class="video-top-badge" aria-hidden="true">
          <span class="badge-dot"></span>
          <span>{text.badge}</span>
        </div>

        <!-- Central Pulsating Gold Play Button -->
        <button
          type="button"
          class="video-play-btn"
          id="gkv-play-btn"
          aria-label={text.play_btn}
        >
          <span class="play-pulse-ring" aria-hidden="true"></span>
          <span class="play-pulse-ring delay" aria-hidden="true"></span>
          <span class="play-icon-circle">
            <svg class="play-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5.14v14.72a1 1 0 0 0 1.5.86l12-7.36a1 1 0 0 0 0-1.72l-12-7.36a1 1 0 0 0-1.5.86z"/>
            </svg>
          </span>
          <span class="play-label">{text.play_btn}</span>
        </button>

        <!-- Bottom bar info -->
        <div class="video-bottom-bar">
          <div class="video-info-left">
            <span class="video-tag">HQ TOUR</span>
            <span class="video-caption">{text.duration}</span>
          </div>
          <a
            href={`https://www.youtube.com/watch?v=${videoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="video-external-link"
            aria-label="Open video on YouTube in a new tab"
            title="Open on YouTube"
          >
            <span>YouTube</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Trust Feature Cards Below Video -->
    <div class="video-trust-grid reveal">
      <div class="trust-card glass">
        <div class="trust-card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="trust-card-body">
          <h3 class="trust-card-title">{text.feature1_title}</h3>
          <p class="trust-card-desc">{text.feature1_desc}</p>
        </div>
      </div>

      <div class="trust-card glass">
        <div class="trust-card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div class="trust-card-body">
          <h3 class="trust-card-title">{text.feature2_title}</h3>
          <p class="trust-card-desc">{text.feature2_desc}</p>
        </div>
      </div>

      <div class="trust-card glass">
        <div class="trust-card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="trust-card-body">
          <h3 class="trust-card-title">{text.feature3_title}</h3>
          <p class="trust-card-desc">{text.feature3_desc}</p>
        </div>
      </div>
    </div>

    <!-- Official Channel CTA Link -->
    <div class="video-channel-cta reveal">
      <a
        href="https://www.youtube.com/@Ginkvora"
        target="_blank"
        rel="noopener noreferrer"
        class="channel-link"
      >
        <svg class="yt-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>{text.youtube_link}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- SEO Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
</section>

<script>
  function initVideoFacade() {
    const videoFrame = document.getElementById('gkv-video-frame');
    const playBtn = document.getElementById('gkv-play-btn');
    if (!videoFrame || !playBtn) return;

    function loadIframe() {
      const videoId = videoFrame.getAttribute('data-video-id');
      if (!videoId || videoFrame.classList.contains('is-loaded')) return;

      const iframe = document.createElement('iframe');
      iframe.setAttribute(
        'src',
        `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
      );
      iframe.setAttribute('title', 'Happy New Year from Ginkvora Team! Office Tour & Festive Greetings');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute(
        'allow',
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      );
      iframe.setAttribute('allowfullscreen', '');
      iframe.className = 'video-iframe';

      videoFrame.innerHTML = '';
      videoFrame.appendChild(iframe);
      videoFrame.classList.add('is-loaded');
    }

    playBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      loadIframe();
    });

    videoFrame.addEventListener('click', () => {
      loadIframe();
    });

    // Keyboard accessibility
    videoFrame.setAttribute('tabindex', '0');
    videoFrame.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        loadIframe();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoFacade);
  } else {
    initVideoFacade();
  }
  document.addEventListener('astro:page-load', initVideoFacade);
</script>

<style>
  .company-video-section {
    position: relative;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: var(--color-bg);
    overflow: hidden;
  }

  /* Ambient atmospheric backglow */
  .video-ambient-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(300px, 60vw, 800px);
    height: clamp(200px, 40vw, 500px);
    background: radial-gradient(circle, rgba(212, 166, 84, 0.12) 0%, rgba(5, 150, 105, 0.05) 50%, transparent 75%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .section-header {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    position: relative;
    z-index: 1;
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 2.85rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.85rem;
    color: var(--color-text);
  }

  .section-desc {
    max-width: 680px;
    margin-inline: auto;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* Video Showcase Card */
  .video-showcase-wrapper {
    max-width: 1040px;
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl, 1.25rem);
    overflow: hidden;
    background: #080b0f;
    border: 1px solid rgba(212, 166, 84, 0.28);
    box-shadow:
      0 24px 60px -15px rgba(0, 0, 0, 0.85),
      0 0 50px -10px rgba(212, 166, 84, 0.18);
    cursor: pointer;
    transition: border-color var(--transition-base, 0.3s), box-shadow var(--transition-base, 0.3s), transform var(--transition-base, 0.3s);
  }

  .video-frame:hover {
    border-color: rgba(240, 200, 120, 0.55);
    box-shadow:
      0 30px 70px -15px rgba(0, 0, 0, 0.95),
      0 0 60px -5px rgba(212, 166, 84, 0.28);
    transform: translateY(-2px);
  }

  .video-frame:focus-visible {
    outline: 2px solid var(--color-primary, #d4a654);
    outline-offset: 4px;
  }

  .video-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-frame:hover .video-poster {
    transform: scale(1.03);
  }

  /* Cinematic overlay with dark vignette */
  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 12, 16, 0.45) 0%,
      rgba(8, 12, 16, 0.2) 40%,
      rgba(8, 12, 16, 0.75) 100%
    );
    pointer-events: none;
  }

  /* Top badge */
  .video-top-badge {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.25rem);
    left: clamp(0.75rem, 2vw, 1.25rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full, 9999px);
    background: rgba(12, 16, 22, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(212, 166, 84, 0.3);
    font-size: 0.75rem;
    font-weight: 500;
    color: #f0c878;
    letter-spacing: 0.04em;
    z-index: 2;
    pointer-events: none;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    display: inline-block;
  }

  /* Play Button */
  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 3;
    padding: 1rem;
    color: #fff;
    transition: transform var(--transition-base, 0.3s);
  }

  .play-icon-circle {
    position: relative;
    width: clamp(64px, 8vw, 84px);
    height: clamp(64px, 8vw, 84px);
    border-radius: 50%;
    background: linear-gradient(135deg, #f0c878 0%, #d4a654 60%, #b48530 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.6),
      0 0 35px rgba(212, 166, 84, 0.55);
    transition: all var(--transition-base, 0.3s);
  }

  .play-svg {
    width: clamp(26px, 3.2vw, 34px);
    height: clamp(26px, 3.2vw, 34px);
    color: #0d1117;
    margin-left: 4px; /* Optical center compensation */
    transition: transform var(--transition-fast, 0.2s);
  }

  /* Concentric Ripple animations */
  .play-pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(64px, 8vw, 84px);
    height: clamp(64px, 8vw, 84px);
    border-radius: 50%;
    border: 2px solid rgba(240, 200, 120, 0.7);
    pointer-events: none;
    animation: goldRipple 2.4s infinite cubic-bezier(0.25, 1, 0.5, 1);
  }

  .play-pulse-ring.delay {
    animation-delay: 1.2s;
  }

  @keyframes goldRipple {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.8;
    }
    100% {
      transform: translate(-50%, -50%) scale(2.2);
      opacity: 0;
    }
  }

  .play-label {
    font-size: clamp(0.85rem, 1.1vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    background: rgba(10, 14, 20, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full, 9999px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all var(--transition-base, 0.3s);
  }

  .video-frame:hover .play-icon-circle {
    transform: scale(1.1);
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.7),
      0 0 50px rgba(240, 200, 120, 0.8);
  }

  .video-frame:hover .play-label {
    background: rgba(212, 166, 84, 0.2);
    border-color: rgba(212, 166, 84, 0.5);
    color: #f0c878;
  }

  /* Bottom bar */
  .video-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
    background: linear-gradient(to top, rgba(6, 9, 12, 0.9) 0%, transparent 100%);
  }

  .video-info-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .video-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 0.25rem);
    background: rgba(212, 166, 84, 0.2);
    border: 1px solid rgba(212, 166, 84, 0.4);
    color: #f0c878;
    letter-spacing: 0.05em;
  }

  .video-caption {
    font-size: clamp(0.8125rem, 1vw, 0.9rem);
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
  }

  .video-external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-sm, 0.25rem);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all var(--transition-fast, 0.2s);
  }

  .video-external-link:hover {
    color: #f0c878;
    background: rgba(212, 166, 84, 0.15);
    border-color: rgba(212, 166, 84, 0.4);
  }

  /* Loaded iframe */
  :global(.video-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    z-index: 10;
  }

  /* Trust feature grid */
  .video-trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
