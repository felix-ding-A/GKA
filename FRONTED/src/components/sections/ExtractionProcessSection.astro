---
// ExtractionProcessSection.astro — 5-step botanical extraction timeline
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);

const step1_tags = lang === 'ar' 
  ? ['مزارع معتمدة من GAP', 'توثيق الأصناف النباتية', 'الفحص المسبق للمعادن الثقيلة'] 
  : (lang === 'ru' 
    ? ['Фермы с сертификатом GAP', 'Аутентификация видов', 'Скрининг тяжелых металлов'] 
    : ['GAP Certified Farms', 'Species Authentication', 'Heavy Metal Pre-screen']);

const step2_tags = lang === 'ar' 
  ? ['استخلاص بثاني أكسيد الكربون sCO₂', 'مراقبة بقايا المذيبات', 'مراقبة مستمرة للعملية'] 
  : (lang === 'ru' 
    ? ['Экстракция sCO₂', 'Контроль остатков растворителей', 'Мониторинг процесса'] 
    : ['sCO₂ Extraction', 'Solvent Residue Control', 'Continuous Process Monitoring']);

const step3_tags = lang === 'ar' 
  ? ['كروماتوغرافيا تحضيرية HPLC', 'الفصل بأعمدة الراتنج', 'درجة نقاء ≥98%'] 
  : (lang === 'ru' 
    ? ['Препаративная ВЭЖХ', 'Колоночное разделение', 'Чистота ≥98%'] 
    : ['Preparative HPLC', 'Resin Column Separation', 'Purity ≥98%']);

const step4_tags = lang === 'ar' 
  ? ['اختبار النقاء بالـ HPLC', 'المعادن الثقيلة بالـ ICP-MS', 'الامتثال لمنهجيات دستور الأدوية USP/EP'] 
  : (lang === 'ru' 
    ? ['Анализ чистоты ВЭЖХ', 'Тяжелые металлы ICP-MS', 'Соответствие методам USP/EP'] 
    : ['HPLC Purity Testing', 'ICP-MS Heavy Metals', 'USP/EP Method Compliance']);

const step5_tags = lang === 'ar' 
  ? ['تعبئة بغاز النيتروجين الخامل', 'شهادة التحليل COA مرفقة', 'شروط الشحن DDP / ExW / FOB متاحة'] 
  : (lang === 'ru' 
    ? ['Упаковка в среде азота', 'Сертификат анализа COA', 'Доставка DDP / ExW / FOB'] 
    : ['Nitrogen-flush Packaging', 'COA Included', 'DDP / ExW / FOB Available']);
---

<section class="extraction-section bg-noise" id="extraction-process" aria-label="Extraction Process">
  <div class="container">
    <div class="extraction-inner">
      <!-- Left: header + timeline -->
      <div class="extraction-content">
        <div class="section-header" style="text-align:left; margin:0 0 3rem;">
          <span class="section-label">{t('extraction.label')}</span>
          <h2 class="section-title">{t('extraction.title')} <em>{t('extraction.title_em')}</em></h2>
          <p class="section-desc">
            {t('extraction.desc')}
          </p>
          <!-- Relocated Trust Badges (GMP/ISO) -->
          <div class="extraction-trust-badges">
            <div class="trust-badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span>{t('hero.trust_gmp')}</span>
            </div>
            <div class="trust-badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M9 12l2 2 4-4"/>
                <circle cx="12" cy="12" r="10"/>
              </svg>
              <span>{t('hero.trust_iso')}</span>
            </div>
            <div class="trust-badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <span>{t('hero.trust_countries')}</span>
            </div>
          </div>
        </div>

    <div class="process-timeline" role="list">

      <!-- Step 1 -->
      <div class="process-step" role="listitem">
        <div class="step-connector">
          <div class="step-node"><span class="step-num">01</span></div>
          <div class="step-line" aria-hidden="true"></div>
        </div>
        <div class="step-content glass reveal">
          <div class="step-icon flex items-center justify-center p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30" aria-hidden="true">
            <svg class="w-6 h-6 text-[var(--color-primary-light)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          </div>
          <div class="step-body">
            <h3>{t('extraction.step1_title')}</h3>
            <p>{t('extraction.step1_desc')}</p>
            <ul class="step-tags">
              {step1_tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="process-step" role="listitem">
        <div class="step-connector">
          <div class="step-node"><span class="step-num">02</span></div>
          <div class="step-line" aria-hidden="true"></div>
        </div>
        <div class="step-content glass reveal reveal-delay-1">
          <div class="step-icon flex items-center justify-center p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30" aria-hidden="true">
            <svg class="w-6 h-6 text-[var(--color-primary-light)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/><circle cx="12" cy="12" r="4"/></svg>
          </div>
          <div class="step-body">
            <h3>{t('extraction.step2_title')}</h3>
            <p>{t('extraction.step2_desc')}</p>
            <ul class="step-tags">
              {step2_tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="process-step" role="listitem">
        <div class="step-connector">
          <div class="step-node"><span class="step-num">03</span></div>
          <div class="step-line" aria-hidden="true"></div>
        </div>
        <div class="step-content glass reveal reveal-delay-2">
          <div class="step-icon flex items-center justify-center p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30" aria-hidden="true">
            <svg class="w-6 h-6 text-[var(--color-primary-light)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18h8M3 22h18M14 22a7 7 0 1 0-14 0M9 14l3-3M9 10l3-3M12 7l3 3"/></svg>
          </div>
          <div class="step-body">
            <h3>{t('extraction.step3_title')}</h3>
            <p>{t('extraction.step3_desc')}</p>
            <ul class="step-tags">
              {step3_tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="process-step" role="listitem">
        <div class="step-connector">
          <div class="step-node"><span class="step-num">04</span></div>
          <div class="step-line" aria-hidden="true"></div>
        </div>
        <div class="step-content glass reveal reveal-delay-3">
          <div class="step-icon flex items-center justify-center p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30" aria-hidden="true">
            <svg class="w-6 h-6 text-[var(--color-primary-light)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="step-body">
            <h3>{t('extraction.step4_title')}</h3>
            <p>{t('extraction.step4_desc')}</p>
            <ul class="step-tags">
              {step4_tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 5 -->
      <div class="process-step process-step--last" role="listitem">
        <div class="step-connector">
          <div class="step-node"><span class="step-num">05</span></div>
        </div>
        <div class="step-content glass reveal reveal-delay-3">
          <div class="step-icon flex items-center justify-center p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30" aria-hidden="true">
            <svg class="w-6 h-6 text-[var(--color-primary-light)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          </div>
          <div class="step-body">
            <h3>{t('extraction.step5_title')}</h3>
            <p>{t('extraction.step5_desc')}</p>
            <ul class="step-tags">
              {step5_tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom CTA -->
    <div class="process-cta">
      <a href={lp('/quality')} class="btn btn--outline">{t('extraction.cta_quality')}</a>
      <a href={lp('/contact')} class="btn btn--gold" data-gkv-event="request_sample_click" data-gkv-location="extraction_process">{t('extraction.cta_sample')}</a>
    </div>
      </div>
      <!-- Right: sticky image stack -->
      <div class="extraction-visual" aria-hidden="true">
        <div class="vis-img vis-img--hq">
          <img
            src="/images/ginkvora-biotechnology-hq-office-workspace.webp"
            alt="GINKVORA high-end biotechnology headquarters office and workspace"
            loading="lazy" width="600" height="400"
          />
          <div class="vis-overlay"></div>
          <div class="vis-label">{t('extraction.vis_hq')}</div>
        </div>
        <div class="vis-img vis-img--top">
          <img
            src="/images/ginkvora GMP Extraction Plant.webp"
            alt="GMP certified cleanroom industrial plant extraction factory floor"
            loading="lazy" width="600" height="400"
          />
          <div class="vis-overlay"></div>
          <div class="vis-label">{t('extraction.vis_plant')}</div>
        </div>
        <div class="vis-img vis-img--bottom">
          <img
            src="/images/ginkvora QC Laboratory.webp"
            alt="State-of-the-art Quality Control laboratory equipped with advanced chromatography instruments"
            loading="lazy" width="600" height="300"
          />
          <div class="vis-overlay"></div>
          <div class="vis-label">{t('extraction.vis_lab')}</div>
        </div>
        <div class="vis-stat-card">
          <div class="vis-stat">
            <span class="vis-stat-num">100%</span>
            <span class="vis-stat-label">{t('extraction.vis_tested')}</span>
          </div>
          <div class="vis-stat">
            <span class="vis-stat-num">≥98%</span>
            <span class="vis-stat-label">{t('extraction.vis_purity')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .extraction-section {
    padding-block: calc(var(--space-4xl) / 2);
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .extraction-section::before {
    content: '';
    position: absolute;
    top: 10%;
    left: -5%;
    width: 40%;
    height: 80%;
    background: radial-gradient(ellipse, rgba(212, 166, 84, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Two-column inner layout ── */
  .extraction-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .extraction-content {
    display: flex;
    flex-direction: column;
  }

  .extraction-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .trust-badge svg {
    color: var(--color-primary-light);
  }

  /* ── Visual panel ── */
  .extraction-visual {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .vis-img {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .vis-img img {
    width: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .vis-img--hq img {
    aspect-ratio: auto;
    height: auto;
  }
  .vis-img--top img { aspect-ratio: 3/2; }
  .vis-img--bottom img { aspect-ratio: 16/9; }

  .vis-img:hover img { transform: scale(1.04); }

  .vis-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6,5,3,0.6) 0%, transparent 50%);
  }

  .vis-label {
    position: absolute;
    bottom: 0.75rem;
    left: 0.875rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255,255,255,0.7);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .vis-stat-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .vis-stat {
    background: var(--color-surface);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .vis-stat-num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary-light);
    line-height: 1;
  }

  .vis-stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .extraction-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .extraction-visual { position: static; }
  }

  /* ── Timeline ── */
  .process-timeline {
    margin-top: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .process-step--last .step-line {
    display: none;
  }

  /* ── Step connector ── */
  .step-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-node {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-bg-deep);
    border: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    box-shadow: 0 0 16px rgba(212, 166, 84, 0.2);
    transition: background var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .process-step:hover .step-node {
    box-shadow: var(--shadow-glow-gold);
    background: var(--color-accent);
    border-color: var(--color-accent-light, #e09040);
  }

  .process-step:hover .step-node .step-num {
    color: var(--color-bg);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-primary-light);
    letter-spacing: 0.05em;
  }

  .step-line {
    width: 2px;
    flex: 1;
    min-height: 2rem;
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    opacity: 0.3;
    margin-top: 4px;
  }

  /* ── Step Content ── */
  .step-content {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    align-items: flex-start;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .step-content:hover {
    border-color: rgba(212, 166, 84, 0.25) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .step-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 2px;
  }

  .step-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-light);
    margin-bottom: 0.5rem;
  }

  .step-body p {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .step-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step-tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── CTA ── */
  .process-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .process-step {
      grid-template-columns: 40px 1fr;
      gap: 1rem;
    }

    .step-node {
      width: 36px;
      height: 36px;
    }

    .step-content {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
