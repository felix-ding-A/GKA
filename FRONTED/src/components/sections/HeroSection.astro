---
// HeroSection.astro — Full-screen hero with gold/black/orange theme
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);
---

<section class="hero" id="hero" aria-label="Hero">
  <!-- Animated background -->
  <div class="hero-bg" aria-hidden="true">
    <picture class="hero-bg-picture">
      <source media="(max-width: 768px)" srcset="/images/hero-bg-mobile.webp" type="image/webp" />
      <img src="/images/hero-bg.webp" alt="" class="hero-bg-img" width="1920" height="1080" fetchpriority="high" decoding="async" aria-hidden="true" />
    </picture>
    <div class="hero-gradient"></div>
    <canvas id="particle-canvas" class="particle-canvas"></canvas>
    <div class="orb orb--1"></div>
    <div class="orb orb--2"></div>
    <div class="orb orb--3"></div>
    <!-- Diagonal light streak -->
    <div class="light-streak" aria-hidden="true"></div>
  </div>

  <div class="container hero-content">
    <!-- Left copy -->
    <div class="hero-left">
      <div class="hero-label fade-in-up">
        <span class="badge badge--gold">
          <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true">
            <circle cx="4" cy="4" r="4"/>
          </svg>
          {t('hero.badge')}
        </span>
      </div>

      <h1 class="hero-title fade-in-up delay-1">
        {t('hero.title_1')}<br class="hidden sm:inline" />
        <span class="gradient-text--gold">{t('hero.title_2')}</span>
      </h1>

      <p class="hero-sub-headline fade-in-up delay-2">
        {t('hero.sub_headline')}
      </p>

      <p class="hero-sub fade-in-up delay-2">
        {t('hero.subtitle')}
      </p>

      <div class="hero-ctas fade-in-up delay-3">
        <a href={lp('/products')} class="btn btn--gold btn--lg" id="hero-explore-btn">
          {t('hero.cta_explore')}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={lp('/contact')} class="btn btn--primary btn--lg" id="hero-quote-btn" data-gkv-event="request_sample_click" data-gkv-location="homepage_hero">
          {t('hero.cta_sample')}
        </a>
      </div>

      <!-- Role-based Routing Anchors -->
      <div class="hero-role-routing fade-in-up delay-4">
        <span class="role-title">{t('hero.role_title')}</span>
        <div class="role-links">
          <a href="#ecm-pathways" class="role-link" id="role-cosmetic">
            <span class="role-bullet" aria-hidden="true">🧴</span>
            {t('hero.role_cosmetic')}
          </a>
          <span class="role-divider" aria-hidden="true">·</span>
          <a href="#dual-track-routes" class="role-link" id="role-supplement">
            <span class="role-bullet" aria-hidden="true">💊</span>
            {t('hero.role_supplement')}
          </a>
          <span class="role-divider" aria-hidden="true">·</span>
          <a href="#extraction-process" class="role-link" id="role-procurement">
            <span class="role-bullet" aria-hidden="true">⚙️</span>
            {t('hero.role_procurement')}
          </a>
        </div>
      </div>
    </div>

    <!-- Right: ingredient showcase -->
    <div class="hero-right fade-in-up delay-2">
      <div class="ingredient-card-stack">
        <!-- Central Molecule Graphic -->
        <div class="central-glow-molecule animate-pulse-slow" aria-hidden="true">
          <div class="molecule-glow"></div>
          <svg class="molecule-svg" width="220" height="220" viewBox="0 0 200 200" fill="none">
            <!-- Orbit rings -->
            <circle cx="100" cy="100" r="50" stroke="rgba(212,166,84,0.12)" stroke-width="1.5" stroke-dasharray="3 3"/>
            <circle cx="100" cy="100" r="75" stroke="rgba(224,120,48,0.08)" stroke-width="1" stroke-dasharray="6 4"/>
            <circle cx="100" cy="100" r="22" fill="rgba(212,166,84,0.06)" stroke="rgba(212,166,84,0.3)" stroke-width="1.5"/>
            <circle cx="100" cy="100" r="6" fill="#d4a654"/>
            
            <!-- Nodes -->
            <circle cx="100" cy="50" r="10" fill="rgba(224,120,48,0.15)" stroke="rgba(224,120,48,0.4)" stroke-width="1.5"/>
            <circle cx="143" cy="75" r="7" fill="rgba(212,166,84,0.15)" stroke="rgba(212,166,84,0.4)" stroke-width="1.5"/>
            <circle cx="143" cy="125" r="9" fill="rgba(224,120,48,0.1)" stroke="rgba(224,120,48,0.3)" stroke-width="1.5"/>
            <circle cx="100" cy="150" r="12" fill="rgba(212,166,84,0.18)" stroke="rgba(212,166,84,0.45)" stroke-width="1.5"/>
            <circle cx="57" cy="125" r="8" fill="rgba(224,120,48,0.12)" stroke="rgba(224,120,48,0.35)" stroke-width="1.5"/>
            <circle cx="57" cy="75" r="11" fill="rgba(212,166,84,0.12)" stroke="rgba(212,166,84,0.35)" stroke-width="1.5"/>

            <!-- Lines -->
            <line x1="100" y1="78" x2="100" y2="60" stroke="rgba(212,166,84,0.3)" stroke-width="1.5"/>
            <line x1="116" y1="109" x2="136" y2="120" stroke="rgba(224,120,48,0.3)" stroke-width="1.5"/>
            <line x1="84" y1="109" x2="64" y2="120" stroke="rgba(224,120,48,0.3)" stroke-width="1.5"/>
            <line x1="116" y1="91" x2="137" y2="79" stroke="rgba(212,166,84,0.3)" stroke-width="1.5"/>
            <line x1="84" y1="91" x2="63" y2="79" stroke="rgba(212,166,84,0.3)" stroke-width="1.5"/>
            <line x1="100" y1="122" x2="100" y2="138" stroke="rgba(212,166,84,0.3)" stroke-width="1.5"/>
          </svg>
        </div>

        <!-- Mini floating cards -->
        <div class="mini-card glass" style="--float-d:0.8s; top:8%; left:-8%;">
          <span class="mini-card-name">{t('hero.ingredient.nmn')}</span>
          <span class="mini-card-purity">≥ 99%</span>
        </div>
        <div class="mini-card glass" style="--float-d:0s; top:0%; left:30%;">
          <span class="mini-card-name">{t('hero.ingredient.salmon_dna')}</span>
          <span class="mini-card-purity">≥ 99%</span>
        </div>
        <div class="mini-card glass" style="--float-d:1.6s; top:12%; right:-8%;">
          <span class="mini-card-name">{t('hero.ingredient.egcg')}</span>
          <span class="mini-card-purity">≥ 98%</span>
        </div>
        <div class="mini-card glass" style="--float-d:2.4s; top:28%; left:-18%;">
          <span class="mini-card-name">{t('hero.ingredient.glabridin')}</span>
          <span class="mini-card-purity">≥ 98%</span>
        </div>
        <div class="mini-card glass" style="--float-d:3.2s; top:32%; right:-16%;">
          <span class="mini-card-name">{t('hero.ingredient.pqq')}</span>
          <span class="mini-card-purity">≥ 99%</span>
        </div>
        <div class="mini-card glass" style="--float-d:1.2s; top:52%; left:-22%;">
          <span class="mini-card-name">{t('hero.ingredient.copper_tripeptide')}</span>
          <span class="mini-card-purity">≥ 99%</span>
        </div>
        <div class="mini-card glass" style="--float-d:2.0s; top:54%; right:-18%;">
          <span class="mini-card-name">{t('hero.ingredient.glucoraphanin')}</span>
          <span class="mini-card-purity">≥ 10%</span>
        </div>
        <div class="mini-card glass" style="--float-d:2.8s; top:72%; left:-10%;">
          <span class="mini-card-name">{t('hero.ingredient.quercetin')}</span>
          <span class="mini-card-purity">≥ 98%</span>
        </div>
        <div class="mini-card glass" style="--float-d:3.6s; top:74%; right:-6%;">
          <span class="mini-card-name">{t('hero.ingredient.luteolin')}</span>
          <span class="mini-card-purity">≥ 98%</span>
        </div>
        <div class="mini-card glass" style="--float-d:0.4s; bottom:2%; left:22%;">
          <span class="mini-card-name">{t('hero.ingredient.liposome_tech')}</span>
          <span class="mini-card-purity">{t('hero.ingredient.delivery_system')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60 C240 100 480 20 720 60 C960 100 1200 20 1440 60 L1440 100 L0 100 Z" fill="var(--color-bg)"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 4.5rem;
  }

  @media (min-width: 1025px) {
    .hero {
      min-height: clamp(600px, 66vh, 720px);
    }
  }

  /* ── Background ── */
  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #030201 0%, #0a0703 35%, #120a04 65%, #060503 100%);
  }

  .hero-bg-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.35;
    mix-blend-mode: screen;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 15% 50%, rgba(212,166,84,0.09) 0%, transparent 70%),
      radial-gradient(ellipse 45% 50% at 85% 25%, rgba(224,120,48,0.08) 0%, transparent 70%),
      radial-gradient(ellipse 35% 40% at 70% 80%, rgba(212,166,84,0.05) 0%, transparent 70%);
  }

  .particle-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    opacity: 0.9;
  }

  /* Glowing orbs - Optimized with radial gradients instead of heavy blur filters */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .orb--1 {
    width: 450px; height: 450px;
    background: radial-gradient(circle at center, rgba(212,166,84,0.15) 0%, rgba(212,166,84,0.05) 40%, transparent 70%);
    top: -15%; left: -8%;
    animation: float 9s ease-in-out infinite;
  }
  .orb--2 {
    width: 320px; height: 320px;
    background: radial-gradient(circle at center, rgba(224,120,48,0.15) 0%, rgba(224,120,48,0.05) 40%, transparent 70%);
    bottom: 5%; right: 5%;
    animation: float 11s ease-in-out infinite 2s;
  }
  .orb--3 {
    width: 220px; height: 220px;
    background: radial-gradient(circle at center, rgba(212,166,84,0.12) 0%, rgba(212,166,84,0.04) 40%, transparent 70%);
    top: 35%; right: 22%;
    animation: float 13s ease-in-out infinite 4s;
  }

  /* Diagonal light streak */
  .light-streak {
    position: absolute;
    top: -10%;
    left: 30%;
    width: 1px;
    height: 130%;
    background: linear-gradient(to bottom, transparent, rgba(212,166,84,0.12) 40%, rgba(224,120,48,0.08) 60%, transparent);
    transform: rotate(15deg);
    pointer-events: none;
  }

  /* ── Content ── */
  .hero-content {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hero-label { display: flex; }

  .hero-title {
    font-size: clamp(2.25rem, 4.2vw, 3.85rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 820px;
  }

  .hero-sub-headline {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: var(--color-primary-light);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
    opacity: 0.95;
    max-width: 780px;
  }

  .hero-sub {
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 720px;
  }

  .hero-sub strong {
    color: var(--color-primary-light);
    font-weight: 500;
  }

  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.25rem; }

  /* Role routing */
  .hero-role-routing {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .role-title {
    font-size: 0.825rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .role-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .role-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary-light);
    text-decoration: none;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.25s ease;
    min-height: 44px;
  }

  .role-link:hover {
    background: rgba(212, 166, 84, 0.08);
    border-color: rgba(212, 166, 84, 0.25);
    color: var(--color-accent-light);
    transform: translateY(-1px);
  }

  .role-bullet {
    font-size: 1rem;
  }

  .role-divider {
    color: var(--color-border-strong);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hero-role-routing {
      align-items: stretch;
      width: 100%;
    }
    .role-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .role-link {
      justify-content: center;
      width: 100%;
      min-height: 48px;
    }
    .role-divider {
      display: none;
    }
  }

  /* ── Ingredient showcase ── */
  .hero-right {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 1rem;
  }

  .ingredient-card-stack {
    position: relative;
    width: 360px;
    height: 500px;
  }

  /* Central Molecule Graphic styles */
  .central-glow-molecule {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
  }

  .molecule-glow {
    position: absolute;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle at center, rgba(212,166,84,0.18) 0%, rgba(224,120,48,0.06) 45%, transparent 75%);
    filter: blur(15px);
    border-radius: 50%;
    pointer-events: none;
  }

  .molecule-svg {
    position: relative;
    z-index: 1;
    opacity: 0.9;
  }

  @keyframes pulse-slow {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.85;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.06);
      opacity: 1;
    }
  }

  .animate-pulse-slow {
    animation: pulse-slow 8s ease-in-out infinite;
  }

  /* Mini cards */
  .mini-card {
    position: absolute;
    padding: 0.625rem 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-color: rgba(212,166,84,0.15) !important;
    animation: float var(--float-d, 0s) ease-in-out infinite;
    animation-delay: var(--float-d, 0s);
    animation-duration: 5s;
    white-space: nowrap;
  }

  .mini-card-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .mini-card-purity {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-primary);
  }

  /* Wave */
  .hero-wave {
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    overflow: hidden;
    line-height: 0;
  }
  .hero-wave svg {
    display: block;
    width: 100%; height: 100px;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .hero-content { gap: 1.5rem; }
    .ingredient-card-stack {
      transform: scale(0.85);
      transform-origin: center right;
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 1.5rem;
      padding-bottom: 5rem;
      gap: 3rem;
    }
    .hero-sub  { max-width: 100%; margin-inline: auto; }
    .hero-ctas { justify-content: center; }
    .hero-trust { justify-content: center; }
    .hero-label { justify-content: center; }
    .hero-right {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .hero-ctas .btn { justify-content: center; }
  }
</style>

<script>
  // Particle canvas — gold/orange ambient particle network
  function initHeroParticles() {
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
    const heroSection = document.getElementById('hero');

    if (!canvas || !heroSection) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let particles: Array<{x:number;y:number;vx:number;vy:number;size:number;opacity:number;color:string}> = [];
    let animFrame: number;
    let isVisible = true;
    let isMobile = window.innerWidth < 768;

    const colors = [
      'rgba(212, 166, 84, ',
      'rgba(240, 200, 120, ',
      'rgba(224, 120, 48, ',
      'rgba(160, 120, 48, ',
    ];

    function resize() {
      if (!canvas) return;
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      const wasMobile = isMobile;
      isMobile = window.innerWidth < 768;
      if (wasMobile && !isMobile && isVisible) {
        animFrame = requestAnimationFrame(draw);
      }
    }

    function createParticles() {
      if (isMobile) return;
      particles = [];
      const density = 9000;
      const count = Math.floor((canvas.width * canvas.height) / density);
      
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          size: Math.random() * 2.5 + 0.8,
          opacity: Math.random() * 0.55 + 0.2,
          color: colors[Math.floor(Math.random() * colors.length)],
        });
      }
    }

    function draw() {
      if (!isVisible || isMobile) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach((p) => {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `${p.color}${p.opacity})`;
        ctx.fill();
      });

      // Connect nearby particles on desktop
      if (!isMobile) {
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            if (dist < 110) {
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.strokeStyle = `rgba(212,166,84,${(1 - dist/110) * 0.12})`;
              ctx.stroke();
            }
          }
        }
      }
      animFrame = requestAnimationFrame(draw);
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          isVisible = true;
          animFrame = requestAnimationFrame(draw);
        } else {
          isVisible = false;
          cancelAnimationFrame(animFrame);
        }
      });
    }, { rootMargin: "0px", threshold: 0 });

    resize(); 
    if (!isMobile) {
      createParticles(); 
    }
    observer.observe(heroSection);

    let resizeTimer: any;
    const onResize = () => { 
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        resize(); 
        createParticles();
      }, 200);
    };
    window.addEventListener('resize', onResize, { passive: true });
    
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animFrame);
      observer.disconnect();
      window.removeEventListener('resize', onResize);
    }, { once: true });
  }

  initHeroParticles();
  document.addEventListener('astro:page-load', initHeroParticles);
</script>
