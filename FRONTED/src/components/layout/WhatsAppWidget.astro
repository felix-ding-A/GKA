---
// src/components/layout/WhatsAppWidget.astro — Floating WhatsApp Customer Support Button
// Matches shop.ginkvora styling and avoids overlapping Chatwoot live chat & back-to-top buttons
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const tooltips: Record<string, string> = {
  en: 'Chat with us on WhatsApp',
  ar: 'تحدث معنا عبر واتساب',
  es: 'Chatea con nosotros en WhatsApp',
  ru: 'Напишите нам в WhatsApp',
};

const ariaLabels: Record<string, string> = {
  en: 'Chat with GINKVORA on WhatsApp',
  ar: 'تحدث مع جينكفورا عبر واتساب',
  es: 'Chatear con GINKVORA en WhatsApp',
  ru: 'Связаться с GINKVORA в WhatsApp',
};

const tooltip = tooltips[lang] || tooltips.en;
const ariaLabel = ariaLabels[lang] || ariaLabels.en;
---

<aside id="gv-whatsapp-widget" class="gv-whatsapp-widget" aria-label="WhatsApp Support">
  <a
    id="gv-whatsapp-link"
    class="gv-whatsapp-btn"
    href="https://wa.me/8613201818603"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ariaLabel}
    title={tooltip}
  >
    <svg class="gv-whatsapp-icon" viewBox="0 0 32 32" width="32" height="32" fill="currentColor" aria-hidden="true">
      <path d="M16 2C8.28 2 2 8.28 2 16c0 2.58.7 5.01 1.92 7.11L2 30l7.15-1.87A13.93 13.93 0 0 0 16 30c7.72 0 14-6.28 14-14S23.72 2 16 2zm0 25.64c-2.3 0-4.45-.63-6.3-1.72l-.45-.27-4.24 1.11 1.13-4.13-.3-.48A11.64 11.64 0 0 1 4.36 16c0-6.42 5.22-11.64 11.64-11.64s11.64 5.22 11.64 11.64c0 6.42-5.22 11.64-11.64 11.64zm6.39-8.73c-.35-.18-2.07-1.02-2.39-1.14-.32-.12-.56-.18-.8.18-.23.35-.91 1.14-1.11 1.38-.2.23-.41.26-.76.09-.35-.18-1.48-.55-2.82-1.74-1.04-.93-1.74-2.08-1.94-2.43-.2-.35-.02-.54.15-.71.16-.16.35-.41.53-.61.18-.2.23-.35.35-.59.12-.23.06-.44-.03-.61-.09-.18-.8-1.93-1.1-2.65-.29-.69-.59-.6-.8-.61-.21-.01-.45-.01-.69-.01-.24 0-.63.09-.96.44-.33.35-1.26 1.23-1.26 3 0 1.77 1.29 3.48 1.47 3.72.18.23 2.54 3.88 6.15 5.44.86.37 1.53.59 2.05.76.86.27 1.64.23 2.26.14.69-.1 2.07-.85 2.36-1.66.29-.82.29-1.52.2-1.66-.08-.14-.32-.23-.67-.4z"/>
    </svg>
    <span class="gv-whatsapp-tooltip">{tooltip}</span>
  </a>
</aside>

<script>
  function initWhatsAppWidget() {
    const waLink = document.getElementById('gv-whatsapp-link') as HTMLAnchorElement | null;
    if (!waLink) return;

    // Detect if current page is a product detail page or has a specific product title
    const isProductPage = window.location.pathname.includes('/products/');
    const titleEl = document.querySelector('h1');
    if (isProductPage && titleEl) {
      const productName = titleEl.textContent?.trim() || '';
      if (productName) {
        const pageUrl = window.location.href;
        const msg = `Hi GINKVORA Team, I am inquiring about: ${productName} (${pageUrl})`;
        waLink.href = `https://wa.me/8613201818603?text=${encodeURIComponent(msg)}`;
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhatsAppWidget);
  } else {
    initWhatsAppWidget();
  }
  document.addEventListener('astro:page-load', initWhatsAppWidget);
</script>

<style>
  /* ==============================================================================
     FLOATING WHATSAPP SUPPORT WIDGET
     Aligned along the same vertical right-hand axis without overlapping:
     - Chatwoot live chat bubble: bottom 20px (height ~60px)
     - WhatsApp widget: bottom 5.75rem / 92px (height 56px)
     - BackToTop button: bottom 9.75rem / 156px (height 44px)
     ============================================================================== */
  .gv-whatsapp-widget {
    position: fixed;
    bottom: 5.75rem; /* 92px from bottom, directly above Chatwoot */
    right: 1.375rem; /* 22px from right, centers perfectly with Chatwoot */
    z-index: 990;
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  .gv-whatsapp-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #ffffff !important;
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4), 0 2px 8px rgba(0, 0, 0, 0.35);
    text-decoration: none !important;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }

  .gv-whatsapp-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.55), 0 4px 12px rgba(0, 0, 0, 0.4);
    color: #ffffff !important;
  }

  .gv-whatsapp-btn:active {
    transform: scale(0.96);
  }

  .gv-whatsapp-btn:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 3px;
  }

  .gv-whatsapp-icon {
    width: 32px;
    height: 32px;
    fill: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
  }

  .gv-whatsapp-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    padding: 7px 14px;
    background: #11161d;
    color: #f1f5f9;
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-body, system-ui, sans-serif);
    letter-spacing: 0.01em;
    white-space: nowrap;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 991;
  }

  .gv-whatsapp-tooltip::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent transparent #11161d;
  }

  .gv-whatsapp-btn:hover .gv-whatsapp-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Responsive Adjustments for Mobile */
  @media (max-width: 640px) {
    .gv-whatsapp-widget {
      bottom: 5.125rem; /* 82px */
      right: 1.1875rem; /* 19px */
    }

    .gv-whatsapp-btn {
      width: 48px;
      height: 48px;
    }

    .gv-whatsapp-icon {
      width: 27px;
      height: 27px;
    }

    .gv-whatsapp-tooltip {
      display: none; /* Hide tooltip on touch screens */
    }
  }

  /* RTL Support for Arabic */
  :global(html[lang="ar"]) .gv-whatsapp-tooltip {
    right: auto;
    left: calc(100% + 12px);
    transform: translateY(-50%) translateX(-6px);
  }

  :global(html[lang="ar"]) .gv-whatsapp-tooltip::after {
    left: auto;
    right: 100%;
    border-color: transparent #11161d transparent transparent;
  }

  :global(html[lang="ar"]) .gv-whatsapp-btn:hover .gv-whatsapp-tooltip {
    transform: translateY(-50%) translateX(0);
  }
</style>
