---
// src/components/PortableText.astro — Simple Portable Text and Markdown renderer
import { marked } from 'marked';
import { urlFor, optimizeRichTextHtml } from '../lib/sanity';

interface Props {
  value: any;
}

const { value } = Astro.props;

let htmlContent = '';

// Normalize text: replace escaped double backslash \\n with actual \n
const normalizeText = (text: string): string => {
  if (!text) return '';
  return text.replace(/\\n/g, '\n');
};

if (typeof value === 'string') {
  htmlContent = await marked.parse(normalizeText(value));
  // SEO: page template already provides H1 — downgrade any H1 in markdown body to H2
  htmlContent = htmlContent.replace(/<h1\b/gi, '<h2').replace(/<\/h1>/gi, '</h2>');
} else if (Array.isArray(value)) {
  const parsedBlocks = await Promise.all(
    value.map(async (block) => {
      if (!block) return '';
      
      if (block._type === 'block') {
        let text = block.children?.map((c: any) => c.text).join('') || '';
        text = normalizeText(text);

        // Check if block has native list properties
        const isNativeList = !!block.listItem;

        // If the text contains block-level markdown markers
        const hasBlockMarkdown = text.includes('\n') || text.trim().startsWith('- ') || text.trim().startsWith('* ') || text.trim().startsWith('1. ');

        if (hasBlockMarkdown && !isNativeList) {
          // Parse the whole block as full markdown (includes lists, paragraphs, etc.)
          return await marked.parse(text);
        }

        // Otherwise parse inline markdown rules (bold, italic, links, etc.)
        const inlineHtml = await marked.parseInline(text);

        if (block.style === 'h1') return `<h2>${inlineHtml}</h2>`;
        if (block.style === 'h2') return `<h2>${inlineHtml}</h2>`;
        if (block.style === 'h3') return `<h3>${inlineHtml}</h3>`;
        if (block.style === 'h4') return `<h4>${inlineHtml}</h4>`;
        if (block.style === 'blockquote') return `<blockquote>${inlineHtml}</blockquote>`;
        if (block.listItem === 'bullet') return `<li>${inlineHtml}</li>`;
        if (block.listItem === 'number') return `<li>${inlineHtml}</li>`;

        return `<p>${inlineHtml}</p>`;
      }

      if (block._type === 'image' && (block.asset || block.url)) {
        const alt = String(block.alt || '').replace(/"/g, '&quot;');
        const imgSrc = urlFor(block).width(800).format('webp').url();
        return `<p><img src="${imgSrc}" alt="${alt}" /></p>`;
      }
      
      return '';
    })
  );

  htmlContent = parsedBlocks.join('');
  
  // Wrap contiguous <li> tags in <ul> or <ol>
  htmlContent = htmlContent.replace(/(<li>.*?<\/li>)+/g, (match) => `<ul>${match}</ul>`);
} else if (value) {
  htmlContent = `<p>${JSON.stringify(value)}</p>`;
}

htmlContent = optimizeRichTextHtml(htmlContent);
---

<div class="portable-text" set:html={htmlContent} />

<style>
  .portable-text {
    line-height: 1.8;
  }
  .portable-text :global(p) {
    margin-bottom: 1.25rem;
  }
  .portable-text :global(img) {
    display: block;
    margin: 2rem auto;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md, 8px);
  }
  .portable-text :global(h2) {
    font-size: 1.75rem;
    color: var(--color-primary-light);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .portable-text :global(h3) {
    font-size: 1.5rem;
    color: var(--color-primary-light);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .portable-text :global(ul), .portable-text :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .portable-text :global(li) {
    margin-bottom: 0.5rem;
    list-style: inherit;
  }
  .portable-text :global(strong) {
    color: var(--color-primary-light);
    font-weight: 600;
  }
  .portable-text :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin-inline: 0;
    margin-bottom: 1.25rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  /* ── Responsive Tables ── */
  .portable-text :global(.table-container) {
    width: 100%;
    overflow-x: auto;
    margin-block: 2rem;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border);
    background: rgba(22, 24, 26, 0.4);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--color-surface-2) transparent;
  }

  /* Thin scrollbar for table container */
  .portable-text :global(.table-container::-webkit-scrollbar) {
    height: 6px;
  }
  .portable-text :global(.table-container::-webkit-scrollbar-track) {
    background: transparent;
  }
  .portable-text :global(.table-container::-webkit-scrollbar-thumb) {
    background: var(--color-surface-2);
    border-radius: 3px;
  }
  .portable-text :global(.table-container::-webkit-scrollbar-thumb:hover) {
    background: var(--color-primary-dark);
  }

  .portable-text :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    text-align: left;
  }

  .portable-text :global(th) {
    background: rgba(212, 166, 84, 0.06);
    color: var(--color-primary-light);
    font-weight: 600;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(212, 166, 84, 0.25);
    white-space: nowrap;
  }

  .portable-text :global(td) {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .portable-text :global(tr:last-child td) {
    border-bottom: none;
  }

  .portable-text :global(tr:nth-child(even) td) {
    background: rgba(255, 255, 255, 0.01);
  }

  .portable-text :global(tr:hover td) {
    background: rgba(212, 166, 84, 0.02);
  }
</style>
