---
// BaseLayout.astro — Master layout with SEO, i18n, and performance optimizations
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { stripLangPrefix, getDir } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const fbAppId = import.meta.env.PUBLIC_FB_APP_ID as string | undefined;

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  type?: 'website' | 'article' | 'product';
  canonicalUrl?: string;
  noindex?: boolean;
  structuredData?: object;
  preloadHeroImage?: boolean;
}

const {
  title,
  description = 'GINKVORA supplies high-purity botanical and bioactive ingredients for cosmetic, nutraceutical and health-product development.',
  keywords = 'bioactive ingredient supplier, botanical ingredients, peptides, polynucleotides, PQQ supplier, NMN bulk, EGCG extract, Glabridin, Luteolin, Flavone, nutraceutical ingredients, cosmetic actives, B2B bioactive ingredients',
  image,
  lang = 'en',
  dir,
  type = 'website',
  canonicalUrl,
  noindex = false,
  structuredData,
  preloadHeroImage = false,
} = Astro.props;

const resolvedDir = dir || getDir(lang as Lang);

const siteUrl = 'https://ginkvora.com';
// Normalize a CMS-provided brand suffix before applying the site-wide suffix.
// This avoids both duplicate branding and inconsistent "Ginkvora" casing.
const brandSuffixPattern = /\s*\|\s*ginkvora\s*$/i;
const fullTitle = brandSuffixPattern.test(title)
  ? title.replace(brandSuffixPattern, ' | GINKVORA')
  : /\bGINKVORA\b/i.test(title)
    ? title
    : `${title} | GINKVORA`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const basePath = stripLangPrefix(Astro.url.pathname);

// Auto-detect tracking/search parameters and force noindex only for tracking/search query strings
const rawSearch = Astro.url.search ? Astro.url.search.trim() : '';
const isTrackingOrSearch = Boolean(
  rawSearch && (
    rawSearch.includes('utm_') ||
    rawSearch.includes('gclid=') ||
    rawSearch.includes('fbclid=') ||
    rawSearch.includes('ref=') ||
    rawSearch.includes('search=')
  )
);
const shouldNoindex = noindex || isTrackingOrSearch;

const cookieCopyByLocale = {
  en: {
    message: 'We use cookies to improve your browsing experience, analyze site traffic, and deliver technical support. By clicking "Accept All", you agree to our use of cookies.',
    privacyHref: '/privacy', privacyLabel: 'Privacy Policy', essential: 'Essential only', accept: 'Accept All',
    manage: 'Manage preferences', analytics: 'Analytics cookies', analyticsHelp: 'Help us understand how the site is used.', save: 'Save preferences',
  },
  es: {
    message: 'Usamos cookies para mejorar tu experiencia de navegación, analizar el tráfico del sitio y ofrecer soporte técnico. Al hacer clic en «Aceptar todo», aceptas nuestro uso de cookies.',
    privacyHref: '/es/privacy', privacyLabel: 'Política de privacidad', essential: 'Solo esenciales', accept: 'Aceptar todo',
    manage: 'Gestionar preferencias', analytics: 'Cookies analíticas', analyticsHelp: 'Nos ayudan a comprender cómo se utiliza el sitio.', save: 'Guardar preferencias',
  },
  ru: {
    message: 'Мы используем файлы cookie для улучшения работы сайта, анализа трафика и предоставления поддержки. Нажимая «Принять все», вы соглашаетесь с использованием файлов cookie.',
    privacyHref: '/ru/privacy', privacyLabel: 'Подробнее', essential: 'Только необходимые', accept: 'Принять все',
    manage: 'Настроить предпочтения', analytics: 'Аналитические cookie', analyticsHelp: 'Помогают нам понимать, как используется сайт.', save: 'Сохранить выбор',
  },
  ar: {
    message: 'نستخدم ملفات تعريف الارتباط لتحسين تجربة التصفح وتحليل حركة الزيارات وتقديم الدعم الفني. بالنقر على «قبول الكل»، فإنك توافق على استخدامنا لملفات تعريف الارتباط.',
    privacyHref: '/ar/privacy', privacyLabel: 'سياسة الخصوصية', essential: 'الضرورية فقط', accept: 'قبول الكل',
    manage: 'إدارة التفضيلات', analytics: 'ملفات تعريف الارتباط للتحليلات', analyticsHelp: 'تساعدنا على فهم كيفية استخدام الموقع.', save: 'حفظ التفضيلات',
  },
} as const;
const cookieCopy = cookieCopyByLocale[lang as keyof typeof cookieCopyByLocale] ?? cookieCopyByLocale.en;


// Use dynamic OG image generator if no explicit image is provided
const ogImageParams = new URLSearchParams({
  title: fullTitle,
  subtitle: description.slice(0, 80),
});
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og-image.png?${ogImageParams.toString()}`;

// Organization structured data (always present)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GINKVORA',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.svg`,
  description: 'GINKVORA supplies botanical extracts, peptides, polynucleotides and functional actives for cosmetic, nutraceutical and health-product development — supported by clear specifications, documentation and dependable B2B supply.',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'inquiry@ginkvora.com',
    availableLanguage: ['English', 'Russian'],
  },
  sameAs: [
    'https://www.facebook.com/ginkvora',
    'https://www.youtube.com/@Ginkvora',
  ],
};


---

<!doctype html>
<html lang={lang} dir={resolvedDir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Performance: Critical Font & Hero Preloads (Placed at top of head for zero LCP delay) -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-normal-700.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-normal-400.woff2" crossorigin />
    {preloadHeroImage && (
      <>
        <link rel="preload" as="image" href="/images/hero-bg-mobile.webp" media="(max-width: 768px)" type="image/webp" fetchpriority="high" />
        <link rel="preload" as="image" href="/images/hero-bg.webp" media="(min-width: 769px)" type="image/webp" fetchpriority="high" />
      </>
    )}

    <!-- Google Consent Mode v2 Default Settings -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      
      // Load stored consent or default to denied for EU/Global compliance
      const storedConsent = localStorage.getItem('cookie-consent');
      const analyticsConsentGranted = storedConsent === 'accepted';
      if (analyticsConsentGranted) {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'granted'
        });
      } else {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied'
        });
      }

      // Clarity is loaded only after analytics consent. Queue the consent
      // decision before its script is requested so it can never set cookies
      // while the visitor is undecided or has declined.
      window.clarity = window.clarity || function () {
        (window.clarity.q = window.clarity.q || []).push(arguments);
      };
      window.gkvAnalyticsConsentGranted = analyticsConsentGranted;
      window.clarity('consentv2', {
        ad_Storage: 'denied',
        analytics_Storage: analyticsConsentGranted ? 'granted' : 'denied'
      });
    </script>

    <!-- Google Tag Manager (Async non-blocking container loader for GA4 & Clarity) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){
          w[l]=w[l]||[];
          w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
          var f=d.getElementsByTagName(s)[0],
              j=d.createElement(s),
              dl=l!='dataLayer'?'&l='+l:'';
          j.async=true;
          j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
          f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}

    <script is:inline>
      // The GTM Clarity tag listens for this event instead of firing on page
      // initialization. Existing consent is replayed on every full page load.
      if (window.gkvAnalyticsConsentGranted && !window.gkvClarityLoadRequested) {
        window.gkvClarityLoadRequested = true;
        window.dataLayer.push({ event: 'gkv_analytics_consent_granted' });
      }
    </script>

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, follow" />}
    {!shouldNoindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonical} />

    <!--
      ╔══════════════════════════════════════════════════════════╗
      ║  CRITICAL CSS — Inlined to eliminate render-blocking    ║
      ║  delay for above-the-fold H1 text and body background.  ║
      ║  Allows the browser to paint the hero text immediately  ║
      ║  before external CSS sheets finish downloading.          ║
      ╚══════════════════════════════════════════════════════════╝
    -->
    <style is:inline>
      /* Critical: Fallback Font Metrics */
      @font-face {
        font-family: 'Cormorant Fallback';
        src: local('Georgia'), local('Times New Roman'), local('serif');
      }
      @font-face {
        font-family: 'DM Sans Fallback';
        src: local('Helvetica Neue'), local('Arial'), local('sans-serif');
      }
      /* Critical: body background + text color (prevents white flash) */
      body{margin:0;background-color:#0b0c0d;color:#ffffff;font-family:'DM Sans','DM Sans Fallback','Helvetica Neue',sans-serif;-webkit-font-smoothing:antialiased}
      /* Critical: Base typography */
      h1,h2,h3{font-family:'Cormorant Garamond','Cormorant Fallback','Georgia',serif;font-weight:700;line-height:1.2;color:#ffffff}
      /* Critical: container + layout */
      .container{width:100%;max-width:1440px;margin-inline:auto;padding-inline:clamp(1rem,4vw,3rem)}
      /* Critical: gradient text for hero title gold highlight */
      .gradient-text--gold{background:linear-gradient(135deg,#f0c878 0%,#d4a654 60%,#a07830 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
      /* Critical: section-label badge rendering */
      .section-label{font-size:0.8125rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#e07830}
      .badge{display:inline-flex;align-items:center;gap:0.375rem;padding:0.3rem 0.875rem;border-radius:9999px;font-size:0.8125rem;font-weight:500}
      .badge--gold{background:rgba(212,166,84,0.15);color:#f0c878;border:1px solid rgba(212,166,84,0.3)}
      /* Critical: skip-link accessibility hiding to prevent FOUC */
      .skip-link{position:absolute;top:-100px;left:1rem;z-index:9999}
      .skip-link:focus{top:0}
    </style>

    <!-- Open Graph -->
    {fbAppId && <meta property="fb:app_id" content={fbAppId} />}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {ogImage.startsWith('https://') && <meta property="og:image:secure_url" content={ogImage} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GINKVORA" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : lang === 'ru' ? 'ru_RU' : lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#080d08" />
    <meta name="msapplication-TileColor" content="#080d08" />

    <!-- hreflang for i18n -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${basePath === '/' ? '' : basePath}`} />
    <link rel="alternate" hreflang="ru" href={`${siteUrl}/ru${basePath === '/' ? '' : basePath}`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/es${basePath === '/' ? '' : basePath}`} />
    <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar${basePath === '/' ? '' : basePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${basePath === '/' ? '' : basePath}`} />

    {lang === 'ar' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" />
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
        </noscript>
      </>
    )}

    <!-- Keywords (B2B SEO) -->
    <meta name="keywords" content={keywords} />

    <!-- Business meta -->
    <meta name="author" content="GINKVORA" />
    <meta name="copyright" content="GINKVORA" />



    <!-- Performance: Third-party DNS Prefetch & Preconnect -->
    <link rel="preconnect" href="https://chat.ginkvora.com" crossorigin />
    <link rel="dns-prefetch" href="https://chat.ginkvora.com" />
    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />



    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <slot name="head" />
  </head>

  <body class="bg-noise">
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->

    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Navbar lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <!--
      Footer uses content-visibility: auto to skip layout/paint
      computation until the user scrolls near it. This eliminates
      ~100ms of layout work from the initial critical rendering path.
    -->
    <div class="cv-deferred-footer">
      <Footer lang={lang} />
    </div>

    <!-- Back to Top Button -->
    <BackToTop lang={lang} />

    <!-- Reveal animation script -->
    <script is:inline>
      function initScrollReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
      document.addEventListener('astro:page-load', initScrollReveal);
      document.addEventListener('astro:after-swap', initScrollReveal);
    </script>

    <!--
      GTM Virtual Pageview — Astro ClientRouter (SPA) support.
      On every client-side navigation (astro:after-swap), the new page's
      pathname and title are already updated in the DOM, so we push a
      virtualPageview event to the dataLayer for GTM to pick up.
      This is a no-op if GTM is not loaded (dataLayer falls back to an
      empty array, which is safe).
    -->
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'virtualPageview',
          pagePath: window.location.pathname,
          pageTitle: document.title,
        });
      });
    </script>

    <!-- Lead tracking: emitted only after a form API request succeeds, never on a thank-you page view. -->
    <script is:inline>
      (function () {
        window.gkvTrackLeadAndRedirect = function (redirectUrl, formType) {
          var leadId = (window.crypto && window.crypto.randomUUID) ? window.crypto.randomUUID() : ('gkv_' + Date.now() + '_' + Math.random().toString(36).slice(2));
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'gkv_generate_lead',
            lead_id: leadId,
            form_type: formType,
            page_location: window.location.href,
            page_path: window.location.pathname,
          });

          // Give GTM a short interval to dispatch its beacon before navigation.
          window.setTimeout(function () {
            window.location.assign(redirectUrl);
          }, 300);
        };
      })();
    </script>

    <!-- High-value funnel tracking: CTA intent, COA downloads, and catalog searches. -->
    <script is:inline>
      (function () {
        function sendEvent(name, parameters) {
          if (typeof gtag !== 'function') return;
          gtag('event', name, Object.assign({
            page_language: document.documentElement.lang || 'en',
            page_path: window.location.pathname,
          }, parameters || {}));
        }

        function productSlug() {
          var match = window.location.pathname.match(/\/products\/([^/?#]+)/);
          return match ? decodeURIComponent(match[1]) : undefined;
        }

        function trackSearch(term, source) {
          var normalized = String(term || '').trim();
          if (!normalized) return;
          var key = normalized.toLowerCase();
          var now = Date.now();
          if (window.gkvLastCatalogSearch && window.gkvLastCatalogSearch.key === key && now - window.gkvLastCatalogSearch.time < 3000) return;
          window.gkvLastCatalogSearch = { key: key, time: now };
          sendEvent('search', {
            search_term: normalized,
            search_context: 'product_catalog',
            search_source: source,
          });
        }

        if (!window.gkvBusinessTrackingBound) {
          window.gkvBusinessTrackingBound = true;
          document.addEventListener('click', function (event) {
            var target = event.target instanceof Element ? event.target : null;
            if (!target) return;

            var tracked = target.closest('[data-gkv-event]');
            if (tracked) {
              var eventName = tracked.getAttribute('data-gkv-event');
              if (eventName) {
                sendEvent(eventName, {
                  cta_location: tracked.getAttribute('data-gkv-location') || undefined,
                  product_slug: productSlug(),
                  link_url: tracked instanceof HTMLAnchorElement ? tracked.href : undefined,
                });
              }
            }

            var searchButton = target.closest('#hero-search-trigger');
            if (searchButton) {
              var input = document.getElementById('hero-product-search');
              trackSearch(input && 'value' in input ? input.value : '', 'button');
            }

            var quickSearch = target.closest('.hero-tag-btn[data-search]');
            if (quickSearch) trackSearch(quickSearch.getAttribute('data-search'), 'quick_tag');
          });
        }

        function bindCatalogSearch() {
          var input = document.getElementById('hero-product-search');
          if (!input || input.dataset.gkvTrackingBound === 'true') return;
          input.dataset.gkvTrackingBound = 'true';
          input.addEventListener('change', function () { trackSearch(input.value, 'input'); });
          input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') trackSearch(input.value, 'input_enter');
          });
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindCatalogSearch);
        else bindCatalogSearch();
        document.addEventListener('astro:page-load', bindCatalogSearch);
      })();
    </script>

    <!-- Cookie Consent Minimized Icon -->
    <button id="cookie-minimized-icon" class="cookie-minimized hidden" aria-label="Cookie Settings">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
        <path d="M8.5 8.5v.01"/>
        <path d="M16 15.5v.01"/>
        <path d="M12 12v.01"/>
        <path d="M11 17v.01"/>
        <path d="M7 14v.01"/>
      </svg>
    </button>

    <!-- Cookie Consent Banner -->
    <div id="cookie-consent-banner" class="cookie-banner hidden" role="dialog" aria-label="Cookie Consent">
      <button id="cookie-close-btn" class="cookie-close" aria-label="Minimize">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="cookie-container">
        <p class="cookie-text">
          {cookieCopy.message} <a href={cookieCopy.privacyHref} class="cookie-link">{cookieCopy.privacyLabel}</a>
        </p>
        <div class="cookie-actions">
          <button id="cookie-decline-btn" class="cookie-btn cookie-btn--text">
            {cookieCopy.essential}
          </button>
          <button id="cookie-accept-btn" class="cookie-btn cookie-btn--gold">
            {cookieCopy.accept}
          </button>
        </div>
        <button id="cookie-preferences-btn" class="cookie-preferences-toggle" type="button" aria-expanded="false" aria-controls="cookie-preferences">
          {cookieCopy.manage}
        </button>
        <div id="cookie-preferences" class="cookie-preferences hidden">
          <label class="cookie-preference-option">
            <input id="cookie-analytics-toggle" type="checkbox" />
            <span>
              <strong>{cookieCopy.analytics}</strong>
              <small>{cookieCopy.analyticsHelp}</small>
            </span>
          </label>
          <button id="cookie-save-preferences-btn" class="cookie-btn cookie-btn--outline" type="button">
            {cookieCopy.save}
          </button>
        </div>
      </div>
    </div>

    <script is:inline>
      function initCookieConsent() {
        const consent = localStorage.getItem('cookie-consent');
        const banner = document.getElementById('cookie-consent-banner');
        const acceptBtn = document.getElementById('cookie-accept-btn');
        const declineBtn = document.getElementById('cookie-decline-btn');
        const icon = document.getElementById('cookie-minimized-icon');
        const closeBtn = document.getElementById('cookie-close-btn');
        const preferencesBtn = document.getElementById('cookie-preferences-btn');
        const preferences = document.getElementById('cookie-preferences');
        const analyticsToggle = document.getElementById('cookie-analytics-toggle');
        const savePreferencesBtn = document.getElementById('cookie-save-preferences-btn');

        if (!banner || !acceptBtn || !declineBtn || !icon || !closeBtn || !preferencesBtn || !preferences || !analyticsToggle || !savePreferencesBtn) return;

        // Clone to clean up potential duplicate event listeners on page re-loads
        const newAcceptBtn = acceptBtn.cloneNode(true);
        const newDeclineBtn = declineBtn.cloneNode(true);
        const newIcon = icon.cloneNode(true);
        const newCloseBtn = closeBtn.cloneNode(true);
        const newPreferencesBtn = preferencesBtn.cloneNode(true);
        const newAnalyticsToggle = analyticsToggle.cloneNode(true);
        const newSavePreferencesBtn = savePreferencesBtn.cloneNode(true);
        
        acceptBtn.parentNode.replaceChild(newAcceptBtn, acceptBtn);
        declineBtn.parentNode.replaceChild(newDeclineBtn, declineBtn);
        icon.parentNode.replaceChild(newIcon, icon);
        closeBtn.parentNode.replaceChild(newCloseBtn, closeBtn);
        preferencesBtn.parentNode.replaceChild(newPreferencesBtn, preferencesBtn);
        analyticsToggle.parentNode.replaceChild(newAnalyticsToggle, analyticsToggle);
        savePreferencesBtn.parentNode.replaceChild(newSavePreferencesBtn, savePreferencesBtn);

        const showBanner = () => {
          newIcon.classList.remove('visible');
          setTimeout(() => {
            newIcon.classList.add('hidden');
            banner.classList.remove('hidden');
            // Slight delay to allow CSS transitions to trigger
            setTimeout(() => {
              banner.classList.add('visible');
              newPreferencesBtn.setAttribute('aria-expanded', 'false');
              preferences.classList.add('hidden');
            }, 50);
          }, 300);
        };

        const showIcon = () => {
          banner.classList.remove('visible');
          setTimeout(() => {
            banner.classList.add('hidden');
            newIcon.classList.remove('hidden');
            setTimeout(() => {
              newIcon.classList.add('visible');
            }, 50);
          }, 400);
        };

        const setConsent = (analyticsEnabled) => {
          localStorage.setItem('cookie-consent', analyticsEnabled ? 'accepted' : 'declined');
          showIcon();
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              'ad_storage': 'denied',
              'ad_user_data': 'denied',
              'ad_personalization': 'denied',
              'analytics_storage': analyticsEnabled ? 'granted' : 'denied'
            });
          }
          window.gkvAnalyticsConsentGranted = analyticsEnabled;
          if (typeof window.clarity === 'function') {
            window.clarity('consentv2', {
              ad_Storage: 'denied',
              analytics_Storage: analyticsEnabled ? 'granted' : 'denied'
            });
          }
          if (analyticsEnabled && !window.gkvClarityLoadRequested) {
            window.gkvClarityLoadRequested = true;
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'gkv_analytics_consent_granted' });
          }
        };

        if (!consent) {
          // First visit needs an explicit, easy-to-find choice.
          setTimeout(() => {
            showBanner();
          }, 350);
        } else {
          newIcon.classList.remove('hidden');
          setTimeout(() => newIcon.classList.add('visible'), 350);
        }

        newIcon.addEventListener('click', showBanner);
        newCloseBtn.addEventListener('click', showIcon);

        newAcceptBtn.addEventListener('click', () => {
          setConsent(true);
        });

        newDeclineBtn.addEventListener('click', () => {
          setConsent(false);
        });

        newPreferencesBtn.addEventListener('click', () => {
          const isOpen = !preferences.classList.contains('hidden');
          preferences.classList.toggle('hidden', isOpen);
          newPreferencesBtn.setAttribute('aria-expanded', String(!isOpen));
          newAnalyticsToggle.checked = localStorage.getItem('cookie-consent') === 'accepted';
        });

        newSavePreferencesBtn.addEventListener('click', () => setConsent(newAnalyticsToggle.checked));
      }

      // Initial load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCookieConsent);
      } else {
        initCookieConsent();
      }

      // Astro Page load support
      document.addEventListener('astro:page-load', initCookieConsent);
    </script>

    <!-- Chatwoot Live Chat Widget (Ginkvora Custom — Deferred Loading) -->
    <script is:inline>
      window.chatwootSettings = { position: "right", type: "standard" };
      (function () {
        let loaded = false;
        function loadChatwoot() {
          if (loaded) return;
          loaded = true;
          var BASE_URL = "https://chat.ginkvora.com";
          var g = document.createElement("script");
          var s = document.getElementsByTagName("script")[0];
          g.src = BASE_URL + "/packs/js/sdk.js";
          g.defer = true;
          g.async = true;
          s.parentNode.insertBefore(g, s);
          g.onload = function () {
            if (window.chatwootSDK) {
              window.chatwootSDK.run({
                websiteToken: 'bTcHGarMBnzRt4D4roByeZoF',
                baseUrl: BASE_URL,
                locale: 'en'
              });
            }
          };
        }

        function scheduleChatwoot() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(function() {
              setTimeout(loadChatwoot, 3500);
            });
          } else {
            setTimeout(loadChatwoot, 4000);
          }

          const triggerEvents = ['click', 'mousedown', 'mousemove', 'touchstart', 'scroll', 'keydown'];
          function triggerLoad() {
            loadChatwoot();
            triggerEvents.forEach(function(event) {
              window.removeEventListener(event, triggerLoad);
            });
          }
          triggerEvents.forEach(function(event) {
            window.addEventListener(event, triggerLoad, { passive: true });
          });
        }

        if (document.readyState === 'complete') {
          scheduleChatwoot();
        } else {
          window.addEventListener('load', scheduleChatwoot, { passive: true });
        }
      })();
    </script>

