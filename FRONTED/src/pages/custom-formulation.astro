---
// src/pages/custom-formulation.astro — Premium B2B Custom Formulation & OEM Page
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ginkvora.com' },
    { '@type': 'ListItem', position: 2, name: 'Custom Formulation', item: 'https://ginkvora.com/custom-formulation' },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Custom Formulation & Contract Manufacturing Services | GINKVORA',
  'description': 'Contract manufacturing and custom formulation services for Oral Thin Films (OTF) and advanced liposomal encapsulation. Tailored B2B OEM/ODM solutions.',
  'url': 'https://ginkvora.com/custom-formulation',
};
---

<BaseLayout
  title="Custom Formulation & Contract Manufacturing | GINKVORA"
  description="Custom B2B formulation services by GINKVORA: liposomal encapsulation, oral disintegrating films (OTF), microencapsulation & OEM/ODM bioactive ingredients."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <main class="formulation-page bg-noise">
    <!-- Hero Section -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <div class="hero-columns">
          <div class="hero-text-col reveal">
            <span class="section-label">Tailored B2B OEM/ODM</span>
            <h1 class="banner-title">Custom Formulation Solutions: <span class="gradient-text--gold">From Innovation to Market-Ready Products</span></h1>
            <p class="banner-desc">
              Empowering your brand with advanced Oral Thin Film (OTF) and encapsulation technologies. Tailored to your specific active ingredient requirements and optimized for maximum efficacy.
            </p>
            <div class="hero-actions">
              <a href="#inquiry-form-section" class="btn btn--gold">Request a Formulation Quote</a>
            </div>
          </div>
          <div class="hero-visual-col reveal reveal-delay-2">
            <div class="image-showcase glass hero-carousel">
              <div class="carousel-slides">
                <div class="carousel-slide active">
                  <img
                    src="/images/ginkvora-cleanroom-manufacturing-machinery.webp"
                    alt="GINKVORA Class 100,000 cleanroom manufacturing machinery"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Class 100,000 Cleanroom Manufacturing</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-gmp-capsule-bottle-filling-line.webp"
                    alt="GINKVORA automated GMP capsule bottle filling line"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Automated GMP Capsule Filling Line</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-otf-strip-packaging-cleanroom-line.webp"
                    alt="GINKVORA precision OTF strip packaging cleanroom line"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Precision OTF Strip Packaging Line</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora%20QC%20Laboratory.webp"
                    alt="GINKVORA state-of-the-art QC laboratory"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">State-of-the-Art Quality Control Laboratory</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-rd-analytical-laboratory.webp"
                    alt="GINKVORA R&D formulation and analytical laboratory"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">R&D Formulation & Analytical Center</div>
                </div>
              </div>
              
              <!-- Carousel Indicators -->
              <div class="carousel-indicators">
                <span class="indicator active" data-index="0"></span>
                <span class="indicator" data-index="1"></span>
                <span class="indicator" data-index="2"></span>
                <span class="indicator" data-index="3"></span>
                <span class="indicator" data-index="4"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- The Core Focus: OTF -->
    <section class="section otf-section bg-deep" id="otf-focus" aria-label="Oral Thin Film Technology">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Core Specialization</span>
          <h2 class="section-title">Precision-Engineered Oral Thin Films (OTF)</h2>
          <p class="section-desc">
            Leverage our class-leading thin film delivery technology to differentiate your brand from standard capsules and tablets.
          </p>
        </div>

        <div class="grid-2-columns">
          <div class="visual-panel reveal">
            <div class="image-showcase glass">
              <img
                src="/images/oral-dissolving-film-benefits.webp"
                alt="GINKVORA Oral Thin Film (OTF) benefits, including rapid absorption, customizable matrix, and high active ingredient loading capacity"
                class="showcase-img"
                width="600"
                height="400"
              />
            </div>
          </div>

          <div class="content-panel">
            <div class="feature-card glass reveal reveal-delay-1">
              <div class="feature-icon">⚡</div>
              <div class="feature-body">
                <h3>Rapid Absorption & Bioavailability</h3>
                <p>
                  Bypasses first-pass hepatic metabolism. Solubilizes instantly in the oral cavity for rapid mucosal absorption and direct systemic delivery.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-2">
              <div class="feature-icon">🧪</div>
              <div class="feature-body">
                <h3>Customized Polymer Matrix</h3>
                <p>
                  Engineered taste-masking, customized dissolution profiles (from instant to controlled), and tailored active ingredient loading capacities up to 150mg per film.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-3">
              <div class="feature-icon">💧</div>
              <div class="feature-body">
                <h3>No Water Required & Portable</h3>
                <p>
                  Zero water consumption needed. Provides ultimate on-the-go convenience for active lifestyle products, increasing consumer compliance and brand loyalty.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-4">
              <div class="feature-icon">🌿</div>
              <div class="feature-body">
                <h3>Application Focus: Anti-Aging, Nootropics & Inner Beauty</h3>
                <p>
                  Perfect for NAD+ precursors (NMN), PQQ, Glutathione, and bioactive ingredients. Our OTF technology ensures the optimal delivery of bioactive anti-aging ingredients, supporting cellular health from within (ECM).
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diversified Solutions: Encapsulation -->
    <section class="container section encapsulation-section" aria-label="Encapsulation Services">
      <div class="section-header reveal">
        <span class="section-label">Diversified Delivery Systems</span>
        <h2 class="section-title">Advanced Encapsulation Services</h2>
        <p class="section-desc">
          Beyond thin films, GINKVORA offers multiple advanced encapsulation formats to stabilize sensitive materials and control release kinetics.
        </p>
      </div>

      <div class="grid-3">
        <div class="cap-card glass reveal">
          <div class="cap-icon">🧬</div>
          <h3>Liposomal Formulation</h3>
          <p>
            Lipid bilayer micro-spheres shield fragile molecules (like Vitamin C or Glabridin) from gastric acids, maximizing intestinal absorption.
          </p>
          <div class="cap-tag">Stability & Bioavailability</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-1">
          <div class="cap-icon">⚪</div>
          <h3>Custom Tablet Manufacturing</h3>
          <p>
            High-speed rotary tablet compression supporting film-coated, chewable, sublingual, and effervescent formats. Custom shapes, logo debossing, and tailored dissolution.
          </p>
          <div class="cap-tag">Precision Compression</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-2">
          <div class="cap-icon">💊</div>
          <h3>Custom Hard-Shell Capsules</h3>
          <p>
            Vegetarian HPMC and pullulan capsule filling with micro-dosing precision. Capable of blending complex dry extract powders with minimal excipient use.
          </p>
          <div class="cap-tag">Scalable Production</div>
        </div>
      </div>

      <div class="encap-footer-visual reveal mt-6">
        <div class="image-showcase glass">
          <img
            src="/images/ginkvora-advanced-delivery-systems-microencapsulation.webp"
            alt="Advanced formulation technologies showing microencapsulation, liposomal delivery systems, and precision solid dosage forms for enhanced bioavailability"
            class="showcase-img"
            width="1632"
            height="656"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Technical Capabilities -->
    <section class="section capabilities-section bg-deep" aria-label="Technical Capabilities">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Why Choose GINKVORA</span>
          <h2 class="section-title">Technical Capabilities & R&D Excellence</h2>
          <p class="section-desc">
            We bridge the gap between laboratory-level innovations and high-volume commercial contract manufacturing.
          </p>
        </div>

        <div class="grid-3">
          <div class="capability-item reveal">
            <div class="cap-num">01</div>
            <h3>R&D Excellence</h3>
            <p>
              Our scientists customize film elasticity, thickness, taste-masking profiles, and active loading parameters to match your custom formula requirements.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-1">
            <div class="cap-num">02</div>
            <h3>GMP Quality Standards</h3>
            <p>
              Strict temperature and humidity controlled cleanrooms comply with GMP standards. All trial runs and commercial batches undergo rigorous HPLC/ICP-MS validation.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-2">
            <div class="cap-num">03</div>
            <h3>End-to-End Support</h3>
            <p>
              From raw material procurement and active ingredient testing to formulation design, scale-up pilot batches, and final blister retail packaging.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We Work -->
    <section class="container section timeline-section" aria-label="Process Flow">
      <div class="section-header reveal">
        <span class="section-label">Step-by-Step Integration</span>
        <h2 class="section-title">Our Cooperation Process</h2>
        <p class="section-desc">
          How we take your product concept from early R&D discussion to shipping ready-to-sell batches.
        </p>
      </div>

      <div class="process-timeline" role="list">
        <!-- Step 1 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">01</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal">
            <div class="step-icon-emoji">💬</div>
            <div class="step-body">
              <h3>Consultation & Concept Phase</h3>
              <p>Discuss your target active ingredients (e.g. NMN, PQQ), dosage form goals, release specifications, and target regional regulations.</p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">02</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-1">
            <div class="step-icon-emoji">🔬</div>
            <div class="step-body">
              <h3>Formulation Development</h3>
              <p>Our lab designs the polymer matrix, masking agent configuration, and prepares physical prototypes for stability, disintegration, and thickness evaluation.</p>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">03</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-2">
            <div class="step-icon-emoji">⚙️</div>
            <div class="step-body">
              <h3>Scale-Up & Pilot Batch</h3>
              <p>We transition the lab formulation onto our pilot production line, testing process parameters, drying kinetics, and loading consistency.</p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="process-step process-step--last" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">04</span></div>
          </div>
          <div class="step-content glass reveal reveal-delay-3">
            <div class="step-icon-emoji">📦</div>
            <div class="step-body">
              <h3>Full-Scale GMP Manufacturing</h3>
              <p>Upon pilot approval, we execute high-volume commercial production under GMP controls, compile complete COA documentation, and pack ready-to-ship drums or blisters.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA & Form Section -->
    <section class="section form-section bg-deep" id="inquiry-form-section" aria-label="Formulation Inquiry Form">
      <div class="container">
        <div class="grid-cta">
          <!-- Left info -->
          <div class="cta-info reveal">
            <span class="section-label">Commercial Sourcing</span>
            <h2>Ready to Bring Your Concept to Life?</h2>
            <p class="cta-desc">
              Connect with our scientific formulation desk. We provide customized contract manufacturing, private label OEM/ODM, and sample trial batches to qualified brand partners.
            </p>

            <div class="contact-list">
              <div class="contact-item">
                <span class="icon">📧</span>
                <div>
                  <strong>Direct Inquiry Email</strong>
                  <a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">📞</span>
                <div>
                  <strong>WhatsApp Commercial Support</strong>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer">+86 13201818603</a>
                </div>
              </div>
            </div>

            <div class="policy-card glass mt-6">
              <h3>Private Label & OEM Guidelines</h3>
              <ul class="policy-list">
                <li><strong>Sample Batches:</strong> Prototype test films are available to qualified cosmetic and supplement brands.</li>
                <li><strong>Document Compliance:</strong> COA, heavy metal testing, and process sheet documentation provided with every formulation quote.</li>
                <li><strong>Custom Ingredients:</strong> We can formulate with customer-supplied raw ingredients or source them via our trusted suppliers.</li>
              </ul>
            </div>
          </div>

          <!-- Right form -->
          <div class="cta-form-wrapper reveal reveal-delay-1">
            <div class="form-card glass">
              <h3>Request a Formulation Quote</h3>
              <p class="form-sub">Fields marked with an asterisk (*) are required.</p>

              <form id="formulation-quote-form" class="custom-form">
                <!-- Honeypot -->
                <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />

                <div class="form-field">
                  <label for="name" class="form-label">Name/Company Name *</label>
                  <input type="text" id="name" name="name" required class="form-input" placeholder="John Doe / BioTech Ltd" />
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="email" class="form-label">Email / Work Email *</label>
                    <input type="email" id="email" name="email" required class="form-input" placeholder="name@company.com" />
                  </div>
                  <div class="form-field">
                    <label for="phone" class="form-label">Phone / WhatsApp *</label>
                    <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+1 (555) 123-4567" />
                  </div>
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="productConcept" class="form-label">Product Concept *</label>
                    <input type="text" id="productConcept" name="productConcept" required class="form-input" placeholder="e.g. Oral Thin Film, Liposomes" />
                  </div>
                  <div class="form-field">
                    <label for="expectedVolume" class="form-label">Expected Volume *</label>
                    <select id="expectedVolume" name="expectedVolume" required class="form-input form-select">
                      <option value="" disabled selected>Select volume range...</option>
                      <option value="under-100k">&lt; 100k pcs</option>
                      <option value="100k-500k">100k - 500k pcs</option>
                      <option value="over-500k">&gt; 500k pcs</option>
                    </select>
                  </div>
                </div>

                <div class="form-field">
                  <label for="message" class="form-label">Detailed Formulation Requirements</label>
                  <textarea id="message" name="message" class="form-input" rows="4" placeholder="Optional. Describe active ingredients, dosage requirements, target dissolution rate, and other preferences..."></textarea>
                </div>

                <button type="submit" class="btn btn--gold btn--lg btn--block" id="submit-btn">
                  Submit Formulation RFQ
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                </button>

                <div id="success-msg" class="success-message" style="display: none;" role="alert">
                  ✓ Quote request sent successfully. Our R&D team will contact you within 12 hours.
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulation-page {
    padding-bottom: 0;
  }

  /* --- Hero Banner --- */
  .page-banner {
    position: relative;
    padding-block: 8rem 5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 45% 60% at 85% 20%, rgba(212, 166, 84, 0.09) 0%, transparent 100%);
  }

  .hero-columns {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .banner-desc {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .image-showcase {
    position: relative;
    width: 100%;
    max-width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.15) !important;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .showcase-img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 3/2;
    transition: transform 0.6s ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.03);
  }

  .showcase-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-primary-light);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* --- Grid layouts --- */
  .grid-2-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    margin-top: 3rem;
  }

  .content-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .grid-cta {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 4rem;
    align-items: start;
  }

  /* --- Feature Cards --- */
  .feature-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.08) !important;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .feature-card:hover {
    border-color: rgba(212, 166, 84, 0.22) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .feature-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .feature-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-light);
    margin-bottom: 0.5rem;
  }

  .feature-body p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* --- Encapsulation Cards --- */
  .cap-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.08) !important;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .cap-card:hover {
    border-color: rgba(212, 166, 84, 0.22) !important;
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow-gold);
  }

  .cap-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .cap-card h3 {
    font-size: 1.375rem;
    color: var(--color-primary-light);
    margin: 0;
  }

  .cap-card p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    flex-grow: 1;
  }

  .cap-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
    margin-top: 0.5rem;
  }

  .encap-footer-visual {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .encap-footer-visual .image-showcase {
    width: 100%;
    max-width: 100%;
  }

  .encap-footer-visual .showcase-img {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1632 / 656;
    object-fit: cover;
  }

  /* --- Capabilities --- */
  .capability-item {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cap-num {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 700;
    color: rgba(212, 166, 84, 0.65);
    line-height: 1;
    border-bottom: 2px solid rgba(212, 166, 84, 0.35);
    padding-bottom: 0.5rem;
    width: fit-content;
  }

  .capability-item h3 {
    font-size: 1.375rem;
    color: var(--color-primary-light);
    margin: 0;
  }

  .capability-item p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* --- Timeline process --- */
  .process-timeline {
    max-width: 800px;
    margin: 3rem auto 0 auto;
    display: flex;
