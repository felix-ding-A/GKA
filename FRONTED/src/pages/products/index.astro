---
// src/pages/products/index.astro — Products listing page with search and category filters
export const prerender = false; // Disable prerendering so SSR handles searchParams (category, mechanism, page)

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductsPaginated, urlFor } from '../../lib/sanity';
import { buildListingCanonical } from '../../lib/seo';

const category = Astro.url.searchParams.get('category');
const mechanism = Astro.url.searchParams.get('mechanism');
const pageParam = Astro.url.searchParams.get('page');

// Pagination config
const PRODUCTS_PER_PAGE = 12;
const requestedPage = Math.max(1, parseInt(pageParam ?? '1') || 1);
const { products, total: totalProducts } = await getProductsPaginated({
  category,
  mechanism,
  page: requestedPage,
  pageSize: PRODUCTS_PER_PAGE,
});
const totalPages = Math.max(1, Math.ceil(totalProducts / PRODUCTS_PER_PAGE));
const currentPage = Math.min(requestedPage, totalPages);
const pageStart = (currentPage - 1) * PRODUCTS_PER_PAGE;

const siteUrl = 'https://ginkvora.com';
const canonicalUrl = buildListingCanonical({
  pathname: '/products', category, mechanism, page: currentPage,
});

const categoriesList = [
  { slug: 'liposomal', name: 'Liposomal', icon: '🧬' },
  { slug: 'pet-longevity', name: 'Pet Longevity', icon: '🐾' },
  { slug: 'superfood', name: 'Superfoods', icon: '🍎' },
  { slug: 'cosmetic-ingredients', name: 'Cosmetic Ingredients', icon: '🌿' }
];

const mechanismsList = [
  { slug: 'collagen-stimulant', name: 'Collagen Matrix', icon: '🧬' },
  { slug: 'mmp-inhibitor', name: 'MMP Shield', icon: '🛡️' },
  { slug: 'anti-glycation', name: 'Glyco Defense', icon: '⏳' }
];

function getFilterUrl(cat: string | null, mech: string | null) {
  const params = new URLSearchParams();
  if (cat) params.set('category', cat);
  if (mech) params.set('mechanism', mech);
  const q = params.toString();
  return `/products${q ? '?' + q : ''}`;
}

function getPageUrl(page: number) {
  const params = new URLSearchParams();
  if (category) params.set('category', category);
  if (mechanism) params.set('mechanism', mechanism);
  if (page > 1) params.set('page', String(page));
  const q = params.toString();
  return `/products${q ? '?' + q : ''}`;
}

// Pre-compute pagination items to avoid Astro JSX parsing issues with > in templates
type PageItem = { type: 'page'; page: number; url: string; active: boolean } | { type: 'ellipsis' };
const pageItems: PageItem[] = [];
if (totalPages > 1) {
  const visiblePages = Array.from({ length: totalPages }, (_, i) => i + 1).filter(p =>
    p === 1 || p === totalPages ||
    (p >= currentPage - 1 && p <= currentPage + 1) ||
    (p === currentPage - 2 && currentPage > 3) ||
    (p === currentPage + 2 && currentPage < totalPages - 2)
  );
  visiblePages.forEach((p, idx) => {
    if (idx > 0 && p - visiblePages[idx - 1] > 1) pageItems.push({ type: 'ellipsis' });
    pageItems.push({ type: 'page', page: p, url: getPageUrl(p), active: p === currentPage });
  });
}

let pageTitle = "Bioactive Ingredient Solutions Catalog | GINKVORA";
if (mechanism === 'collagen-stimulant') {
  pageTitle = "Collagen Synthesis Stimulants Wholesale | GINKVORA";
} else if (mechanism === 'mmp-inhibitor') {
  pageTitle = "MMP Inhibitors Wholesale | Cosmetic Grade | GINKVORA";
} else if (mechanism === 'anti-glycation') {
  pageTitle = "Anti-Glycation Active Ingredients Wholesale | GINKVORA";
}

let pageDescription = "Browse GINKVORA's bioactive ingredient solutions for formulators: botanical extracts, peptides, and functional actives for cosmetic and nutraceutical development.";
if (category === 'pet-longevity') {
  pageDescription = "High-purity botanical raw materials targeting canine and feline cellular senescence. Premium sirtuin activators and mitochondrial protectants for pet longevity.";
}

let academicIntro = "";
if (category === 'pet-longevity') {
  academicIntro = "Targeting canine and feline cellular senescence via high-purity sirtuin activators and mitochondrial protectants.";
}

// Breadcrumb structured data
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": `${siteUrl}/products`
    }
  ]
};

// ItemList structured data — enables rich product list results in Google
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "GINKVORA Bioactive Ingredient Product Catalog",
  "description": pageDescription,
  "url": `${siteUrl}/products`,
  "numberOfItems": totalProducts,
  "itemListElement": products.map((prod, i) => ({
    "@type": "ListItem",
    "position": pageStart + i + 1,
    "url": `${siteUrl}/products/${prod.slug}`,
    "name": prod.name,
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <main class="products-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">B2B Product Catalog</span>
        <h1 class="banner-title fade-in-up delay-1">
          {mechanism === 'collagen-stimulant' && "Collagen Synthesis Stimulants Wholesale"}
          {mechanism === 'mmp-inhibitor' && "MMP Inhibitors Wholesale (Cosmetic Grade)"}
          {mechanism === 'anti-glycation' && "Anti-Glycation Active Ingredients Wholesale"}
          {!mechanism && "Bioactive Ingredient Solutions: Botanical Extracts & Functional Actives"}
        </h1>
        <p class="banner-desc fade-in-up delay-2">
          {academicIntro ? (
            <span class="academic-highlight">{academicIntro}</span>
          ) : (
            "High-purity ingredients tested under strict quality standards for supplement, cosmetic, and functional food formulators."
          )}
        </p>

        <!-- Prominent Hero Search Area -->
        <div class="hero-search-wrapper fade-in-up delay-3">
          <div class="hero-search-box">
            <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              type="search"
              id="hero-product-search"
              placeholder="Search ingredients by name, CAS number (e.g. 13749-38-7), or purity..."
              aria-label="Search catalog ingredients"
            />
            <button type="button" class="hero-search-btn" id="hero-search-trigger">
              Search Catalog
            </button>
          </div>
          <!-- Hot Search Keyword Tags -->
          <div class="hero-hot-tags">
            <button type="button" class="hero-tag-btn" data-search="Proxylane">🔥 Proxylane</button>
            <button type="button" class="hero-tag-btn" data-search="NMN">⚡ NMN</button>
            <button type="button" class="hero-tag-btn" data-search="PQQ">🌟 PQQ</button>
            <button type="button" class="hero-tag-btn" data-search="Glabridin">🌿 Glabridin</button>
            <button type="button" class="hero-tag-btn" data-search="EGCG">🍃 EGCG</button>
            <button type="button" class="hero-tag-btn" data-search="Liposomal">🧬 Liposomal</button>
            <button type="button" class="hero-tag-btn" data-search="13749-38-7">🧪 CAS 13749-38-7</button>
          </div>
        </div>
      </div>
    </header>

    <div class="container catalog-container">
      <!-- Filter bar -->
      <section class="controls-section glass" aria-label="Filters">

        <div class="filter-row">
          <span class="filter-label">Filter by Category:</span>
          <nav class="category-tabs" aria-label="Product categories">
            <a 
              href={getFilterUrl(null, mechanism)} 
              class={`category-tab ${!category ? 'active' : ''}`}
            >
              All Categories
            </a>
            {categoriesList.map((cat) => (
              <a 
                href={getFilterUrl(cat.slug, mechanism)} 
                class={`category-tab ${category === cat.slug ? 'active' : ''}`}
              >
                <span class="tab-icon">{cat.icon}</span>
                {cat.name}
              </a>
            ))}
          </nav>
        </div>

        <div class="filter-row">
          <span class="filter-label">Filter by Anti-Aging Target:</span>
          <nav class="category-tabs" aria-label="Anti-aging targets">
            <a 
              href={getFilterUrl(category, null)} 
              class={`category-tab ${!mechanism ? 'active' : ''}`}
            >
              All Targets
            </a>
            {mechanismsList.map((mech) => (
              <a 
                href={getFilterUrl(category, mech.slug)} 
                class={`category-tab ${mechanism === mech.slug ? 'active' : ''}`}
              >
                <span class="tab-icon">{mech.icon}</span>
                {mech.name}
              </a>
            ))}
          </nav>
        </div>
      </section>

      <!-- Products Grid -->
      <section class="products-section" aria-label="Product List">
        <div class="products-count" id="products-count-label">
          Showing {pageStart + 1}–{Math.min(pageStart + PRODUCTS_PER_PAGE, totalProducts)} of {totalProducts} products
        </div>

        <div class="products-grid" id="products-grid" data-current-page={currentPage}>
          {products.map((prod, index) => {
            return (
              <article
                class="product-card glass reveal"
                data-name={prod.name.toLowerCase()}
                data-cas={prod.casNumber ? prod.casNumber.toLowerCase() : ''}
                data-desc={prod.shortDescription ? prod.shortDescription.toLowerCase() : ''}
                data-page-index={currentPage}
                style="display: flex;"
              >
                <div class="card-image-wrapper">
                  <a href={`/products/${prod.slug}`} class="card-image-link" aria-label={`View details of ${prod.name}`}>
                    <picture style="display: contents;">
                      <source
                        srcset={`${urlFor(prod.heroImage).width(400).format('webp').url()} 400w, ${urlFor(prod.heroImage).width(800).format('webp').url()} 800w`}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                        type="image/webp"
                      />
                      <img
                        src={urlFor(prod.heroImage).width(400).url()}
                        alt={prod.name}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'low'}
                        width="400"
                        height="300"
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                        class="card-image"
                      />
                    </picture>
                  </a>
                  <span class="card-category-badge">
                    {prod.categories && prod.categories.length > 0
                      ? prod.categories.map(c => c.name).join(' · ')
                      : prod.category?.name}
                  </span>
                </div>

                <div class="card-content">
                  <div class="card-specs">
                    {prod.purity && (
                      <span class="card-purity">{prod.purity}</span>
                    )}
                    {prod.casNumber && (
                      <span class="card-cas">CAS: {prod.casNumber}</span>
                    )}
                    {prod.applicationDisplay && (
                      <span class={`card-app-badge app--${prod.applicationDisplay}`}>
                        {prod.applicationDisplay === 'dual' && '● Dual Application'}
                        {prod.applicationDisplay === 'topical' && '● Topical Use'}
                        {prod.applicationDisplay === 'oral' && '● Oral Use'}
                      </span>
                    )}
                  </div>

                  <h3 class="card-title">
                    <a href={`/products/${prod.slug}`}>{prod.name}</a>
                  </h3>

                  {prod.botanicalName && (
                    <p class="card-botanical">{prod.botanicalName}</p>
                  )}

                  <p class="card-desc">{prod.shortDescription}</p>

                  <div class="card-footer">
                    <a href={`/products/${prod.slug}`} class="btn btn--secondary btn--sm">
                      Specifications
                    </a>
                    <a href={`/contact?product=${encodeURIComponent(prod.name)}`} class="btn btn--primary btn--sm">
                      Inquire
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty state -->
        <div class="empty-state" id="empty-state" style="display: none;" role="alert">
          <div class="empty-icon">🔍</div>
          <h3>No products match your search</h3>
          <p>Try checking your spelling, selecting a different category, or contacting us for custom sourcing.</p>
          <button class="btn btn--gold" id="reset-filters">Reset Filters</button>
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <nav class="pagination" aria-label="Product pages" id="pagination-nav">
            <a
              href={getPageUrl(currentPage - 1)}
              class={`page-btn page-prev ${currentPage === 1 ? 'disabled' : ''}`}
              aria-disabled={currentPage === 1}
              aria-label="Previous page"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </a>

            {pageItems.map((item) =>
              item.type === 'ellipsis'
                ? <span class="page-ellipsis">…</span>
                : <a
                    href={item.url}
                    class={`page-btn page-num ${item.active ? 'active' : ''}`}
                    aria-current={item.active ? 'page' : undefined}
                  >{item.page}</a>
            )}

            <a
              href={getPageUrl(currentPage + 1)}
              class={`page-btn page-next ${currentPage === totalPages ? 'disabled' : ''}`}
              aria-disabled={currentPage === totalPages}
              aria-label="Next page"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          </nav>
        )}
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .products-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 7rem 3.5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-content {
    position: relative;
    z-index: var(--z-base);
  }

  .banner-title {
    font-size: clamp(1.75rem, 2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    margin-top: 0.5rem;
    color: var(--color-text);
    max-width: none;
    white-space: nowrap;
  }

  @media (max-width: 1280px) {
    .banner-title {
      white-space: normal;
    }
  }

  .banner-desc {
    max-width: 1100px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .academic-highlight {
    display: block;
    font-style: italic;
    color: var(--color-primary-light);
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* ── Hero Search Widget ── */
  .hero-search-wrapper {
    margin-top: 2rem;
    max-width: 860px;
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px 6px 18px;
    background: rgba(12, 14, 12, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 166, 84, 0.4);
    border-radius: 9999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(212, 166, 84, 0.15);
    transition: all 0.3s ease;
  }

  .hero-search-box:focus-within {
    border-color: rgba(212, 166, 84, 0.8);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(212, 166, 84, 0.3);
  }

  .hero-search-icon {
    color: #d4a654;
    flex-shrink: 0;
  }

  .hero-search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: #fff;
    font-family: inherit;
  }

  .hero-search-box input::placeholder {
    color: rgba(245, 239, 224, 0.45);
  }

  .hero-search-btn {
    padding: 0.65rem 1.4rem;
    background: linear-gradient(135deg, #d4a654 0%, #b8860b 100%);
    border: none;
    border-radius: 9999px;
    color: #060503;
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .hero-search-btn:hover {
    background: linear-gradient(135deg, #f0c878 0%, #d4a654 100%);
    box-shadow: 0 4px 15px rgba(212, 166, 84, 0.4);
  }

  .hero-hot-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .hot-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #d4a654;
    margin-right: 4px;
  }

  .hero-tag-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 166, 84, 0.2);
    color: #e0d8c3;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hero-tag-btn:hover {
    background: rgba(212, 166, 84, 0.2);
    border-color: rgba(212, 166, 84, 0.5);
    color: #f0c878;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero-search-btn { display: none; }
    .hero-search-box { padding-right: 14px; }
  }

  /* ── Controls Section ── */
  .catalog-container {
    margin-top: -2rem;
    position: relative;
    z-index: var(--z-float);
  }

  .controls-section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.18) !important;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
    transition: color var(--transition-fast);
  }

  .search-box:focus-within .search-icon {
    color: var(--color-primary-light);
  }

  .search-box input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 3rem;
    background: rgba(18, 16, 12, 0.7);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.95rem;
    transition: all var(--transition-fast);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .search-box input:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(24, 20, 15, 0.85);
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--color-primary-light);
    box-shadow: 0 0 0 3px rgba(212, 166, 84, 0.25), 0 0 15px rgba(212, 166, 84, 0.15);
    background: rgba(24, 20, 15, 0.95);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.625rem;
    margin-top: 0;
    width: 100%;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .filter-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 170px;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .category-tabs {
    display: flex;
    gap: 0.375rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
    flex-wrap: wrap;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  .category-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.875rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    white-space: nowrap;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .category-tab:hover {
    color: var(--color-text);
    border-color: var(--color-primary-light);
    background: var(--color-surface-2);
  }

  .category-tab.active {
    color: var(--color-text-inverse);
    background: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  .tab-icon {
    font-size: 1rem;
  }

  /* ── Products Section ── */
  .products-section {
    padding-top: 1.5rem;
  }

  .products-count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Product Card ── */
  .product-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    border-color: rgba(212, 166, 84, 0.12) !important;
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0d0c0a;
  }

  .card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-category-badge {
    position: absolute;
    top: 0.75rem;
