    color: var(--color-text-secondary);
    max-width: 400px;
    margin: 0 auto 1.5rem;
  }

  /* ── Pagination ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .page-btn:hover:not(.disabled) {
    background: var(--color-surface-2);
    border-color: var(--color-primary);
    color: var(--color-primary-light);
  }

  .page-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: 700;
  }

  .page-btn.disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .page-ellipsis {
    color: var(--color-text-muted);
    padding: 0 0.25rem;
  }
</style>

<script>
  function initFilters() {
    const heroSearchInput = document.getElementById('hero-product-search') as HTMLInputElement;
    const heroSearchBtn = document.getElementById('hero-search-trigger');
    const heroTagBtns = document.querySelectorAll('.hero-tag-btn');
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');
    const emptyState = document.getElementById('empty-state');
    const countLabel = document.getElementById('products-count-label');
    const paginationNav = document.getElementById('pagination-nav');
    const urlParams = new URLSearchParams(window.location.search);
    const currentPageNum = parseInt(urlParams.get('page') || '1');

    let currentSearch = '';

    function filterProducts() {
      let visibleCount = 0;

      productCards.forEach((card) => {
        const name = card.dataset.name || '';
        const cas = card.dataset.cas || '';
        const desc = card.dataset.desc || '';

        const matchesSearch =
          !currentSearch ||
          name.includes(currentSearch) ||
          cas.includes(currentSearch) ||
          desc.includes(currentSearch);

        if (matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (countLabel) {
        if (currentSearch) {
          countLabel.textContent = `Showing ${visibleCount} matching ingredient${visibleCount === 1 ? '' : 's'}`;
        } else {
          const totalProds = productCards.length;
          countLabel.textContent = `Showing page ${currentPageNum} (${visibleCount} products displayed)`;
        }
      }

      if (paginationNav) {
        paginationNav.style.display = currentSearch ? 'none' : 'flex';
      }
    }

    function updateSearchTerm(term: string) {
      currentSearch = term.toLowerCase().trim();
      if (heroSearchInput) heroSearchInput.value = term;
      filterProducts();
    }

    if (heroSearchInput) {
      heroSearchInput.addEventListener('input', (e) => {
        updateSearchTerm((e.target as HTMLInputElement).value);
      });
    }

    if (heroSearchBtn) {
      heroSearchBtn.addEventListener('click', () => {
        const term = heroSearchInput ? heroSearchInput.value : '';
        updateSearchTerm(term);
        const catalogContainer = document.querySelector('.catalog-container');
        if (catalogContainer) {
          catalogContainer.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    heroTagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const searchKeyword = btn.getAttribute('data-search') || '';
        updateSearchTerm(searchKeyword);
        const catalogContainer = document.querySelector('.catalog-container');
        if (catalogContainer) {
          catalogContainer.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Handle URL search parameter (e.g. /products?search=NMN)
    const searchParam = urlParams.get('search');
    if (searchParam) {
      updateSearchTerm(searchParam);
    }

    // Reset button inside empty state
    const resetButton = document.getElementById('reset-filters');
    if (resetButton) {
      resetButton.addEventListener('click', () => {
        updateSearchTerm('');
      });
    }

    filterProducts();
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
