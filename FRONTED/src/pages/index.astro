---
// src/pages/index.astro — Homepage
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import CertificationsMarquee from '../components/sections/CertificationsMarquee.astro';
import TwoRoutesSection from '../components/sections/TwoRoutesSection.astro';
import ECMPathwaysSection from '../components/sections/ECMPathwaysSection.astro';
import ProductCategoriesSection from '../components/sections/ProductCategoriesSection.astro';
import StatsSection from '../components/sections/StatsSection.astro';
import FeaturedIngredientsSection from '../components/sections/FeaturedIngredientsSection.astro';
import WhyUsSection from '../components/sections/WhyUsSection.astro';
import ExtractionProcessSection from '../components/sections/ExtractionProcessSection.astro';
import InsightsPreviewSection from '../components/sections/InsightsPreviewSection.astro';
import ContactCTASection from '../components/sections/ContactCTASection.astro';

// Structured data for homepage (WebSite + Organization Knowledge Graph for GEO & AI Search)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://ginkvora.com/#website',
      name: 'GINKVORA',
      url: 'https://ginkvora.com',
      description: 'High-Purity Botanical Extracts & Longevity Actives B2B Raw Material Supplier.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://ginkvora.com/products?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://ginkvora.com/#organization',
      name: 'GINKVORA',
      url: 'https://ginkvora.com',
      logo: 'https://ginkvora.com/favicon.svg',
      description: 'GINKVORA is a certified B2B supplier of high-purity botanical and bioactive raw materials for the cosmetic and health industries.',
      knowsAbout: [
        'High-Purity Botanical Extracts',
        'Longevity Active Raw Materials',
        'PDRN Cosmetic Raw Material',
        'Bulk NMN Supply',
        'Glabridin Powder',
        'Liposomal Delivery Systems',
        'Cellular Health Ingredients',
        'Extracellular Matrix Science',
      ],
      areaServed: 'Global',
      makesOffer: {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'B2B Bulk Ingredient Supply & Custom Formulation',
        },
      },
    },
  ],
};
---

<BaseLayout
  title="High-Purity Botanical Extracts & Longevity Actives | B2B Raw Material Supplier | GINKVORA"
  description="GINKVORA is a certified B2B supplier of high-purity botanical and bioactive raw materials for the cosmetic and health industries. We supply bulk active ingredients including NMN, PDRN, and Glabridin with full batch testing documentation."
  structuredData={websiteSchema}
  preloadHeroImage={true}
>
  <HeroSection />
  <CertificationsMarquee />
  <ProductCategoriesSection />
  
  <!-- Visual Divider Break -->
  <div class="section-divider-break container reveal">
    <div class="divider-line"></div>
    <p class="divider-text">
      From ingredient selection to documentation-ready supply.
    </p>
    <div class="divider-line"></div>
  </div>

  <TwoRoutesSection />
  <ExtractionProcessSection />
  <ECMPathwaysSection />
  <StatsSection />
  <WhyUsSection />
  <FeaturedIngredientsSection />
  <InsightsPreviewSection />
  <ContactCTASection />
</BaseLayout>
