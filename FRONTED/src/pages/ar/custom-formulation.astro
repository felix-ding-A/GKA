---
const lang = 'ar';
// src/pages/custom-formulation.astro — Premium B2B Custom Formulation & OEM Page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://ginkvora.com/ar' },
    { '@type': 'ListItem', position: 2, name: 'تركيبات مخصصة', item: 'https://ginkvora.com/ar/custom-formulation' },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'خدمات التركيبات المخصصة والتصنيع التعاقدي | GINKVORA',
  'description': 'خدمات التصنيع التعاقدي والتركيبات المخصصة للأفلام الرقيقة الفموية (OTF) والكبسلة الليبوزومية المتقدمة. حلول OEM/ODM مخصصة لقطاع B2B.',
  'url': 'https://ginkvora.com/ar/custom-formulation',
};




---

<BaseLayout lang={lang}
  title="خدمات التركيبات المخصصة والتصنيع التعاقدي | GINKVORA"
  description="خدمات التصنيع التعاقدي والتركيبات المخصصة للأفلام الرقيقة الفموية (OTF) والكبسلة الليبوزومية المتقدمة. حلول OEM/ODM مخصصة لقطاع B2B."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <main class="formulation-page bg-noise">
    <!-- Hero Section -->
    <header class="page-banner" aria-label="ترويسة الصفحة">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <div class="hero-columns">
          <div class="hero-text-col reveal">
            <span class="section-label">تصنيع OEM/ODM مخصص لقطاع B2B</span>
            <h1 class="banner-title">حلول التركيبات المخصصة: <span class="gradient-text--gold">من الابتكار إلى منتجات جاهزة للسوق</span></h1>
            <p class="banner-desc">
              تمكين علامتك التجارية بأحدث تقنيات الأفلام الرقيقة الفموية (OTF) وتكنولوجيا الكبسلة. مخصصة لتلبية متمتطلبات المكونات النشطة الخاصة بك ومحسنة لتحقيق أقصى قدر من الفعالية.
            </p>
            <div class="hero-actions">
              <a href="#inquiry-form-section" class="btn btn--gold">طلب عرض سعر تركيبة</a>
            </div>
          </div>
          <div class="hero-visual-col reveal reveal-delay-2">
            <div class="image-showcase glass hero-carousel">
              <div class="carousel-slides">
                <div class="carousel-slide active">
                  <img
                    src="/images/ginkvora-cleanroom-manufacturing-machinery.webp"
                    alt="معدات التصنيع في الغرفة النظيفة فئة 100,000 من GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">التصنيع في غرفة نظيفة فئة 100,000</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-gmp-capsule-bottle-filling-line.webp"
                    alt="خط تعبئة زجاجات الكبسولات الآلي GMP من GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">خط تعبئة الكبسولات الآلي GMP</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-otf-strip-packaging-cleanroom-line.webp"
                    alt="خط تغليف أشرطة OTF الدقيقة في الغرفة النظيفة من GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">خط تغليف أشرطة OTF الدقيقة</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora%20QC%20Laboratory.webp"
                    alt="مختبر مراقبة الجودة المتطور من GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">مختبر مراقبة الجودة المتطور</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-rd-analytical-laboratory.webp"
                    alt="مختبر التحليل والتركيبات للبحث والتطوير من GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">مركز التحليل والتركيبات للبحث والتطوير</div>
                </div>
              </div>
              
              <!-- Carousel Indicators -->
              <div class="carousel-indicators">
                <span class="indicator active" data-index="0"></span>
                <span class="indicator" data-index="1"></span>
                <span class="indicator" data-index="2"></span>
                <span class="indicator" data-index="3"></span>
                <span class="indicator" data-index="4"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- The Core Focus: OTF -->
    <section class="section otf-section bg-deep" id="otf-focus" aria-label="تقنية الأفلام الرقيقة الفموية">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">التخصص الأساسي</span>
          <h2 class="section-title">أفلام رقيقة فموية (OTF) مصممة بدقة</h2>
          <p class="section-desc">
            استفد من تقنية تسليم الأفلام الرقيقة الرائدة في فئتها لتمييز علامتك التجارية عن الكبسولات والأقراص القياسية.
          </p>
        </div>

        <div class="grid-2-columns">
          <div class="visual-panel reveal">
            <div class="image-showcase glass">
              <img
                src="/images/oral-dissolving-film-benefits.webp"
                alt="مزايا الفيلم الرقيق الفموي (OTF) بما في ذلك الامتصاص السريع والمصفوفة القابلة للتخصيص وقدرة التحميل العالية"
                class="showcase-img"
                width="600"
                height="400"
              />
            </div>
          </div>

          <div class="content-panel">
            <div class="feature-card glass reveal reveal-delay-1">
              <div class="feature-icon">⚡</div>
              <div class="feature-body">
                <h3>امتصاص سريع وتوافر حيوي عالٍ</h3>
                <p>
                  يتجاوز الاستقلاب الكبدي الأول. يذوب فوراً في تجويف الفم لامتصاص سريع عبر الغشاء المخاطي والتوصيل النظامي المباشر.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-2">
              <div class="feature-icon">🧪</div>
              <div class="feature-body">
                <h3>مصفوفة بوليمر مخصصة</h3>
                <p>
                  تغطية طعم مصممة هندسياً، وملفات ذوبان مخصصة (من فوري إلى خاضع للرقابة)، وسعات تحميل مكونات نشطة مخصصة تصل إلى 150 ملغ لكل فيلم.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-3">
              <div class="feature-icon">💧</div>
              <div class="feature-body">
                <h3>لا يتطلب ماء وسهل الحمل</h3>
                <p>
                  لا حاجة لاستهلاك الماء. يوفر راحة تامة أثناء التنقل لمنتجات نمط الحياة النشط، مما يزيد من التزام المستهلك والولاء للعلامة التجارية.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-4">
              <div class="feature-icon">🌿</div>
              <div class="feature-body">
                <h3>تركيز التطبيق: مكافحة الشيخوخة، المنشطات الذهنية والجمال الداخلي</h3>
                <p>
                  مثالي لسلائف NAD+ (مثل NMN)، وPQQ، والغلوتاثيون، والمستخلصات النباتية. تضمن تقنية OTF الخاصة بنا التوصيل الأمثل للمكونات النشطة بيولوجياً لمكافحة الشيخوخة، ودعم الصحة الخلوية من الداخل (ECM).
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diversified Solutions: Encapsulation -->
    <section class="container section encapsulation-section" aria-label="خدمات الكبسلة">
      <div class="section-header reveal">
        <span class="section-label">أنظمة توصيل متنوعة</span>
        <h2 class="section-title">خدمات الكبسلة المتقدمة</h2>
        <p class="section-desc">
          بجانب الأفلام الرقيقة، تقدم GINKVORA تنسيقات كبسلة متقدمة متعددة لاستقرار المواد الحساسة والتحكم في حركية الإطلاق.
        </p>
      </div>

      <div class="grid-3">
        <div class="cap-card glass reveal">
          <div class="cap-icon">🧬</div>
          <h3>التركيبات الليبوزومية</h3>
          <p>
            تحمي الكريات المجهرية ذات الطبقة الثنائية الدهنية الجزيئات الهشة (مثل فيتامين C أو الجلابريدين) من أحماض المعدة، مما يعزز الامتصاص المعوي.
          </p>
          <div class="cap-tag">الاستقرار والتوافر الحيوي</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-1">
          <div class="cap-icon">⚪</div>
          <h3>تصنيع الأقراص المخصصة</h3>
          <p>
            كبس أقراص دوار عالي الدقة يدعم الأقراص المغلفة، والقابلة للمضغ، وتحت اللسان، والفوارة. قوالب مخصصة للأشكال وشعار العلامة التجارية مع تحكم دقيق في معدل الذوبان.
          </p>
          <div class="cap-tag">ضغط عالي الدقة</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-2">
          <div class="cap-icon">💊</div>
          <h3>كبسولات صلبة مخصصة</h3>
          <p>
            تعبئة كبسولات HPMC والبولولان النباتية بدقة جرعات ميكروية. قادرة على مزج مساحيق المستخلصات الجافة المعقدة مع الحد الأدنى من استخدام السواغات.
          </p>
          <div class="cap-tag">إنتاج قابل للتوسع</div>
        </div>
      </div>

      <div class="encap-footer-visual reveal mt-6">
        <div class="image-showcase glass">
          <img
            src="/images/ginkvora-advanced-delivery-systems-microencapsulation.webp"
            alt="تقنيات التركيب المتقدمة التي تجمع بين الكبسلة الدقيقة وأنظمة التوصيل الليبوزومي والأشكال الصلبة عالية الدقة لتعزيز التوافر الحيوي"
            class="showcase-img"
            width="1632"
            height="656"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Technical Capabilities -->
    <section class="section capabilities-section bg-deep" aria-label="القدرات الفنية">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">لماذا تختار GINKVORA</span>
          <h2 class="section-title">القدرات التقنية والتميز في البحث والتطوير</h2>
          <p class="section-desc">
            نحن نجسّر الفجوة بين الابتكارات على المستوى المختبري والتصنيع التعاقدي التجاري بكميات كبيرة.
          </p>
        </div>

        <div class="grid-3">
          <div class="capability-item reveal">
            <div class="cap-num">01</div>
            <h3>التميز في البحث والتطوير</h3>
            <p>
              يقوم علماؤنا بتخصيص مرونة الفيلم وسمكه وملفات تغطية الطعم ومعايير تحميل المواد النشطة لتتوافق مع متطلبات تركيبتك المخصصة.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-1">
            <div class="cap-num">02</div>
            <h3>معايير جودة GMP</h3>
            <p>
              تتوافق الغرف النظيفة الخاضعة لرقابة صارمة على درجات الحرارة والرطوبة مع معايير GMP. تخضع جميع تجارب التشغيل والدفعات التجارية للتحقق الصارم باستخدام HPLC/ICP-MS.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-2">
            <div class="cap-num">03</div>
            <h3>دعم متكامل من البداية للنهاية</h3>
            <p>
              من شراء المواد الخام واختبار المكونات النشطة إلى تصميم التركيبة، والدفعات التجريبية، والتعبئة النهائية في عبوات البثرة للبيع بالتجزئة.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We Work -->
    <section class="container section timeline-section" aria-label="آلية العمل">
      <div class="section-header reveal">
        <span class="section-label">خطوات متكاملة خطوة بخطوة</span>
        <h2 class="section-title">آلية التعاون والعمل المشترك</h2>
        <p class="section-desc">
          كيف ننقل فكرة منتجك من مناقشات البحث والتطوير المبكرة إلى شحن دفعات جاهزة للبيع.
        </p>
      </div>

      <div class="process-timeline" role="list">
        <!-- Step 1 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">01</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal">
            <div class="step-icon-emoji">💬</div>
            <div class="step-body">
              <h3>مرحلة الاستشارة وبلورة المفهوم</h3>
              <p>مناقشة المكونات النشطة المستهدفة (مثل NMN، PQQ)، وأهداف شكل الجرعة، ومواصفات الإطلاق، واللوائح الإقليمية المستهدفة.</p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">02</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-1">
            <div class="step-icon-emoji">🔬</div>
            <div class="step-body">
              <h3>تطوير التركيبة</h3>
              <p>يصمم مختبرنا مصفوفة البوليمر، وتهيئة عامل إخفاء الطعم، ويجهز النماذج الفيزيائية لتقييم الاستقرار والتفتت والسمك.</p>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">03</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-2">
            <div class="step-icon-emoji">⚙️</div>
            <div class="step-body">
              <h3>توسيع نطاق الإنتاج والتشغيل التجريبي</h3>
              <p>ننقل تركيبة المختبر إلى خط الإنتاج التجريبي لدينا، ونختبر معايير العملية وحركية التجفيف واتساق التحميل.</p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="process-step process-step--last" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">04</span></div>
          </div>
          <div class="step-content glass reveal reveal-delay-3">
            <div class="step-icon-emoji">📦</div>
            <div class="step-body">
              <h3>التصنيع التجاري الكامل بمعايير GMP</h3>
              <p>عند الموافقة على التشغيل التجريبي، ننفذ إنتاجاً تجارياً بكميات كبيرة تحت ضوابط GMP، ونجمع وثائق شهادة التحليل (COA) الكاملة، ونعبي البراميل أو البثرات الجاهزة للشحن.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA & Form Section -->
    <section class="section form-section bg-deep" id="inquiry-form-section" aria-label="نموذج استفسار التركيبات">
      <div class="container">
        <div class="grid-cta">
          <!-- Left info -->
          <div class="cta-info reveal">
            <span class="section-label">المصادر التجارية</span>
            <h2>هل أنت مستعد لتحويل فكرتك إلى حقيقة؟</h2>
            <p class="cta-desc">
              تواصل مع مكتب التركيبات العلمية لدينا. نحن نقدم خدمات التصنيع التعاقدي المخصصة، وOEM/ODM للعلامات التجارية الخاصة، ودفعات عينات تجريبية لشركاء العلامات التجارية المؤهلين.
            </p>

            <div class="contact-list">
              <div class="contact-item">
                <span class="icon">📧</span>
                <div>
                  <strong>البريد الإلكتروني للاستفسار المباشر</strong>
                  <a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">📞</span>
                <div>
                  <strong>الدعم التجاري عبر الواتساب</strong>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer">+86 13201818603</a>
                </div>
              </div>
            </div>

            <div class="policy-card glass mt-6">
              <h3>إرشادات العلامة الخاصة وتصنيع OEM</h3>
              <ul class="policy-list">
                <li><strong>دفعات العينات:</strong> تتوفر أفلام اختبار النماذج الأولية لعلامات التجميل والمكملات المؤهلة.</li>
                <li><strong>امتثال الوثائق:</strong> يتم توفير شهادة التحليل (COA)، واختبار المعادن الثقيلة، ووثائق ورقة العملية مع كل عرض سعر تركيبة.</li>
                <li><strong>المكونات المخصصة:</strong> يمكننا صياغة المنتجات باستخدام مواد خام مقدمة من العميل أو توفيرها من خلال موردينا الموثوقين.</li>
              </ul>
            </div>
          </div>

          <!-- Right form -->
          <div class="cta-form-wrapper reveal reveal-delay-1">
            <div class="form-card glass">
              <h3>طلب عرض سعر تركيبة</h3>
              <p class="form-sub">الحقول المميزة بنجمة (*) مطلوبة.</p>

              <form id="formulation-quote-form" class="custom-form">
                <!-- Honeypot -->
                <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="اترك هذا الحقل فارغاً" />

                <div class="form-field">
                  <label for="name" class="form-label">الاسم / اسم الشركة *</label>
                  <input type="text" id="name" name="name" required class="form-input" placeholder="جون دو / شركة بيوتيك المحدودة" />
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="email" class="form-label">البريد الإلكتروني / بريد العمل *</label>
                    <input type="email" id="email" name="email" required class="form-input" placeholder="name@company.com" />
                  </div>
                  <div class="form-field">
                    <label for="phone" class="form-label">الهاتف / الواتساب *</label>
                    <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+1 (555) 123-4567" />
                  </div>
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="productConcept" class="form-label">مفهوم المنتج *</label>
                    <input type="text" id="productConcept" name="productConcept" required class="form-input" placeholder="مثل: فيلم رقيق فموي، ليبوزومات" />
                  </div>
                  <div class="form-field">
                    <label for="expectedVolume" class="form-label">الحجم المتوقع *</label>
                    <select id="expectedVolume" name="expectedVolume" required class="form-input form-select">
                      <option value="" disabled selected>اختر نطاق الحجم...</option>
                      <option value="under-100k">أقل من 100 ألف قطعة</option>
                      <option value="100k-500k">100 ألف - 500 ألف قطعة</option>
                      <option value="over-500k">أكثر من 500 ألف قطعة</option>
                    </select>
                  </div>
                </div>

                <div class="form-field">
                  <label for="message" class="form-label">متطلبات التركيبة التفصيلية</label>
