---
const lang = 'ar';
// src/pages/about.astro — Premium B2B About page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllAuthors, urlFor, getLocalizedField } from '../../lib/sanity';

const authors = await getAllAuthors();

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "من نحن GINKVORA",
  "description": "تورّد GINKVORA المكونات النباتية والنشطة حيوياً وتوفّر منتجات مخصصة بنظام OEM. تعرّفوا على بيانات الشركة ومراحل التوريد.",
  "url": "https://ginkvora.com/ar/about",
  "mainEntity": authors.map(author => ({
    "@type": "Person",
    "name": getLocalizedField(author, 'name', lang) || author.name,
    "jobTitle": getLocalizedField(author, 'title', lang) || author.title || undefined,
    "description": getLocalizedField(author, 'bio', lang) || author.bio || undefined,
    "image": author.avatar ? urlFor(author.avatar).url() : undefined
  }))
};




---

<BaseLayout lang={lang}
  title="مورّد المكونات النشطة حيوياً | نبذة عن GINKVORA"
  description="تورّد GINKVORA المكونات النباتية والنشطة حيوياً وتوفّر منتجات مخصصة بنظام OEM. تعرّفوا على بيانات الشركة ومراحل التوريد."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} slot="head" />
  <main class="about-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="ترويسة الصفحة">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">شركتنا</span>
        <h1 class="banner-title fade-in-up delay-1">خبرة نباتية. توريد المكونات النشطة حيوياً.</h1>
        <p class="banner-desc fade-in-up delay-2">مستخلصات نباتية ومكونات تجميلية فعّالة وببتيدات ومكونات وظيفية، مع تخصيص بنظام OEM لتطبيقات العناية بالبشرة والتغذية والعافية.</p>
      </div>
    </header>

    <!-- Company Intro -->
    <section class="container section intro-section" aria-label="نظرة عامة على الشركة">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>نبذة عن GINKVORA</h2>
          <p>تورّد GINKVORA المستخلصات النباتية والمكونات التجميلية الفعّالة والببتيدات والمكونات الوظيفية لتطبيقات العناية بالبشرة والتغذية والعافية، إلى جانب خدمات تخصيص المنتجات بنظام OEM.</p>
          <p>نخدم الموزعين وبائعي إعادة البيع ومطوّري التركيبات والمصنّعين حول العالم. كما نورّد المواد الخام التجميلية لصالونات التجميل، ونوفّر منتجات مخصصة بنظام OEM لمؤسسات إدارة الصحة.</p>
          <p>نتخذ من شيآن في الصين مقراً لنا، وننسّق توريد المكونات وتحديد المواصفات والوثائق والتسليم الدولي. هدفنا واضح: مساعدة العملاء على اختيار المكونات المناسبة وتطوير منتجات مخصصة، بمتطلبات واضحة ودعم عملي وجهة اتصال مباشرة.</p>
          <div class="mission-box">
            <span class="mission-title">مهمتنا الأساسية</span>
            <blockquote class="mission-text">
              "تمكين العلامات التجارية لصحة الإنسان من خلال تقديم النقاء المطلق للمكونات النشطة، وسجلات مراقبة الجودة القابلة للتحقق، وحلول التوريد بالجملة الموثوقة."
            </blockquote>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2">
          <div class="image-showcase glass">
            <img
              src="/images/ginkvora-rd-analytical-laboratory.webp"
              alt="مرفق أبحاث ومختبر GINKVORA"
              class="showcase-img"
              width="800"
              height="600"
            />
            <div class="floating-caption">
              <strong>مركز البحث والتطوير في شيان</strong>
              <span>تحليل الكروماتوغرافيا السائلة HPLC وطيف الكتلة</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Information -->
    <section class="container section company-section" aria-labelledby="company-information">
      <div class="company-grid">
        <div class="reveal">
          <span class="section-label">بيانات الشركة</span>
          <h2 id="company-information">معلومات الشركة</h2>
        </div>
        <dl class="company-card glass reveal">
          <div><dt>الاسم القانوني للشركة</dt><dd dir="ltr">Shaanxi Ginkvora Biotechnology Co., Ltd.</dd></div>
          <div><dt>رقم <bdi dir="ltr">D-U-N-S®</bdi></dt><dd dir="ltr">975262249</dd></div>
          <div><dt>العنوان المسجّل</dt><dd dir="ltr"><address>Room 502, Unit 1, Building 16,<br />CR Land Future City Chenxi, Gangfeng Road,<br />International Trade &amp; Logistics Park,<br />Xi'an, Shaanxi, China</address></dd></div>
          <div><dt>البريد الإلكتروني للاستفسارات التجارية</dt><dd dir="ltr"><a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- Managed Sourcing Stages -->
    <section class="section values-section bg-deep" aria-labelledby="how-we-work">
      <div class="container">
        <div class="section-header">
          <span class="section-label">كيف نعمل</span>
          <h2 class="section-title" id="how-we-work">جهة اتصال واحدة. أربع مراحل مُنسّقة.</h2>
          <p class="section-desc">عند الشراء من GINKVORA، تتعامل مع جهة اتصال واحدة تنسّق التوريد والوثائق والتحقق من الدفعات والتسليم.</p>
        </div>
        <div class="stages-grid">
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">01</div>
            <h3>تقييم المورّدين والمواصفات</h3><p>نقيّم المنتجين ونؤكد درجة المكوّن ومواصفاته ومتطلبات الطلب قبل الشراء.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">02</div>
            <h3>وثائق الدفعة</h3><p>ننسّق توفير شهادة التحليل (COA) الخاصة بكل دفعة والوثائق الداعمة ذات الصلة، بما فيها MSDS وTDS وتقارير الاختبار المتاحة، وفقاً للمنتج ومتطلباتكم المتعلقة بالوثائق.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">03</div>
            <h3>التحقق من الجودة</h3><p>نراجع نتائج الدفعة مقابل المواصفات المتفق عليها قبل الشحن. وبحسب المكوّن، قد تشمل هذه النتائج النقاء والمحتوى الكمي باستخدام HPLC، والمعادن الثقيلة، والمذيبات المتبقية، والحدود الميكروبيولوجية. ويُتفق على متطلبات الاختبارات الإضافية قبل تأكيد الطلب.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">04</div>
            <h3>التعبئة والتسليم</h3><p>نرتّب الشحن السريع أو الجوي أو البحري وفق شروط Incoterms المتفق عليها، ونؤكد معكم متطلبات التعبئة ومواعيد الإرسال. ويمكن ترتيب التعبئة مع الطرد بالنيتروجين للمكونات الفعّالة الحساسة الملائمة لهذه الطريقة.</p>
          </article>
        </div>
        <p class="process-note">طوال العملية، تتوفر لكم جهة اتصال مباشرة للاستفسار عن المواصفات والوثائق ومستجدات التسليم.</p>
      </div>
    </section>

    <!-- Authors Section -->
    <section class="container section authors-section" aria-label="مستشارونا والمتعاونون التقنيون">
      <div class="section-header">
        <span class="section-label">الخبرة والتعاون</span>
        <h2>مستشارونا والمتعاونون التقنيون</h2>
        <p class="section-desc">تعرّفوا على المتخصصين المستقلين الذين يتعاونون مع GINKVORA في المشاريع العلمية وتطوير التركيبات والشؤون التنظيمية والمشاريع التجارية.</p>
      </div>

      <div class="authors-grid">
        {authors.map((author) => (
          <div class="author-card glass reveal">
            <div class="author-avatar-wrapper">
              <img
                src={urlFor(author.avatar).width(160).height(160).fit('crop').url()}
                alt={author.name}
                class="author-avatar"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="author-info">
              <h3>{getLocalizedField(author, 'name', lang) || author.name}</h3>
              {(getLocalizedField(author, 'title', lang) || author.title) && <p class="author-title">{getLocalizedField(author, 'title', lang) || author.title}</p>}
              {(getLocalizedField(author, 'credentials', lang) || author.credentials) && <span class="author-creds">{getLocalizedField(author, 'credentials', lang) || author.credentials}</span>}
              {(getLocalizedField(author, 'bio', lang) || author.bio) && <p class="author-bio">{getLocalizedField(author, 'bio', lang) || author.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline/History Section -->
    <section class="container section history-section" aria-label="تاريخنا">
      <div class="section-header">
        <span class="section-label">مسيرتنا</span>
        <h2>النمو والمحطات الرئيسية</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-badge">2023</div>
          <div class="timeline-content glass">
            <h3>التأسيس والبحث والتطوير الأولي</h3>
            <p>تأسيس GINKVORA في شيان، والتخصص في أبحاث الميتوكوندريا المساعدة وإطلاق قنوات توريد PQQ وNMN عالية النقاء.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-1">
          <div class="timeline-badge">2024</div>
          <div class="timeline-content glass">
            <h3>شهادات التصنيع الجيد GMP والآيزو ISO</h3>
            <p>اكتمل بناء مصنع الاستخلاص الشريك لدينا. حصلنا على شهادات GMP وISO 9001:2015 وحلال وكوشر للامتثال الغذائي العالمي.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-2">
          <div class="timeline-badge">2025</div>
          <div class="timeline-content glass">
            <h3>إطلاق خطوط التجميل وصحة الحيوان</h3>
            <p>قمنا بتوسيع الكتالوج الكيميائي ليشمل جلابريدين لتفتيح البشرة، والفلافونويدات الطبيعية، والمكونات الغذائية المتخصصة لقطاع صحة الحيوانات الأليفة.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-3">
          <div class="timeline-badge">2026</div>
          <div class="timeline-content glass">
            <h3>الخدمات اللوجستية العالمية وإطلاق المنصة الرقمية</h3>
            <p>أطلقنا شبكة إمداد دولية عالية الأداء تخدم مكملات العناية بالبشرة والرياضة في أكثر من 50 دولة مع مراكز لوجستية محسنة.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- دعوة للشراكة -->
    <section class="container section cta-section" aria-label="طلب شراكة">
      <div class="cta-box glass">
        <h2>هل أنت مستعد للشراكة؟</h2>
        <p>تواصل مع فريقنا التجاري للحصول على الأسعار والوثائق الفنية وعينات المنتجات.</p>
        <div class="cta-btns">
          <a href="/ar/contact" class="btn btn--gold btn--lg">تواصل معنا</a>
          <a href="/ar/products" class="btn btn--primary btn--lg">تصفح المنتجات</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .company-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .company-grid h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-top: 0.5rem; }
  .company-card { margin: 0; padding: 2rem; border-radius: var(--radius-lg); min-width: 0; }
  .company-card > div { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .company-card > div:first-child { padding-top: 0; }
  .company-card > div:last-child { padding-bottom: 0; border-bottom: 0; }
  .company-card dt { color: var(--color-primary-light); font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem; }
  .company-card dd { margin: 0; color: var(--color-text); line-height: 1.75; overflow-wrap: anywhere; }
  .company-card address { font-style: normal; }
  .company-card a:hover { text-decoration: underline; }
  .stages-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .stages-grid .value-card { text-align: start; }
  .stages-grid .value-icon { color: var(--color-primary-light); font-family: var(--font-mono); font-size: 1.5rem; }
  .process-note { text-align: center; max-width: 760px; margin: 2rem auto 0; color: var(--color-text-secondary); }
  @media (max-width: 768px) {
    .company-grid, .stages-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .company-card { padding: 1.5rem; }
  }


  .about-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  .mission-box {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .mission-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .mission-text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.6;
  }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
    cursor: pointer;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 400ms) ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.05);
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Values Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212,166,84,0.1) !important;
    text-align: center;
    transition: all var(--transition-base, 250ms) ease;
  }

  .value-card:hover {
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-6px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 3rem auto 0;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-badge {
    position: absolute;
    left: calc(-2rem - 13px);
    top: 0.5rem;
    width: 26px;
    height: 26px;
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-primary-light);
    box-shadow: 0 0 10px rgba(212,166,84,0.3);
  }

  .timeline-content {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border-color: rgba(212,166,84,0.12) !important;
    transition: all var(--transition-base, 250ms) ease;
  }

  .timeline-content:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-gold);
  }

  .timeline-content h3 {
    font-size: 1.125rem;
    color: var(--color-primary-light);
    margin-bottom: 0.25rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Authors Section ── */
  .authors-section {
    margin-top: 2rem;
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .authors-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .author-card {
    display: flex;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    align-items: center;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (max-width: 540px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
    }
  }

  .author-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow-gold);
  }

  .author-avatar-wrapper {
    flex-shrink: 0;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary-light);
    box-shadow: 0 0 15px rgba(212, 166, 84, 0.15);
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base, 250ms) ease;
  }

  .author-card:hover .author-avatar {
    transform: scale(1.08);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-info h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .author-title {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    font-weight: 500;
  }

  .author-creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
