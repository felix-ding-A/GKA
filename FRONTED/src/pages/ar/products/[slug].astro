    text-align: center;
    margin-bottom: 1.25rem;
  }
  .success-check {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: block;
    stroke-width: 2;
    stroke: var(--color-success);
    stroke-miterlimit: 10;
    box-shadow: inset 0px 0px 0px var(--color-success);
    animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s dashed;
    margin: 0 auto;
  }
  .success-check-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    stroke: var(--color-success);
    fill: none;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }
  .success-check-mark {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    stroke-width: 3;
    stroke: var(--color-success);
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
  }
  @keyframes stroke {
    100% { stroke-dashoffset: 0; }
  }
  @keyframes fill {
    100% { box-shadow: inset 0px 0px 0px 30px rgba(124, 184, 122, 0.05); }
  }
  /* Product-page balance: supporting commercial information follows the hero grid. */
  .product-primary-action { margin-top: 0.25rem; }
  .product-primary-action .btn { min-width: min(100%, 17.5rem); justify-content: center; }
  .product-support-band { margin-top: 2rem; padding: 1.25rem 1.5rem; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(10rem, 0.7fr) minmax(12rem, 0.9fr) minmax(10rem, 0.75fr); gap: 1.25rem; align-items: center; border: 1px solid rgba(212, 166, 84, 0.16); border-radius: var(--radius-lg); background: rgba(255, 255, 255, 0.025); }
  .product-support-band .grade-tabs-block, .product-support-band .action-buttons, .product-support-band .certifications-badges { margin: 0; padding-right: 1.25rem; border-right: 1px solid rgba(255, 255, 255, 0.08); }
  .product-support-band .product-share-bar { margin: 0; padding: 0; border-top: 0; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  @media (max-width: 1200px) { .product-support-band { grid-template-columns: repeat(2, minmax(0, 1fr)); } .product-support-band .grade-tabs-block { grid-column: 1 / -1; } .product-support-band .certifications-badges { border-right: 0; } }
  @media (max-width: 640px) { .product-support-band { grid-template-columns: 1fr; padding: 1rem; gap: 1rem; } .product-support-band .grade-tabs-block, .product-support-band .action-buttons, .product-support-band .certifications-badges { padding-right: 0; padding-bottom: 1rem; border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); } }
</style>

<script>
  const siteKey = '6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid';
  let recaptchaPromise: Promise<any> | null = null;
  const loadRecaptcha = (): Promise<any> => {
    if (recaptchaPromise) return recaptchaPromise;
    recaptchaPromise = new Promise((resolve) => {
      if ((window as any).grecaptcha && (window as any).grecaptcha.execute) {
        resolve((window as any).grecaptcha);
        return;
      }
      const script = document.createElement('script');
      script.src = `https://www.google.com/recaptcha/api.js?render=${siteKey}`;
      script.async = true;
      script.onload = () => {
        if ((window as any).grecaptcha) {
          (window as any).grecaptcha.ready(() => resolve((window as any).grecaptcha));
        } else resolve(null);
      };
      script.onerror = () => resolve(null);
      document.head.appendChild(script);
    });
    return recaptchaPromise;
  };

  function initTabs() {
    const descSection = document.querySelector('.description-section');
    document.querySelectorAll('.detail-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab;
        document.querySelectorAll('.detail-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => (c as HTMLElement).style.display = 'none');
        tab.classList.add('active');
        const panel = document.getElementById(`tab-${target}`);
        if (panel) panel.style.display = 'block';

        if (descSection) {
          const rect = descSection.getBoundingClientRect();
          const navbarOffset = 70;
          if (rect.top < navbarOffset) {
            const targetY = window.scrollY + rect.top - navbarOffset;
            window.scrollTo({
              top: Math.max(0, targetY),
              behavior: 'smooth'
            });
          }
        }
      });
    });
  }

  // Inquiry submission handler
  const rfqForm = document.getElementById('product-rfq-form') as HTMLFormElement;
  const successMsg = document.getElementById('rfq-success-msg');
  const submitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement;

  if (rfqForm) {
    rfqForm.addEventListener('focusin', () => loadRecaptcha(), { once: true });

    rfqForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending Request...';
      }

      const formData = new FormData(rfqForm);
      if (formData.get('b_website')) {
        console.warn('Bot submission detected via honeypot field.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Quotation Request';
        }
        return;
      }

      const submitRfq = async (token?: string) => {
        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          quantity: formData.get('quantity') || 'Not specified',
          message: formData.get('message') || 'None',
          productName: formData.get('productName'),
          b_website: formData.get('b_website'),
          recaptchaToken: token || null,
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          if (res.ok) {
            rfqForm.reset();
            if (successMsg) successMsg.style.display = 'block';
            if (submitBtn) submitBtn.textContent = 'Submitted ✓';
            (window as any).gkvTrackLeadAndRedirect('/ar/thank-you', 'product_rfq');
          } else {
            const errData = await res.json();
            alert(errData.error || 'Failed to send request. Please try again or contact us directly.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Quotation Request';
            }
          }
        } catch (err) {
          alert('Network error. Please try again.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Quotation Request';
          }
        }
      };

      try {
        const grecaptcha = await loadRecaptcha();
        if (grecaptcha) {
          grecaptcha.execute(siteKey, { action: 'submit_rfq' })
            .then((token: string) => submitRfq(token))
            .catch((err: any) => {
              console.error('reCAPTCHA execution failed:', err);
              submitRfq();
            });
        } else {
          submitRfq();
        }
      } catch (e) {
        submitRfq();
      }
    });
  }



  function initSocialShare() {
    const shareFacebook = document.getElementById('share-facebook');
    const shareLinkedin = document.getElementById('share-linkedin');
    const shareTwitter = document.getElementById('share-twitter');
    const shareCopy = document.getElementById('share-copy');
    const shareEmail = document.getElementById('share-email');

    const pageUrl = window.location.href;
    const pageTitle = document.title;

    shareFacebook?.addEventListener('click', () => {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
    });

    shareLinkedin?.addEventListener('click', () => {
      window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
    });

    shareTwitter?.addEventListener('click', () => {
      window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`, '_blank', 'width=600,height=400');
    });

    shareEmail?.addEventListener('click', () => {
      window.location.href = `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(pageUrl)}`;
    });

    shareCopy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pageUrl);
        const tooltip = document.getElementById('share-copy-tooltip');
        if (tooltip) {
          tooltip.classList.add('share-tooltip--visible');
          setTimeout(() => {
            tooltip.classList.remove('share-tooltip--visible');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy link: ', err);
      }
    });
  }

  function runInit() {
    initTabs();
    initRFQForm();
    initSocialShare();
  }

  // Astro page-load support
  runInit();
  document.addEventListener('astro:page-load', runInit);
</script>
