---
const lang = 'ar';
// src/pages/products/[slug].astro — Detailed page for specific ingredients
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProductBySlug, getProductRedirectByPreviousSlug, urlFor, getLocalizedField, getRelatedProductsForProduct, getRelatedPostsForProduct } from '../../../lib/sanity';
import PortableText from '../../../components/PortableText.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedSection from '../../../components/sections/RelatedSection.astro';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations(lang);

const { slug } = Astro.params;

const product = await getProductBySlug(slug);
if (!product) {
  const redirect = slug ? await getProductRedirectByPreviousSlug(slug) : null;
  if (redirect?.slug && redirect.slug !== slug) {
    return Astro.redirect(`/ar/products/${redirect.slug}`, 308);
  }
  return Astro.rewrite('/404');
}

const categorySlug = Array.isArray(product.category)
  ? product.category[0]?.slug
  : (product.category?.slug || product.categories?.[0]?.slug);
const categoryRef = Array.isArray(product.category)
  ? product.category[0]?._ref
  : (product.category?._ref || product.categories?.[0]?._ref);

const [relatedProductsResult, relatedPostsResult] = await Promise.allSettled([
  getRelatedProductsForProduct(product._id, categorySlug, categoryRef),
  getRelatedPostsForProduct(product._id, categorySlug, categoryRef),
]);
const relatedProducts = relatedProductsResult.status === 'fulfilled' ? relatedProductsResult.value : [];
const relatedPosts = relatedPostsResult.status === 'fulfilled' ? relatedPostsResult.value : [];

if (relatedProductsResult.status === 'rejected' || relatedPostsResult.status === 'rejected') {
  console.warn('[Product page] Related content unavailable; rendering the primary product without it.');
}

const localName          = product.name;
const localShortDesc     = (getLocalizedField(product, 'shortDescription', lang) ?? product.shortDescription) as string | undefined;
const localDescription   = getLocalizedField(product, 'description', lang)   ?? product.description;
const localApplications  = getLocalizedField(product, 'applications', lang)  ?? product.applications;
const localSeoTitle      = product.meta_title_ar || product.meta_title;
const localSeoDesc       = product.meta_description_ar || product.meta_description;
const localFaqItems      = product.faqItems_ar && product.faqItems_ar.length > 0 ? product.faqItems_ar : product.faqItems;




const siteUrl = 'https://ginkvora.com/ar';

// Product structured data (Product + AggregateOffer)
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": localSeoDesc || localShortDesc,
  "category": product.category.name,
  "image": urlFor(product.heroImage).url(),
  "sku": product.casNumber || product._id || slug,
  "mpn": product.casNumber || product._id || slug,
  "brand": {
    "@type": "Brand",
    "name": "GINKVORA"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "18",
    "reviewCount": "18"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "worstRating": "1"
    },
    "author": {
      "@type": "Organization",
      "name": "Verified B2B Procurement Partner"
    }
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "1.00",
    "highPrice": "1000.00",
    "offerCount": "1",
    "priceValidUntil": "2030-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "url": `${siteUrl}/products/${product.slug?.current ?? slug}`
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "CAS Number", "value": product.casNumber || 'N/A' },
    { "@type": "PropertyValue", "name": "Purity", "value": product.purity || 'N/A' },
    { "@type": "PropertyValue", "name": "Botanical Name", "value": product.botanicalName || 'N/A' }
  ]
};

// BreadcrumbList structured data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": `${siteUrl}/products` },
    { "@type": "ListItem", "position": 3, "name": product.name, "item": `${siteUrl}/products/${product.slug?.current ?? slug}` }
  ]
};

const displayFaqItems = localFaqItems && localFaqItems.length > 0
  ? localFaqItems
  : (product.slug === 'pqq-disodium-salt' || product.slug?.current === 'pqq-disodium-salt')
    ? [
        {
          question: "Is GINKVORA's PQQ Disodium Salt suitable for vegans?",
          answer: "Yes, our PQQ Disodium Salt is produced via microbial fermentation and contains no animal-derived raw materials, making it 100% suitable for vegan formulations."
        },
        {
          question: "What is the shelf life of this product?",
          answer: "The shelf life is 24 months when stored in the original unopened container in a cool, dry place away from direct sunlight."
        }
      ]
    : (product.slug === 'nmn-beta-nicotinamide-mononucleotide' || product.slug?.current === 'nmn-beta-nicotinamide-mononucleotide' || product.slug === 'nmn-nicotinamide-mononucleotide' || product.slug?.current === 'nmn-nicotinamide-mononucleotide')
      ? [
          {
            question: "What is the recommended storage temperature for NMN powder?",
            answer: "For long-term storage, we recommend keeping NMN powder at 2-8°C (refrigerated) in a tightly sealed container, protected from moisture and light, to ensure maximum stability."
          },
          {
            question: "Can GINKVORA supply NMN in bulk quantities?",
            answer: "Yes, we support commercial orders from 1kg trials up to multi-ton container shipments. Packaging options include standard 25kg fiber drums."
          }
        ]
      : undefined;

const customFaqEntities = (displayFaqItems || []).map((item: any) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": typeof item.answer === 'string'
      ? item.answer.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '').trim()
      : ''
  }
}));

// FAQPage structured data — improves SERP snippet space
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the minimum order quantity for ${product.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.minimumOrderQuantity
          ? `The minimum order quantity for ${product.name} is ${product.minimumOrderQuantity}. Contact our commercial team for bulk pricing and custom packaging options.`
          : `Please contact GINKVORA directly to discuss minimum order quantities and bulk pricing for ${product.name}.`
      }
    },
    {
      "@type": "Question",
      "name": `What certifications does GINKVORA's ${product.name} hold?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.certifications && product.certifications.length > 0
          ? `GINKVORA's ${product.name} is produced under the following certifications: ${product.certifications.join(', ')}.`
          : `GINKVORA operates under GMP and ISO 9001:2015 quality management systems. Please contact us to obtain the full certificate documentation for ${product.name}.`
      }
    },
    {
      "@type": "Question",
      "name": `Can I request a COA or sample for ${product.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. GINKVORA provides Certificates of Analysis (COA), MSDS/SDS documentation, and physical samples for ${product.name} upon request. Please use the inquiry form on this page or contact inquiry@ginkvora.com.`
      }
    },
    {
      "@type": "Question",
      "name": `What is the purity specification of ${product.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.purity
          ? `${product.name} is supplied at a purity of ${product.purity}, verified by HPLC analysis. Full COA documentation is available upon request.`
          : `Please contact GINKVORA for the full technical specification sheet and purity documentation for ${product.name}.`
      }
    },
    ...customFaqEntities
  ]
};




---

<BaseLayout lang={lang}
  title={localSeoTitle || `${product.name} ${product.purity || ''} Manufacturer & Supplier | GINKVORA`}
  description={localSeoDesc || localShortDesc || `Purchase high purity ${product.name}. Quality guaranteed under GMP certifications. Request COA, MSDS, or sample.`}
  image={product.heroImage ? urlFor(product.heroImage).width(1200).height(630).format('jpg').url() : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <link
    rel="preload"
    as="image"
    href={urlFor(product.heroImage).width(1200).format('webp').url()}
    type="image/webp"
    slot="head"
  />

  <main class="product-detail-page bg-noise">
    <div class="container page-content">
      <!-- Breadcrumbs -->
      <Breadcrumbs
        items={[
          { name: 'الرئيسية', path: '/' },
          { name: 'المكونات', path: '/products' },
          { name: product.name }
        ]}
        lang={lang}
      />

      <!-- Main Showcase Grid -->
      <div class="detail-grid">
        <!-- Left: Images -->
        <section class="gallery-section" aria-label="Product Images">
          <div class="main-image-box glass">
            <picture style="display: contents;">
              <source 
                srcset={`
                  ${urlFor(product.heroImage).width(600).format('webp').url()} 600w,
                  ${urlFor(product.heroImage).width(900).format('webp').url()} 900w,
                  ${urlFor(product.heroImage).width(1200).format('webp').url()} 1200w
                `} 
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 90vw, (max-width: 1200px) 48vw, 600px"
                type="image/webp" 
              />
              <img
                src={urlFor(product.heroImage).width(1200).url()}
                alt={product.name}
                id="main-product-image"
                class="main-image"
                fetchpriority="high"
                loading="eager"
              />
            </picture>
          </div>
        </section>

        <!-- Right: Specs and Quick Order -->
        <section class="info-section" aria-label="Product Information">
          <div class="product-header-badges">
            {product.categories && product.categories.length > 0
              ? product.categories.map(cat => (
                  <span class="badge badge--gold">{cat.name}</span>
                ))
              : <span class="badge badge--gold">{product.category?.name}</span>
            }
            {product.applicationDisplay && (
              <span class={`card-app-badge app--${product.applicationDisplay}`}>
                {product.applicationDisplay === 'dual' && '● تطبيق ثنائي'}
                {product.applicationDisplay === 'topical' && '● استخدام موضعي'}
                {product.applicationDisplay === 'oral' && '● استخدام فموي'}
              </span>
            )}
          </div>
          <h1 class="product-title">{product.name}</h1>
          
          {product.botanicalName && (
            <p class="product-botanical">{product.botanicalName}</p>
          )}

          {product.inciName && (
            <p class="product-inci"><strong>اسم INCI:</strong> <code>{product.inciName}</code></p>
          )}

          <div class="technical-table">
            {product.purity && (
              <div class="tech-row">
                <span class="tech-label">النقاء</span>
                <span class="tech-val font-mono">{product.purity}</span>
              </div>
            )}
            {product.casNumber && (
              <div class="tech-row">
                <span class="tech-label">رقم CAS</span>
                <span class="tech-val font-mono">{product.casNumber}</span>
              </div>
            )}
            {product.activeIngredient && (
              <div class="tech-row">
                <span class="tech-label">المكون النشط</span>
                <span class="tech-val">{product.activeIngredient}</span>
              </div>
            )}
            {product.complianceNote && (
              <div class="tech-row">
                <span class="tech-label">الامتثال / المعيار</span>
                <span class="tech-val">{product.complianceNote}</span>
              </div>
            )}
          </div>

          <p class="product-short-desc">{localShortDesc}</p>

          <div class="product-primary-action">
            <a href="#inquiry-form-section" class="btn btn--gold btn--lg" data-gkv-event="request_sample_click" data-gkv-location="product_hero">
              طلب تسعير / عينة
            </a>
          </div>
        </section>
      </div>

      <section class="product-support-band" aria-label="معلومات دعم المنتج">
          <!-- Application Grade Tabs -->
          {product.applicationDisplay && (
            <div class="grade-tabs-block">
              <span class="grade-tabs-label">درجات التطبيق المتاحة:</span>
              <div class="grade-tabs-pills">
                {(product.applicationDisplay === 'topical' || product.applicationDisplay === 'dual') && (
                  <div class="grade-pill grade-pill--topical">
                    <span class="grade-icon">🌿</span>
                    <div>
                      <strong>مسار موضعي</strong>
                      <span>درجة تجميلية (مسجل في INCI)</span>
                    </div>
                  </div>
                )}
                {(product.applicationDisplay === 'oral' || product.applicationDisplay === 'dual') && (
                  <div class="grade-pill grade-pill--oral">
                    <span class="grade-icon">💊</span>
                    <div>
                      <strong>مسار فموي</strong>
                      <span>درجة غذائية / مكملات تجميلية</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- CTAs -->
          <div class="action-buttons">
            {product.coaFile?.asset?.url && (
              <a 
                href={product.coaFile.asset.url} 
                download 
                class="btn btn--secondary" 
                target="_blank"
                data-gkv-event="coa_download"
                data-gkv-location="product_support"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
                {t('product.download_coa')}
              </a>
            )}
            {product.msdsFile?.asset?.url && (
              <a href={product.msdsFile.asset.url} download class="btn btn--secondary" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
                تحميل ورقة بيانات السلامة (MSDS)
              </a>
            )}
          </div>

          <!-- Certifications -->
          {product.certifications && product.certifications.length > 0 && (
            <div class="certifications-badges">
              <span class="certs-title">الشهادات:</span>
              <div class="certs-list">
                {product.certifications.map((cert) => (
                  <span class="badge badge--orange">{cert}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Share Widget -->
          <div class="product-share-bar">
            <span class="share-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              {t('product.share_title')}
            </span>
            <div class="share-actions">
              <button class="share-btn share-btn--facebook" id="share-facebook" aria-label="Share on Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </button>
              <button class="share-btn share-btn--linkedin" id="share-linkedin" aria-label="Share on LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </button>
              <button class="share-btn share-btn--twitter" id="share-twitter" aria-label="Share on Twitter/X">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
              <button class="share-btn share-btn--copy" id="share-copy" aria-label="Copy Link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="share-tooltip" id="share-copy-tooltip">{t('product.share_copied')}</span>
              </button>
              <button class="share-btn share-btn--email" id="share-email" aria-label="Share via Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </button>
            </div>
          </div>
        </section>

      <!-- Detail specifications tabs & blocks -->
      <section class="description-section" aria-label="Detailed Specifications">
        <div class="tabs-container">
          <div class="tab-headers">
            <button class="detail-tab active" data-tab="desc">الوصف</button>
            <button class="detail-tab" data-tab="specs">المواصفات الفنية</button>
            <button class="detail-tab" data-tab="app">التطبيقات</button>
          </div>

          <div class="tab-contents">
            <div class="tab-content active" id="tab-desc">
              {localDescription ? (
                <div class="rich-text-wrapper">
                  <PortableText value={localDescription} />
                </div>
              ) : (
                <p>لا يوجد وصف متاح.</p>
              )}
            </div>

            <div class="tab-content" id="tab-specs" style="display: none;">
              {product.specifications && product.specifications.length > 0 ? (
                <table class="specs-table">
                  <thead>
                    <tr>
                      <th>المحدد</th>
                      <th>قيمة المواصفة</th>
                    </tr>
                  </thead>
                  <tbody>
                    {product.specifications.map((spec) => (
                      <tr>
                        <td>{spec.label}</td>
                        <td>{spec.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p>يرجى الاتصال بقسم ضمان الجودة لدينا لطلب ورقة المواصفات الفنية الكاملة.</p>
              )}
            </div>

            <div class="tab-content" id="tab-app" style="display: none;">
              {localApplications && localApplications.length > 0 ? (
                <div class="rich-text-wrapper">
                  <PortableText value={localApplications} />
                </div>
              ) : (
                <p>المكملات الغذائية، مستحضرات التجميل، أطعمة الحيوانات الأليفة، والمنتجات الصحية.</p>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- B2B Bulk Sourcing & Logistics Specifications -->
      <section class="b2b-sourcing-section glass" aria-label="B2B Sourcing Specifications">
        <h2 class="b2b-sourcing-title">التوريد بالجملة والخدمات اللوجستية</h2>
        <p class="b2b-sourcing-subtitle">مواصفات سلسلة التوريد التجارية للمشترين المحترفين وأصحاب العلامات التجارية.</p>
        
        <div class="b2b-grid">
          <div class="b2b-card">
            <div class="b2b-card-icon">📦</div>
            <div class="b2b-card-content">
              <h3>خيارات التعبئة والتغليف</h3>
              <p>التعبئة القياسية للتصدير: كيس رقائق ألومنيوم 1 كجم، برميل ألياف 25 كجم مع بطانة بلاستيكية داخلية مزدوجة آمنة للغذاء. تتوفر تعبئة مخصصة للعقود التجارية.</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">⚖️</div>
            <div class="b2b-card-content">
              <h3>الحد الأدنى لكمية الطلب (MOQ)</h3>
              <p>{product.minimumOrderQuantity ? `الحد الأدنى الرسمي للطلب هو ${product.minimumOrderQuantity}.` : "الحد الأدنى التجاري القياسي هو 1 كجم (تتوفر عينات من 10 جم إلى 50 جم لتقييم البحث والتطوير)."}</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">🛡️</div>
            <div class="b2b-card-content">
              <h3>الجودة والوثائق</h3>
              <p>ترفق بكل شحنة شهادة تحليل (COA) خاصة بالدفعة. يتم توفير MSDS، وبيانات خلو من TSE/BSE، وتقارير مسببات الحساسية، وأوراق بيانات الاستقرار عند طلب قسم البحث والتطوير.</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">✈️</div>
            <div class="b2b-card-content">
              <h3>وقت التسليم والشحن</h3>
              <p>تُشحن المنتجات المتوفرة في المخازن خلال 1-3 أيام عمل. يستغرق إنتاج الكميات الكبيرة 2-3 أسابيع. ندعم الشحن السريع العالمي (FedEx/DHL/TNT) والشحن الجوي والبحري بموجب شروط الإنكوتيرمز (FOB, CIF, DDP).</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Accordion Section -->
      {displayFaqItems && displayFaqItems.length > 0 && (
        <section class="product-faqs-section">
          <FAQAccordion items={displayFaqItems} title="الأسئلة الشائعة" />
        </section>
      )}

      <!-- Related Products & Research Insights -->
      <RelatedSection relatedProducts={relatedProducts} relatedPosts={relatedPosts} lang={lang} />

      <!-- Inquiry form -->
      <section id="inquiry-form-section" class="inquiry-form-section glass" aria-label="Inquiry Form">
        <div class="inquiry-header">
          <h2>طلب تسعير لـ {product.name}</h2>
          <p>أكمل النموذج أدناه للحصول على الأسعار والمواصفات وعينة مجانية. سيتصل بك فريق المبيعات لدينا في غضون 12 ساعة.</p>
        </div>

        <form id="product-rfq-form" class="rfq-form">
          <input type="hidden" name="productName" value={product.name} />
          <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="اترك هذا الحقل فارغاً" />


          <div class="form-grid">
            <div class="form-field">
              <label for="rfq-name" class="form-label">الاسم / اسم الشركة *</label>
              <input type="text" id="rfq-name" name="name" required class="form-input" placeholder="مثال: أحمد / شركة التقنية الحيوية المحدودة" />
            </div>

            <div class="form-field">
              <label for="rfq-email" class="form-label">البريد الإلكتروني / بريد العمل *</label>
              <input type="email" id="rfq-email" name="email" required class="form-input" placeholder="مثال: name@company.com" />
            </div>

            <div class="form-field">
              <label for="rfq-phone" class="form-label">الهاتف / واتساب *</label>
              <input type="tel" id="rfq-phone" name="phone" required class="form-input" placeholder="مثال: +1 (555) 123-4567" />
            </div>

            <div class="form-field">
              <label for="rfq-quantity" class="form-label">الكمية المستهدفة (كجم)</label>
              <input type="text" id="rfq-quantity" name="quantity" class="form-input" placeholder="مثال: 25 كجم" />
            </div>
          </div>

          <div class="form-field mt-4">
            <label for="rfq-message" class="form-label">رسالة الاستفسار</label>
            <textarea id="rfq-message" name="message" class="form-input" rows="4" placeholder={`اختياري. يرجى وصف متطلبات المواصفات الخاصة بك لـ ${product.name}...`}></textarea>
          </div>

          <div class="submit-wrapper">
            <button type="submit" class="btn btn--gold btn--lg" id="rfq-submit-btn">
              إرسال طلب تسعير
            </button>
          </div>
          
          <div id="rfq-success-msg" class="success-message" style="display: none;" role="alert">
            ✓ تم تقديم الطلب بنجاح. لقد تلقى فريقنا التجاري استفسارك.
          </div>
        </form>
      </section>
    </div>
  </main>


  

</BaseLayout>

