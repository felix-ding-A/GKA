---
// src/pages/about.astro — Premium B2B About page
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllAuthors, urlFor, getLocalizedField } from '../lib/sanity';

const lang = 'en';

const authors = await getAllAuthors();

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About GINKVORA",
  "description": "Learn about GINKVORA's history, high-purity extraction technologies, and raw material sourcing standards.",
  "url": "https://ginkvora.com/about",
  "mainEntity": authors.map(author => ({
    "@type": "Person",
    "name": getLocalizedField(author, 'name', lang) || author.name,
    "jobTitle": getLocalizedField(author, 'title', lang) || author.title || undefined,
    "description": getLocalizedField(author, 'bio', lang) || author.bio || undefined,
    "image": author.avatar ? urlFor(author.avatar).url() : undefined
  }))
};
---

<BaseLayout
  title="Botanical & Bioactive Ingredient Supplier | About GINKVORA"
  description="GINKVORA supplies high-purity botanical and bioactive ingredients for formulators and B2B brands. Learn about our history and extraction technologies."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} slot="head" />
  <main class="about-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">Our Company</span>
        <h1 class="banner-title fade-in-up delay-1">Botanical Expertise. Bioactive Ingredient Supply.</h1>
        <p class="banner-desc fade-in-up delay-2">
          Botanical extracts, cosmetic actives, peptides, and functional ingredients — with OEM customization for skincare, nutrition, and wellness applications.
        </p>
      </div>
    </header>

    <!-- Company Intro -->
    <section class="container section intro-section" aria-label="Company Overview">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>About GINKVORA</h2>
          <p>GINKVORA supplies botanical extracts, cosmetic actives, peptides, and functional ingredients for skincare, nutrition, and wellness applications, alongside OEM customization services.</p>
          <p>We serve distributors, resellers, formulators, and manufacturers worldwide. We also supply cosmetic raw materials to beauty salons and provide OEM-customized products for health management organizations.</p>
          <p>Based in Xi'an, China, we coordinate ingredient sourcing, specification alignment, documentation, and international delivery. Our focus is straightforward: helping customers source suitable ingredients and develop customized products with clear requirements, practical support, and a direct point of contact.</p>
          <div class="mission-box">
            <span class="mission-title">Our Core Mission</span>
            <blockquote class="mission-text">
              "To empower human health brands by delivering absolute active constituent purity, verifiable quality control records, and reliable bulk supply solutions."
            </blockquote>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2">
          <div class="image-showcase glass">
            <img
              src="/images/ginkvora-rd-analytical-laboratory.webp"
              alt="GINKVORA Lab R&D Facility"
              class="showcase-img"
              width="800"
              height="600"
            />
            <div class="floating-caption">
              <strong>Xi'an R&D Center</strong>
              <span>HPLC & Mass Spectrometry Testing</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Information -->
    <section class="container section company-section" aria-labelledby="company-information">
      <div class="company-grid">
        <div class="reveal">
          <span class="section-label">Company Details</span>
          <h2 id="company-information">Company Information</h2>
        </div>
        <dl class="company-card glass reveal">
          <div><dt>Legal Company Name</dt><dd>Shaanxi Ginkvora Biotechnology Co., Ltd.</dd></div>
          <div><dt>D-U-N-S® Number</dt><dd>975262249</dd></div>
          <div><dt>Registered Address</dt><dd><address>Room 502, Unit 1, Building 16,<br />CR Land Future City Chenxi, Gangfeng Road,<br />International Trade &amp; Logistics Park,<br />Xi'an, Shaanxi, China</address></dd></div>
          <div><dt>Business Email</dt><dd><a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- Managed Sourcing Stages -->
    <section class="section values-section bg-deep" aria-labelledby="how-we-work">
      <div class="container">
        <div class="section-header">
          <span class="section-label">How We Work</span>
          <h2 class="section-title" id="how-we-work">One point of contact. Four managed stages.</h2>
          <p class="section-desc">When you source from GINKVORA, you work with a single point of contact who coordinates sourcing, documentation, batch verification, and delivery.</p>
        </div>
        <div class="stages-grid">
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">01</div>
            <h3>Supplier Qualification & Specifications</h3><p>We assess upstream producers and confirm the ingredient grade, specifications, and order requirements before purchase.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">02</div>
            <h3>Batch Documentation</h3><p>We coordinate the batch-specific COA and relevant supporting documents, including MSDS, TDS, and available test reports, according to the product and your documentation requirements.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">03</div>
            <h3>Quality Verification</h3><p>We review batch results against the agreed specifications before dispatch. Depending on the ingredient, these may include HPLC purity and assay, heavy metals, residual solvents, and microbiological limits. Additional testing requirements are agreed before order confirmation.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">04</div>
            <h3>Packaging & Delivery</h3><p>We arrange express, air, or sea freight under agreed Incoterms and confirm packaging requirements and dispatch timelines with you. Nitrogen-flushed packaging can be arranged for suitable sensitive actives.</p>
          </article>
        </div>
        <p class="process-note">Throughout the process, you have a direct contact for specifications, documentation, and delivery updates.</p>
      </div>
    </section>

    <!-- Authors Section -->
    <section class="container section authors-section" aria-label="Our Advisors and Technical Collaborators">
      <div class="section-header">
        <span class="section-label">Expertise & Collaboration</span>
        <h2>Our Advisors & Technical Collaborators</h2>
        <p class="section-desc">
          Meet the independent professionals who collaborate with GINKVORA across scientific, formulation, regulatory, and commercial projects.
        </p>
      </div>

      <div class="authors-grid">
        {authors.map((author) => (
          <div class="author-card glass reveal">
            <div class="author-avatar-wrapper">
              <img
                src={urlFor(author.avatar).width(160).height(160).fit('crop').url()}
                alt={author.name}
                class="author-avatar"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="author-info">
              <h3>{getLocalizedField(author, 'name', lang) || author.name}</h3>
              {(getLocalizedField(author, 'title', lang) || author.title) && <p class="author-title">{getLocalizedField(author, 'title', lang) || author.title}</p>}
              {(getLocalizedField(author, 'credentials', lang) || author.credentials) && <span class="author-creds">{getLocalizedField(author, 'credentials', lang) || author.credentials}</span>}
              {(getLocalizedField(author, 'bio', lang) || author.bio) && <p class="author-bio">{getLocalizedField(author, 'bio', lang) || author.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline/History Section -->
    <section class="container section history-section" aria-label="Our History">
      <div class="section-header">
        <span class="section-label">Our Journey</span>
        <h2>Growth & Milestones</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-badge">2023</div>
          <div class="timeline-content glass">
            <h3>Establishment & Initial R&D</h3>
            <p>GINKVORA founded in Xi'an, specializing in mitochondrial cofactor research and launching high-purity PQQ and NMN sourcing channels.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-1">
          <div class="timeline-badge">2024</div>
          <div class="timeline-content glass">
            <h3>GMP & ISO Certification</h3>
            <p>Completed construction of our partner extraction plant. Attained GMP, ISO 9001:2015, Halal, and Kosher certifications for global food compliance.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-2">
          <div class="timeline-badge">2025</div>
          <div class="timeline-content glass">
            <h3>Cosmetic & Pet Line Launch</h3>
            <p>Expanded our chemical catalog to include Glabridin whitening actives, natural flavonoids, and specialized nutritional ingredients for the pet wellness sector.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-3">
          <div class="timeline-badge">2026</div>
          <div class="timeline-content glass">
            <h3>Global Logistics & Digital Platform Launch</h3>
            <p>Launched high-performance international supply network serving supplement, skincare, and sports brands in 50+ countries with optimized logistics hubs.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Partnership CTA -->
    <section class="container section cta-section" aria-label="Partnership inquiry">
      <div class="cta-box glass">
        <h2>Ready to Partner?</h2>
        <p>Contact our commercial team for pricing, technical documentation, and product samples.</p>
        <div class="cta-btns">
          <a href="/contact" class="btn btn--gold btn--lg">Contact Us</a>
          <a href="/products" class="btn btn--primary btn--lg">Browse Products</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .company-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .company-grid h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-top: 0.5rem; }
  .company-card { margin: 0; padding: 2rem; border-radius: var(--radius-lg); min-width: 0; }
  .company-card > div { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .company-card > div:first-child { padding-top: 0; }
  .company-card > div:last-child { padding-bottom: 0; border-bottom: 0; }
  .company-card dt { color: var(--color-primary-light); font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem; }
  .company-card dd { margin: 0; color: var(--color-text); line-height: 1.75; overflow-wrap: anywhere; }
  .company-card address { font-style: normal; }
  .company-card a:hover { text-decoration: underline; }
  .stages-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .stages-grid .value-card { text-align: left; }
  .stages-grid .value-icon { color: var(--color-primary-light); font-family: var(--font-mono); font-size: 1.5rem; }
  .process-note { text-align: center; max-width: 760px; margin: 2rem auto 0; color: var(--color-text-secondary); }
  @media (max-width: 768px) {
    .company-grid, .stages-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .company-card { padding: 1.5rem; }
  }

  .about-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 7rem 3.5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  .mission-box {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .mission-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .mission-text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.6;
  }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
    cursor: pointer;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 400ms) ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.05);
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Values Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212,166,84,0.1) !important;
    text-align: center;
    transition: all var(--transition-base, 250ms) ease;
  }

  .value-card:hover {
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-6px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 3rem auto 0;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-badge {
    position: absolute;
    left: calc(-2rem - 13px);
    top: 0.5rem;
    width: 26px;
    height: 26px;
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-primary-light);
    box-shadow: 0 0 10px rgba(212,166,84,0.3);
  }

  .timeline-content {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border-color: rgba(212,166,84,0.12) !important;
    transition: all var(--transition-base, 250ms) ease;
  }

  .timeline-content:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-gold);
  }

  .timeline-content h3 {
    font-size: 1.125rem;
    color: var(--color-primary-light);
    margin-bottom: 0.25rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Authors Section ── */
  .authors-section {
    margin-top: 2rem;
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .authors-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .author-card {
    display: flex;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    align-items: center;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (max-width: 540px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
    }
  }

  .author-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow-gold);
  }

  .author-avatar-wrapper {
    flex-shrink: 0;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary-light);
    box-shadow: 0 0 15px rgba(212, 166, 84, 0.15);
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base, 250ms) ease;
  }

  .author-card:hover .author-avatar {
    transform: scale(1.08);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-info h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .author-title {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    font-weight: 500;
  }

  .author-creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: rgba(212, 166, 84, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    align-self: start;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 540px) {
    .author-creds {
      align-self: center;
    }
  }

  .author-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }

  .cta-box { padding: 3.5rem; border-radius: var(--radius-xl); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; border: 1px solid rgba(212, 166, 84, 0.2) !important; }
  .cta-box h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-family: var(--font-display); }
  .cta-box p { color: var(--color-text-secondary); max-width: 520px; line-height: 1.75; }
  .cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
</style>
