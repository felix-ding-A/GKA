---
// src/pages/ru/insights/[slug].astro — Russian blog post detail page (ISR / Edge SSR)
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostBySlug, getPostRedirectByPreviousSlug, urlFor, getLocalizedField } from '../../../lib/sanity';
import PortableText from '../../../components/PortableText.astro';
import { useTranslations, getLocalePath } from '../../../i18n/utils';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TagBadge from '../../../components/TagBadge.astro';

const lang = 'ru';
const t = useTranslations(lang);
const lp = (path: string) => getLocalePath(lang, path);

const { slug } = Astro.params;

const post = await getPostBySlug(slug);

if (!post) {
  const redirect = slug ? await getPostRedirectByPreviousSlug(slug) : null;
  if (redirect?.slug && redirect.slug !== slug) {
    return Astro.redirect(`/ru/insights/${redirect.slug}`, 308);
  }
  return Astro.rewrite('/404');
}

const relatedPosts = post.relatedPosts || [];
const finalRelatedPosts = relatedPosts.length >= 2
  ? relatedPosts
  : (post.recentPosts || []);

const siteUrl = 'https://ginkvora.com';

// Localized fields — fall back to English if no Russian available
const localTitle      = (getLocalizedField(post, 'title', lang)         ?? post.title)         as string;
const localExcerpt    = (getLocalizedField(post, 'excerpt', lang)        ?? post.excerpt)        as string | undefined;
const localBody       = getLocalizedField(post, 'body', lang)            ?? post.body;
const localSeoTitle   = (getLocalizedField(post, 'meta_title', lang)       ?? post.meta_title)       as string | undefined;
const localSeoDesc    = (getLocalizedField(post, 'meta_description', lang) ?? post.meta_description) as string | undefined;
const localRelatedShort = post.relatedProduct
  ? ((getLocalizedField(post.relatedProduct, 'shortDescription', lang) ?? post.relatedProduct.shortDescription) as string | undefined)
  : undefined;

const pageTitle       = localSeoTitle  || `${localTitle} | GINKVORA`;
const pageDescription = localSeoDesc   || localExcerpt;

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": localTitle,
  "description": pageDescription,
  "image": urlFor(post.coverImage).url(),
  "datePublished": post.publishedAt || new Date().toISOString(),
  "dateModified": post.updatedAt || post.publishedAt || new Date().toISOString(),
  "url": `${siteUrl}/ru/insights/${slug}`,
  "inLanguage": "ru-RU",
  "author": {
    "@type": post.author ? "Person" : "Organization",
    "name": post.author?.name || "GINKVORA",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "GINKVORA",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/images/logo.svg` }
  },
};

// FAQ fallback for display and verification
const displayFaqItems = post.faqItems_ru && post.faqItems_ru.length > 0
  ? post.faqItems_ru
  : post.faqItems && post.faqItems.length > 0
    ? post.faqItems
    : [
        {
          question: "Какова научная база ингредиентов GINKVORA?",
          answer: "Наши ингредиенты проходят строгую научную валидацию, включая жидкостную хроматографию высокого разрешения (ВЭЖХ) и обзоры клинических исследований, для обеспечения безопасности и эффективности."
        },
        {
          question: "Как GINKVORA обеспечивает соответствие нормативным требованиям?",
          answer: "Мы тесно сотрудничаем с мировыми регулирующими органами и поддерживаем полную документацию, включая сертификаты анализа (COA), паспорта безопасности (MSDS) и сертификаты соответствия GMP."
        }
      ];

// FAQ Schema if faqItems exist
const faqSchema = displayFaqItems && displayFaqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": displayFaqItems.map((item: any) => {
    // Strip any HTML <script> tags or other HTML tags to prevent schema syntax breakage
    const cleanAnswer = typeof item.answer === 'string'
      ? item.answer.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '').trim()
      : '';
    return {
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": cleanAnswer
      }
    };
  })
} : null;

---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  image={post.mainImage ? urlFor(post.mainImage).width(1200).height(630).format('jpg').url() : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head" />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}
  <link
    rel="preload"
    as="image"
    href={urlFor(post.coverImage).width(1200).format('webp').url()}
    imagesrcset={`${urlFor(post.coverImage).width(600).format('webp').url()} 600w, ${urlFor(post.coverImage).width(900).format('webp').url()} 900w, ${urlFor(post.coverImage).width(1200).format('webp').url()} 1200w`}
    imagesizes="(max-width: 600px) 100vw, (max-width: 900px) 90vw, 1200px"
    type="image/webp"
    slot="head"
  />

  <main class="insight-detail bg-noise">
    <div class="container article-layout-wrapper">
      <!-- Left Sidebar: TOC & Share -->
      <aside class="article-sidebar article-sidebar--left" aria-label="Навигация по статье">
        <div class="sidebar-sticky">
          <!-- Table of Contents -->
          <div class="sidebar-widget widget-toc glass">
            <h4 class="widget-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              {t('insights.toc_title')}
            </h4>
            <nav id="dynamic-toc" class="toc-nav">
              <!-- JS-generated list -->
            </nav>
          </div>
          
          <!-- Share Widget -->
          <div class="sidebar-widget widget-share glass">
            <h4 class="widget-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              {t('insights.share_title')}
            </h4>
            <div class="share-actions">
              <button class="share-btn share-btn--facebook" id="share-facebook" aria-label="Поделиться в Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </button>
              <button class="share-btn share-btn--linkedin" id="share-linkedin" aria-label="Share on LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </button>
              <button class="share-btn share-btn--twitter" id="share-twitter" aria-label="Share on Twitter/X">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
              <button class="share-btn share-btn--copy" id="share-copy" aria-label="Copy Link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="share-tooltip" id="share-copy-tooltip">{t('insights.share_copied')}</span>
              </button>
              <button class="share-btn share-btn--email" id="share-email" aria-label="Share via Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </button>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Article Container -->
      <div class="article-container">
        <!-- Breadcrumbs & Divider -->
        <div class="article-breadcrumbs-wrap">
            <Breadcrumbs
              items={[
                { name: 'Главная', path: '/' },
                { name: 'Блог', path: '/insights' },
                { name: localTitle || post.title }
              ]}
            lang={lang}
          />
          <hr class="breadcrumbs-divider" />
        </div>

        <!-- Article Header -->
        <header class="article-header">
          <h1 class="article-title">{localTitle}</h1>

          <div class="article-meta">
            <time datetime={post.publishedAt}>
              {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('ru-RU', {
                year: 'numeric', month: 'long', day: 'numeric'
              }) : ''}
            </time>
            {post.readTime && (
              <>
                <span class="meta-dot">·</span>
                <span>{post.readTime} {t('insights.min_read')}</span>
              </>
            )}
            {post.author && (
              <>
                <span class="meta-dot">·</span>
                <span>{t('insights.by_author')} {getLocalizedField(post.author, 'name', lang) || post.author.name}{(getLocalizedField(post.author, 'credentials', lang) || post.author.credentials) ? `, ${getLocalizedField(post.author, 'credentials', lang) || post.author.credentials}` : ''}</span>
              </>
            )}
          </div>

          {post.tags && post.tags.length > 0 && (
            <div class="article-tags">
              {post.tags.map((tag: string) => (
                <TagBadge tag={tag} lang={lang} />
              ))}
            </div>
          )}
        </header>

        <!-- Cover Image -->
        <div class="article-cover glass">
          <picture style="display: contents;">
            <source
              srcset={`
                ${urlFor(post.coverImage).width(600).format('webp').url()} 600w,
                ${urlFor(post.coverImage).width(900).format('webp').url()} 900w,
                ${urlFor(post.coverImage).width(1200).format('webp').url()} 1200w
              `}
              sizes="(max-width: 600px) 100vw, (max-width: 900px) 90vw, 1200px"
              type="image/webp"
            />
            <img
              src={urlFor(post.coverImage).width(1200).url()}
              alt={localTitle}
              class="cover-img"
              fetchpriority="high"
              loading="eager"
            />
          </picture>
        </div>

        <!-- Article Body -->
        <article class="article-body">
          {localBody ? (
            <PortableText value={localBody} />
          ) : (
            <p>{localExcerpt}</p>
          )}
        </article>

        <!-- Related Product Callout -->
        {post.relatedProduct && (
          <section class="related-product-callout glass" aria-label="Связанный продукт">
            <div class="related-product-header">
              <span class="purity-badge">Связанный ингредиент</span>
            </div>
            <div class="related-product-body">
              <div class="related-product-info">
                <h3 class="related-product-name">
                  {post.relatedProduct.name}
                  {post.relatedProduct.purity && <span class="purity-badge" style="margin-left: 0.5rem;">{post.relatedProduct.purity}</span>}
                </h3>
                <p class="related-product-desc">{localRelatedShort}</p>
              </div>
              <a href={`/ru/products/${post.relatedProduct.slug}`} class="btn btn--gold btn--sm">
                Характеристики и запрос COA →
              </a>
            </div>
          </section>
        )}

        <!-- FAQ Accordion -->
        {displayFaqItems && displayFaqItems.length > 0 && (
          <section class="article-faqs glass">
            <FAQAccordion items={displayFaqItems} title="Часто задаваемые вопросы" />
          </section>
        )}

        <!-- Bottom CTA -->
        <section class="post-cta glass" aria-label="Запросить КП">
          <div class="cta-content">
            <h3>{t('common.contact_cta')}</h3>
            <p>{t('common.contact_cta_sub')}</p>
          </div>
          <a href="/ru/contact" class="btn btn--gold">
            {t('common.contact_cta_btn')}
          </a>
        </section>

        <!-- Related Articles Section -->
        {finalRelatedPosts && finalRelatedPosts.length > 0 && (
          <section class="related-posts-section" aria-label="Related Articles">
            <h3 class="related-posts-title">Похожие статьи</h3>
            <div class="related-posts-grid">
              {finalRelatedPosts.map((rp: any) => {
                const rpTitle = getLocalizedField(rp, 'title', lang) || rp.title;
                const rpExcerpt = getLocalizedField(rp, 'excerpt', lang) || rp.excerpt;
                return (
                  <a href={`/ru/insights/${rp.slug}`} class="related-post-card glass">
                    {rp.coverImage && (
                      <div class="related-post-img-wrap">
                        <img src={urlFor(rp.coverImage).width(400).url()} alt={rpTitle} class="related-post-img" loading="lazy" />
                      </div>
                    )}
                    <div class="related-post-content">
                      <span class="related-post-date">
                        {rp.publishedAt ? new Date(rp.publishedAt).toLocaleDateString('ru-RU', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        }) : ''}
                      </span>
                      <h4 class="related-post-card-title">{rpTitle}</h4>
                      <p class="related-post-excerpt">{rpExcerpt}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )}
      </div>

      <!-- Right Sidebar: Quick Inquiry & Related Product -->
      <aside class="article-sidebar article-sidebar--right" aria-label="Действия по статье">
        <div class="sidebar-sticky">
          <!-- B2B Quick Inquiry Form Widget -->
          <div class="sidebar-widget widget-inquiry glass">
            <h4 class="widget-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              {t('insights.inquiry_title')}
            </h4>
            <p class="widget-subtitle">{t('insights.inquiry_subtitle')}</p>
            
            <form class="sidebar-form" id="sidebar-inquiry-form" novalidate>
              <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />
              <div class="form-field">
                <label for="sb-name" class="form-label">{t('cta.form_name')}</label>
                <input type="text" id="sb-name" name="name" class="form-input" placeholder="Имя / Компания" required autocomplete="name" />
              </div>
              <div class="form-field">
                <label for="sb-phone" class="form-label">{t('cta.form_phone')}</label>
                <input type="tel" id="sb-phone" name="phone" class="form-input" placeholder="+7 (999) 123-45-67" required autocomplete="tel" />
              </div>
              <div class="form-field">
                <label for="sb-email" class="form-label">{t('cta.form_email')}</label>
                <input type="email" id="sb-email" name="email" class="form-input" placeholder="email@company.ru" required autocomplete="email" />
              </div>
              
              <!-- Hidden interest category default to "insights" or corresponding related product -->
              <input type="hidden" name="interest" value={post.relatedProduct ? post.relatedProduct.name : "insights"} />
              
              <button type="submit" class="btn btn--primary btn--sm" style="width: 100%; justify-content: center; margin-top: 0.5rem;" id="sb-form-submit">
                {t('insights.inquiry_submit')}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              </button>
            </form>
          </div>

          <!-- Related Product Widget -->
          {post.relatedProduct ? (
            <div class="sidebar-widget widget-related-product glass">
              <h4 class="widget-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                {t('hero.featured')}
              </h4>
              <div class="sb-product-card">
                <span class="purity-badge">{post.relatedProduct.purity || 'Высокая чистота'}</span>
                <h5 class="sb-product-name">{post.relatedProduct.name}</h5>
                <p class="sb-product-desc">{localRelatedShort}</p>
                <a href={lp(`/products/${post.relatedProduct.slug}`)} class="btn btn--gold btn--sm" style="width: 100%; justify-content: center; margin-top: 0.5rem;">
                  {t('products.view_details')}
                </a>
              </div>
            </div>
          ) : (
            <div class="sidebar-widget widget-certifications glass">
              <h4 class="widget-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {t('insights.trust_title')}
              </h4>
              <div class="sb-certs-list">
                <div class="sb-cert-item">
                  <span class="cert-dot"></span>
                  <span>GMP Сертифицированное производство</span>
                </div>
                <div class="sb-cert-item">
                  <span class="cert-dot"></span>
                  <span>Стандарты ISO 9001:2015</span>
                </div>
                <div class="sb-cert-item">
                  <span class="cert-dot"></span>
                  <span>Халяль и Кошер аудит</span>
                </div>
                <div class="sb-cert-item">
                  <span class="cert-dot"></span>
                  <span>100% независимые лабораторные тесты</span>
                </div>
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .insight-detail { padding-block: 7rem var(--space-4xl); }
  .article-container {
    flex: 1;
    max-width: 800px;
    min-width: 0;
  }

  /* ── Breadcrumbs Divider & Article Header ── */
  .article-breadcrumbs-wrap {
    margin-bottom: 1.5rem;
  }

  .breadcrumbs-divider {
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 0.875rem;
    margin-bottom: 0;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .meta-dot {
    color: var(--color-primary-light);
  }

  /* ── Related Posts Section ── */
  .related-posts-section {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .related-posts-title {
    font-size: 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .related-posts-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .related-post-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(22, 24, 26, 0.35);
    transition: all var(--transition-base);
    text-decoration: none;
    height: 100%;
  }

  .related-post-card:hover {
    border-color: rgba(212, 166, 84, 0.3);
    background: rgba(212, 166, 84, 0.02);
    transform: translateY(-3px);
  }

  .related-post-img-wrap {
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .related-post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .related-post-card:hover .related-post-img {
    transform: scale(1.05);
  }

  .related-post-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .related-post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .related-post-card-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-post-excerpt {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0;
  }

  /* ── Sidebar Layout ── */
  .article-layout-wrapper {
    display: flex;
    justify-content: center;
    gap: 3rem;
    position: relative;
    max-width: 1360px;
    margin-inline: auto;
  }

  .article-sidebar {
    width: 240px;
    flex-shrink: 0;
    display: none; /* Hidden on mobile/tablet */
  }

  .sidebar-sticky {
    position: sticky;
