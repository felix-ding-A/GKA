    background: rgba(30, 33, 36, 0.6);
  }

  /* Product widget */
  .sb-product-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sb-product-name {
    font-size: 1.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
  }

  .sb-product-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Certifications list */
  .sb-certs-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-cert-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .cert-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .breadcrumbs { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 2.5rem; max-width: 800px; margin-inline: auto; }
  .crumb-separator { color: var(--color-text-muted); }
  .crumb-active { color: var(--color-primary-light); font-weight: 500; }

  .article-header { text-align: center; margin-bottom: 3rem; max-width: 800px; margin-inline: auto; }
  .article-meta { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .meta-dot { margin-inline: 0.5rem; }
  .article-title { font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 700; line-height: 1.15; margin-bottom: 1.25rem; color: var(--color-text); }
  .article-tags { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }

  .article-cover { width: 100%; aspect-ratio: 16/9; overflow: hidden; margin-bottom: 3.5rem; border-color: rgba(212,166,84,0.15) !important; }
  .cover-img { width: 100%; height: 100%; object-fit: cover; }

  .article-body { font-size: 1.0625rem; line-height: 1.85; color: var(--color-text-secondary); }
  
  /* Keep text-based elements readable and centered at 800px */
  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4),
  .article-body :global(blockquote) {
    max-width: 800px;
    margin-inline: auto;
  }

  .article-body :global(p) { margin-bottom: 1.5rem; }
  .article-body :global(h2), .article-body :global(h3) { color: var(--color-text); margin-block: 2.5rem 1rem; font-family: var(--font-display); font-weight: 600; scroll-margin-top: 8rem; }
  .article-body :global(h2) { font-size: 1.75rem; }
  .article-body :global(h3) { font-size: 1.375rem; }
  .article-body :global(ul) { margin-bottom: 1.5rem; padding-left: 1.5rem; list-style: disc; }
  .article-body :global(li) { margin-bottom: 0.5rem; }

  .post-cta { margin-top: 4.5rem; padding: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-radius: var(--radius-lg); border-color: rgba(212,166,84,0.2) !important; }
  @media (max-width: 640px) { .post-cta { flex-direction: column; text-align: center; gap: 1.25rem; } }
  .cta-content h3 { font-size: 1.375rem; color: var(--color-primary-light); margin-bottom: 0.25rem; }
  .cta-content p { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; }
  .post-cta .btn { flex-shrink: 0; }

  .related-product-callout { margin-top: 4rem; padding: 2rem; border-radius: var(--radius-lg); border: 1px solid rgba(212,166,84,0.15) !important; }
  .related-product-header { margin-bottom: 1rem; }
  .related-product-body { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  @media (max-width: 640px) { .related-product-body { flex-direction: column; align-items: flex-start; gap: 1.25rem; } }
  .related-product-info { flex: 1; }
  .related-product-name { font-size: 1.5rem; font-family: var(--font-display); font-weight: 600; color: var(--color-text); margin-bottom: 0.5rem; display: inline-flex; align-items: center; gap: 0.75rem; }
  .purity-badge { display: inline-block; font-size: 0.75rem; font-family: var(--font-mono); color: var(--color-primary-light); border: 1px solid rgba(212,166,84,0.3); padding: 0.125rem 0.5rem; border-radius: 9999px; margin-bottom: 0.5rem; }
  .related-product-desc { font-size: 0.9375rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 0; }

  /* ── FAQs ── */
  .article-faqs {
    margin-top: 4rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
  }
</style>

<script>
  // ── Dynamic Table of Contents Generator ──
  document.addEventListener('DOMContentLoaded', () => {
    const headings = document.querySelectorAll('.article-body h2, .article-body h3');
    const tocContainer = document.getElementById('dynamic-toc');
    const tocWidget = document.querySelector('.widget-toc') as HTMLElement;

    if (!tocContainer || headings.length === 0) {
      if (tocWidget) tocWidget.style.display = 'none';
      return;
    }

    const ul = document.createElement('ul');
    ul.className = 'toc-list';

    headings.forEach((heading, index) => {
      // Ensure heading has an ID
      if (!heading.id) {
        // Create slug from text
        const text = heading.textContent || '';
        heading.id = text
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-') || `section-${index}`;
      }

      const li = document.createElement('li');
      li.className = `toc-item toc-item--${heading.tagName.toLowerCase()}`;
      
      const a = document.createElement('a');
      a.href = `#${heading.id}`;
      a.textContent = heading.textContent;
      a.className = 'toc-link';

      li.appendChild(a);
      ul.appendChild(li);
    });

    tocContainer.appendChild(ul);

    // Robust Map-based Scrollspy behavior
    const visibleHeadings = new Map();

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          visibleHeadings.set(entry.target, entry.target.id);
        } else {
          visibleHeadings.delete(entry.target);
        }
      });

      let activeId = '';
      if (visibleHeadings.size > 0) {
        const sorted = Array.from(visibleHeadings.keys()).sort((a, b) => {
          return a.getBoundingClientRect().top - b.getBoundingClientRect().top;
        });
        activeId = sorted[0].id;
      } else if (window.scrollY < 200) {
        const firstLink = document.querySelector('.toc-link');
        if (firstLink) {
          const href = firstLink.getAttribute('href');
          if (href) activeId = href.substring(1);
        }
      }

      if (activeId) {
        document.querySelectorAll('.toc-link').forEach(link => {
          if (link.getAttribute('href') === `#${activeId}`) {
            link.classList.add('toc-link--active');
          } else {
            link.classList.remove('toc-link--active');
          }
        });
      }
    }, {
      root: null,
      rootMargin: '-80px 0px -50% 0px',
      threshold: 0
    });

    headings.forEach(heading => observer.observe(heading));
  });

  // ── Social Sharing Handlers ──
  const shareFacebook = document.getElementById('share-facebook');
  const shareLinkedin = document.getElementById('share-linkedin');
  const shareTwitter = document.getElementById('share-twitter');
  const shareCopy = document.getElementById('share-copy');
  const shareEmail = document.getElementById('share-email');

  const pageUrl = window.location.href;
  const pageTitle = document.title;

  shareFacebook?.addEventListener('click', () => {
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
  });

  shareLinkedin?.addEventListener('click', () => {
    window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
  });

  shareTwitter?.addEventListener('click', () => {
    window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`, '_blank', 'width=600,height=400');
  });

  shareEmail?.addEventListener('click', () => {
    window.location.href = `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(pageUrl)}`;
  });

  shareCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      const tooltip = document.getElementById('share-copy-tooltip');
      if (tooltip) {
        tooltip.classList.add('share-tooltip--visible');
        setTimeout(() => {
          tooltip.classList.remove('share-tooltip--visible');
        }, 2000);
      }
    } catch (err) {
      console.error('Failed to copy link: ', err);
    }
  });

  // ── Sidebar Inquiry Form Submission ──
  const sbForm = document.getElementById('sidebar-inquiry-form') as HTMLFormElement;
  const sbSubmitBtn = document.getElementById('sb-form-submit') as HTMLButtonElement;

  sbForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!sbForm.checkValidity()) {
      sbForm.reportValidity();
      return;
    }

    const initialHtml = sbSubmitBtn.innerHTML;
    sbSubmitBtn.disabled = true;
    sbSubmitBtn.textContent = 'Отправка...';

    const formData = new FormData(sbForm);
    if (formData.get('b_website')) {
      console.warn('Bot submission detected via honeypot field.');
      return;
    }
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        sbForm.reset();
        const pathname = window.location.pathname;
        let redirectUrl = '/thank-you';
        if (pathname.startsWith('/ru')) {
          redirectUrl = '/ru/thank-you';
        } else if (pathname.startsWith('/es')) {
          redirectUrl = '/es/thank-you';
        } else if (pathname.startsWith('/ar')) {
          redirectUrl = '/ar/thank-you';
        }
        if (typeof (window as any).gkvTrackLeadAndRedirect === 'function') {
          try {
            (window as any).gkvTrackLeadAndRedirect(redirectUrl, 'article_sidebar_inquiry');
          } catch {
            window.location.assign(redirectUrl);
          }
        } else {
          window.location.assign(redirectUrl);
        }
      } else {
        throw new Error('Failed');
      }
    } catch {
      sbSubmitBtn.disabled = false;
      sbSubmitBtn.innerHTML = initialHtml;
      alert('Что-то пошло не так. Пожалуйста, напишите нам на электронную почту inquiry@ginkvora.com');
    }
  });
</script>
