  .toc-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
    display: block;
    padding: 0.25rem 0 0.25rem 0.75rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
  }

  .toc-item--h3 .toc-link {
    padding-left: 1.5rem;
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .toc-link:hover {
