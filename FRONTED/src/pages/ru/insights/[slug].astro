    border-left-color: rgba(212, 166, 84, 0.3);
  }

  .toc-link--active {
    color: var(--color-primary);
    font-weight: 600;
    border-left-color: var(--color-primary);
    background: linear-gradient(90deg, rgba(212, 166, 84, 0.12) 0%, transparent 100%);
