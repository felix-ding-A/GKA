<script>
  function initFormulationForm() {
    const form = document.getElementById('formulation-quote-form') as HTMLFormElement;
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Отправка запроса...';
        }

        const formData = new FormData(form);
        
        // Anti-spam honey pot check
        if (formData.get('b_website')) {
          console.warn('Honeypot trigger.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Отправить запрос на рецептуру';
          }
          return;
        }

        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          interest: 'Custom Formulation',
          productName: formData.get('productConcept'),
          quantity: formData.get('expectedVolume'),
          message: formData.get('message') || 'None',
          b_website: formData.get('b_website')
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          if (res.ok) {
            form.reset();
            if (successMsg) successMsg.style.display = 'block';
            if (submitBtn) submitBtn.innerHTML = 'Отправлено ✓';
            (window as any).gkvTrackLeadAndRedirect('/ru/thank-you', 'custom_formulation');
          } else {
            alert('Не удалось отправить запрос. Пожалуйста, проверьте данные или напишите нам на электронную почту inquiry@ginkvora.com.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = 'Отправить запрос на рецептуру';
            }
          }
        } catch (err) {
          alert('Ошибка сети. Пожалуйста, попробуйте еще раз.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Отправить запрос на рецептуру';
          }
        }
      });
    }
  }

  // Support SPA navigation loading
  initFormulationForm();
  document.addEventListener('astro:page-load', initFormulationForm);

  function initHeroCarousel() {
    const carousel = document.querySelector('.hero-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.carousel-slide');
    const indicators = carousel.querySelectorAll('.carousel-indicators .indicator');
    let currentIndex = 0;
    let timer: number | null = null;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });
      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add('active');
        } else {
          indicator.classList.remove('active');
        }
      });
      currentIndex = index;
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(() => {
        let nextIndex = (currentIndex + 1) % slides.length;
        showSlide(nextIndex);
      }, 3000) as unknown as number;
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        showSlide(index);
        startAutoPlay();
      });
    });

    startAutoPlay();
  }

  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
