---
// src/pages/ru/custom-formulation.astro — Premium B2B Custom Formulation & OEM Page (Russian)
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://ginkvora.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Разработка рецептур', item: 'https://ginkvora.com/ru/custom-formulation' },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Разработка индивидуальных рецептур и контрактное производство | GINKVORA',
  'description': 'Услуги контрактного производства и разработки индивидуальных рецептур для оральных пленок (OTF) и передового липосомального капсулирования. OEM/ODM решения B2B.',
  'url': 'https://ginkvora.com/ru/custom-formulation',
};
---

<BaseLayout
  title="Разработка рецептур и контрактное производство B2B | GINKVORA"
  description="Услуги контрактной разработки GINKVORA: липосомальное инкапсулирование, ородиспергируемые пленки (OTF), микроинкапсуляция и OEM/ODM экстракты."
  lang="ru"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <main class="formulation-page bg-noise">
    <!-- Hero Section -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <div class="hero-columns">
          <div class="hero-text-col reveal">
            <span class="section-label">B2B OEM/ODM РЕШЕНИЯ</span>
            <h1 class="banner-title">Разработка индивидуальных рецептур: <span class="gradient-text--gold">от инновации до готового продукта</span></h1>
            <p class="banner-desc">
              Расширяем возможности вашего бренда с помощью передовых технологий оральных пленок (OTF) и микрокапсулирования. Разработка под ваши конкретные требования к ингредиентам с оптимизацией для максимальной эффективности.
            </p>
            <div class="hero-actions">
              <a href="#inquiry-form-section" class="btn btn--gold">Запросить расчет рецептуры</a>
            </div>
          </div>
          <div class="hero-visual-col reveal reveal-delay-2">
            <div class="image-showcase glass hero-carousel">
              <div class="carousel-slides">
                <div class="carousel-slide active">
                  <img
                    src="/images/ginkvora-cleanroom-manufacturing-machinery.webp"
                    alt="Оборудование для производства в чистых помещениях класса 100 000 GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Чистые помещения класса 100 000</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-gmp-capsule-bottle-filling-line.webp"
                    alt="Автоматизированная линия фасовки капсул GMP GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Автоматизированная линия фасовки GMP</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-otf-strip-packaging-cleanroom-line.webp"
                    alt="Линия упаковки полосок OTF GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Прецизионная упаковка полосок OTF</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora%20QC%20Laboratory.webp"
                    alt="Современная лаборатория контроля качества QC GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Лаборатория контроля качества (QC)</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-rd-analytical-laboratory.webp"
                    alt="Научно-исследовательская аналитическая лаборатория R&D GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Центр R&D разработок и анализа</div>
                </div>
              </div>
              
              <!-- Carousel Indicators -->
              <div class="carousel-indicators">
                <span class="indicator active" data-index="0"></span>
                <span class="indicator" data-index="1"></span>
                <span class="indicator" data-index="2"></span>
                <span class="indicator" data-index="3"></span>
                <span class="indicator" data-index="4"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- The Core Focus: OTF -->
    <section class="section otf-section bg-deep" id="otf-focus" aria-label="Oral Thin Film Technology">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Ключевая специализация</span>
          <h2 class="section-title">Высокотехнологичные оральные быстрорастворимые пленки (OTF)</h2>
          <p class="section-desc">
            Используйте нашу передовую технологию доставки веществ в виде тонких пленок, чтобы выгодно отличить ваш бренд от стандартных капсул и таблеток.
          </p>
        </div>

        <div class="grid-2-columns">
          <div class="visual-panel reveal">
            <div class="image-showcase glass">
              <img
                src="/images/oral-dissolving-film-benefits.webp"
                alt="Преимущества оральных быстрорастворимых пленок (OTF) GINKVORA, включая быстрое всасывание, настраиваемую матрицу и высокую емкость активных ингредиентов"
                class="showcase-img"
                width="600"
                height="400"
              />
            </div>
          </div>

          <div class="content-panel">
            <div class="feature-card glass reveal reveal-delay-1">
              <div class="feature-icon">⚡</div>
              <div class="feature-body">
                <h3>Быстрое усвоение и биодоступность</h3>
                <p>
                  Обходит первичный метаболизм в печени. Мгновенно растворяется в полости рта для быстрого всасывания через слизистую оболочку и прямого системного действия.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-2">
              <div class="feature-icon">🧪</div>
              <div class="feature-body">
                <h3>Настраиваемая полимерная матрица</h3>
                <p>
                  Технологии маскирования вкуса, индивидуальные профили растворения (от мгновенного до контролируемого) и дозировка активных компонентов до 150 мг на одну пленку.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-3">
              <div class="feature-icon">💧</div>
              <div class="feature-body">
                <h3>Не требует запивания водой</h3>
                <p>
                  Не требуется вода для запивания. Обеспечивает максимальное удобство приема "на ходу" для активного образа жизни, повышая регулярность приема и лояльность к бренду.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-4">
              <div class="feature-icon">🌿</div>
              <div class="feature-body">
                <h3>Сферы применения: Anti-Aging, ноотропы и бьюти-сфера</h3>
                <p>
                  Идеально подходит для предшественников NAD+ (NMN), PQQ, глутатиона и растительных экстрактов. Наша технология OTF обеспечивает оптимальную доставку биоактивных омолажающих ингредиентов, поддерживая здоровье клеток изнутри (ECM).
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diversified Solutions: Encapsulation -->
    <section class="container section encapsulation-section" aria-label="Encapsulation Services">
      <div class="section-header reveal">
        <span class="section-label">Различные системы доставки</span>
        <h2 class="section-title">Передовые услуги капсулирования</h2>
        <p class="section-desc">
          Помимо тонких пленок, GINKVORA предлагает различные современные форматы инкапсуляции для стабилизации чувствительных веществ и контроля кинетики их высвобождения.
        </p>
      </div>

      <div class="grid-3">
        <div class="cap-card glass reveal">
          <div class="cap-icon">🧬</div>
          <h3>Липосомальное инкапсулирование</h3>
          <p>
            Липидные бислойные микросферы защищают хрупкие молекулы (такие как витамин C или глабридин) от воздействия желудочного сока, максимизируя всасывание в кишечнике.
          </p>
          <div class="cap-tag">Стабильность и биодоступность</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-1">
          <div class="cap-icon">⚪</div>
          <h3>Производство таблеток на заказ</h3>
          <p>
            Высокоскоростное ротационное прессование: таблетки в пленочной оболочке, жевательные, сублингвальные и шипучие. Индивидуальные формы, тиснение логотипа и контроль растворения.
          </p>
          <div class="cap-tag">Прецизионное прессование</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-2">
          <div class="cap-icon">💊</div>
          <h3>Капсулы на заказ</h3>
          <p>
            Наполнение вегетарианских капсул HPMC и пуллулана с высокой точностью дозирования. Возможность смешивания сложных сухих экстрактов с минимальным использованием вспомогательных веществ.
          </p>
          <div class="cap-tag">Масштабируемое производство</div>
        </div>
      </div>

      <div class="encap-footer-visual reveal mt-6">
        <div class="image-showcase glass">
          <img
            src="/images/ginkvora-advanced-delivery-systems-microencapsulation.webp"
            alt="Передовые технологии разработки: микрокапсулирование, липосомальные системы доставки и прецизионные твердые лекарственные формы для повышенной биодоступности"
            class="showcase-img"
            width="1632"
            height="656"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Technical Capabilities -->
    <section class="section capabilities-section bg-deep" aria-label="Technical Capabilities">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Почему выбирают GINKVORA</span>
          <h2 class="section-title">Технические возможности и R&D</h2>
          <p class="section-desc">
            Мы помогаем перенести лабораторные инновации на промышленные линии GMP контрактного производства.
          </p>
        </div>

        <div class="grid-3">
          <div class="capability-item reveal">
            <div class="cap-num">01</div>
            <h3>Превосходство в R&D</h3>
            <p>
              Наши ученые настраивают эластичность, толщину, вкус пленок и параметры загрузки активных веществ в соответствии с вашими индивидуальными формулами.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-1">
            <div class="cap-num">02</div>
            <h3>Стандарты качества GMP</h3>
            <p>
              Чистые помещения с регулируемой температурой и влажностью полностью соответствуют стандартам GMP. Все пилотные и коммерческие партии проходят строгий контроль качества (HPLC/ICP-MS).
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-2">
            <div class="cap-num">03</div>
            <h3>Комплексная поддержка</h3>
            <p>
              От закупки сырья и тестирования активных ингредиентов до разработки рецептур, опытно-промышленных испытаний и финальной блистерной упаковки.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We Work -->
    <section class="container section timeline-section" aria-label="Process Flow">
      <div class="section-header reveal">
        <span class="section-label">Пошаговая интеграция</span>
        <h2 class="section-title">Наш процесс сотрудничества</h2>
        <p class="section-desc">
          Как мы ведем разработку вашего продукта от концепции до отгрузки готовых партий.
        </p>
      </div>

      <div class="process-timeline" role="list">
        <!-- Step 1 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">01</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal">
            <div class="step-icon-emoji">💬</div>
            <div class="step-body">
              <h3>Консультация и концепт</h3>
              <p>Обсуждение активных компонентов (например, NMN, PQQ), целей дозирования, требований к высвобождению и стандартов целевого региона.</p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">02</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-1">
            <div class="step-icon-emoji">🔬</div>
            <div class="step-body">
              <h3>Разработка рецептуры</h3>
              <p>Наша лаборатория проектирует полимерную матрицу, подбирает маскирующие агенты и создает физические образцы для оценки стабильности и распадаемости.</p>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">03</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-2">
            <div class="step-icon-emoji">⚙️</div>
            <div class="step-body">
              <h3>Масштабирование и пилотный выпуск</h3>
              <p>Мы переносим лабораторную рецептуру на пилотную линию, тестируя параметры процесса, кинетику сушки и равномерность дозирования.</p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="process-step process-step--last" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">04</span></div>
          </div>
          <div class="step-content glass reveal reveal-delay-3">
            <div class="step-icon-emoji">📦</div>
            <div class="step-body">
              <h3>Промышленное производство GMP</h3>
              <p>После утверждения пилотной партии мы запускаем крупносерийное производство по стандартам GMP, оформляем COA и упаковываем готовую продукцию в барабаны или блистеры.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA & Form Section -->
    <section class="section form-section bg-deep" id="inquiry-form-section" aria-label="Formulation Inquiry Form">
      <div class="container">
        <div class="grid-cta">
          <!-- Left info -->
          <div class="cta-info reveal">
            <span class="section-label">Коммерческое снабжение</span>
            <h2>Готовы воплотить вашу концепцию в жизнь?</h2>
            <p class="cta-desc">
              Свяжитесь с нашим отделом разработки. Мы предлагаем контрактное производство, услуги OEM/ODM (Private Label) и пилотные партии образцов для квалифицированных партнеров.
            </p>

            <div class="contact-list">
              <div class="contact-item">
                <span class="icon">📧</span>
                <div>
                  <strong>Email для прямых запросов</strong>
                  <a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">📞</span>
                <div>
                  <strong>WhatsApp поддержка продаж</strong>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer">+86 13201818603</a>
                </div>
              </div>
            </div>

            <div class="policy-card glass mt-6">
              <h3>Руководство по OEM и Private Label</h3>
              <ul class="policy-list">
                <li><strong>Образцы:</strong> Тестовые образцы пленок доступны для квалифицированных косметических брендов и производителей добавок.</li>
                <li><strong>Документация:</strong> Аналитические паспорта (COA), тесты на тяжелые металлы и спецификации процесса предоставляются с каждым расчетом.</li>
                <li><strong>Сырье:</strong> Мы можем работать на давальческом сырье заказчика или закупать ингредиенты через наших проверенных поставщиков.</li>
              </ul>
            </div>
          </div>

          <!-- Right form -->
          <div class="cta-form-wrapper reveal reveal-delay-1">
            <div class="form-card glass">
              <h3>Запросить расчет рецептуры</h3>
              <p class="form-sub">Поля, отмеченные звездочкой (*), обязательны для заполнения.</p>

              <form id="formulation-quote-form" class="custom-form">
                <!-- Honeypot -->
                <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />

                <div class="form-field">
                  <label for="name" class="form-label">Имя/Название компании *</label>
                  <input type="text" id="name" name="name" required class="form-input" placeholder="Иван Иванов / ООО «Компания»" />
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="email" class="form-label">Email / Рабочая почта *</label>
                    <input type="email" id="email" name="email" required class="form-input" placeholder="name@company.com" />
                  </div>
                  <div class="form-field">
                    <label for="phone" class="form-label">Телефон / WhatsApp *</label>
                    <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+7 (999) 123-45-67" />
                  </div>
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="productConcept" class="form-label">Концепция продукта *</label>
                    <input type="text" id="productConcept" name="productConcept" required class="form-input" placeholder="Напр. быстрорастворимая пленка, липосомы" />
                  </div>
                  <div class="form-field">
                    <label for="expectedVolume" class="form-label">Ожидаемый объем *</label>
                    <select id="expectedVolume" name="expectedVolume" required class="form-input form-select">
                      <option value="" disabled selected>Выберите объем заказа...</option>
                      <option value="under-100k">&lt; 100k шт</option>
                      <option value="100k-500k">100k - 500k шт</option>
                      <option value="over-500k">&gt; 500k шт</option>
                    </select>
                  </div>
                </div>

                <div class="form-field">
                  <label for="message" class="form-label">Детальные требования к рецептуре</label>
                  <textarea id="message" name="message" class="form-input" rows="4" placeholder="Необязательно. Опишите активные ингредиенты, дозировки, желаемую скорость растворения и другие предпочтения..."></textarea>
                </div>

                <button type="submit" class="btn btn--gold btn--lg btn--block" id="submit-btn">
                  Отправить запрос на рецептуру
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                </button>

                <div id="success-msg" class="success-message" style="display: none;" role="alert">
                  ✓ Запрос успешно отправлен. Наша команда R&D свяжется с вами в течение 12 часов.
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulation-page {
    padding-bottom: 0;
  }

  /* --- Hero Banner --- */
  .page-banner {
    position: relative;
    padding-block: 8rem 5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 45% 60% at 85% 20%, rgba(212, 166, 84, 0.09) 0%, transparent 100%);
  }

  .hero-columns {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .banner-title {
