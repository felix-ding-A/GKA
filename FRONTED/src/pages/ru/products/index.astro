---
// src/pages/ru/products/index.astro — Russian products listing page
export const prerender = false; // Disable prerendering so SSR handles searchParams (category, mechanism, page)

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildListingCanonical } from '../../../lib/seo';
import { getProductsPaginated, urlFor, getLocalizedField } from '../../../lib/sanity';
import { useTranslations } from '../../../i18n/utils';

const lang = 'ru';
const t = useTranslations(lang);

const category = Astro.url.searchParams.get('category');
const mechanism = Astro.url.searchParams.get('mechanism');
const pageParam = Astro.url.searchParams.get('page');

// Pagination config
const PRODUCTS_PER_PAGE = 12;
const requestedPage = Math.max(1, parseInt(pageParam ?? '1') || 1);
const { products, total: totalProducts } = await getProductsPaginated({ category, mechanism, page: requestedPage, pageSize: PRODUCTS_PER_PAGE });
const totalPages = Math.max(1, Math.ceil(totalProducts / PRODUCTS_PER_PAGE));
const currentPage = Math.min(requestedPage, totalPages);
const pageStart = (currentPage - 1) * PRODUCTS_PER_PAGE;

const siteUrl = 'https://ginkvora.com';
const canonicalUrl = buildListingCanonical({
  pathname: '/ru/products', category, mechanism, page: currentPage,
});

const categoriesList = [
  { slug: 'liposomal', name: 'Липосомальные', icon: '🧬' },
  { slug: 'pet-longevity', name: 'Долголетие питомцев', icon: '🐾' },
  { slug: 'superfood', name: 'Суперфуды', icon: '🍎' },
  { slug: 'cosmetic-ingredients', name: 'Косметическое сырье', icon: '🌿' }
];

const mechanismsList = [
  { slug: 'collagen-stimulant', name: 'Коллагеновый матрикс', icon: '🧬' },
  { slug: 'mmp-inhibitor', name: 'Защита от MMP', icon: '🛡️' },
  { slug: 'anti-glycation', name: 'Глико-защита', icon: '⏳' }
];

function getFilterUrl(cat: string | null, mech: string | null) {
  const params = new URLSearchParams();
  if (cat) params.set('category', cat);
  if (mech) params.set('mechanism', mech);
  const q = params.toString();
  return `/ru/products${q ? '?' + q : ''}`;
}

function getPageUrl(page: number) {
  const params = new URLSearchParams();
  if (category) params.set('category', category);
  if (mechanism) params.set('mechanism', mechanism);
  if (page > 1) params.set('page', String(page));
  const q = params.toString();
  return `/ru/products${q ? '?' + q : ''}`;
}

// Pre-compute pagination items to avoid Astro JSX parsing issues with > in templates
type PageItem = { type: 'page'; page: number; url: string; active: boolean } | { type: 'ellipsis' };
const pageItems: PageItem[] = [];
if (totalPages > 1) {
  const visiblePages = Array.from({ length: totalPages }, (_, i) => i + 1).filter(p =>
    p === 1 || p === totalPages ||
    (p >= currentPage - 1 && p <= currentPage + 1) ||
    (p === currentPage - 2 && currentPage > 3) ||
    (p === currentPage + 2 && currentPage < totalPages - 2)
  );
  visiblePages.forEach((p, idx) => {
    if (idx > 0 && p - visiblePages[idx - 1] > 1) pageItems.push({ type: 'ellipsis' });
    pageItems.push({ type: 'page', page: p, url: getPageUrl(p), active: p === currentPage });
  });
}

let pageTitle = "Каталог антивозрастных ингредиентов B2B | GINKVORA";
if (mechanism === 'collagen-stimulant') {
  pageTitle = "Стимуляторы синтеза коллагена оптом | GINKVORA";
} else if (mechanism === 'mmp-inhibitor') {
  pageTitle = "Ингибиторы MMP оптом | Косметический класс | GINKVORA";
} else if (mechanism === 'anti-glycation') {
  pageTitle = "Ингредиенты против гликации оптом | GINKVORA";
}

let pageDescription = "Каталог B2B антивозрастных ингредиентов GINKVORA: PDRN, NMN, Глабридин. Косметический и пищевой классы. Бесплатные образцы.";
if (category === 'pet-longevity') {
  pageDescription = "Высокочистое растительное сырье, направленное на замедление клеточного старения собак и кошек. Премиальные активаторы сиртуинов и митохондриальные протекторы для долголетия домашних животных.";
}

let academicIntro = "";
if (category === 'pet-longevity') {
  academicIntro = "Борьба с клеточным старением собак и кошек с помощью высокочистых активаторов сиртуинов и протекторов митохондрий.";
}

// Breadcrumbs Schema
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная",   "item": `${siteUrl}/ru` },
    { "@type": "ListItem", "position": 2, "name": "Продукты", "item": `${siteUrl}/ru/products` },
  ],
};
---

<BaseLayout
  lang={lang}
  title="Портфолио биоактивных ингредиентов | GINKVORA"
  description="Изучите наше портфолио высокочистых ботанических и биоактивных ингредиентов для косметики, нутрицевтиков и передовых систем доставки."
  canonicalUrl={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} slot="head" />

  <main class="products-page bg-noise">
    <!-- Page Banner -->
    <header class="page-banner" aria-label="Заголовок страницы">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">B2B каталог сырья</span>
        <h1 class="banner-title">
          {mechanism === 'collagen-stimulant' && "Стимуляторы синтеза коллагена оптом"}
          {mechanism === 'mmp-inhibitor' && "Ингибиторы MMP оптом (Косметический класс)"}
          {mechanism === 'anti-glycation' && "Ингредиенты против гликации оптом"}
          {!mechanism && "Портфолио биоактивных ингредиентов"}
        </h1>
        <p class="banner-desc">
          {academicIntro ? (
            <span class="academic-highlight">{academicIntro}</span>
          ) : (
            "Точно разработанные растительные экстракты, пептиды и функциональные активы для косметического и нутрицевтического применения."
          )}
        </p>

        <!-- Prominent Hero Search Area -->
        <div class="hero-search-wrapper">
          <div class="hero-search-box">
            <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              type="search"
              id="hero-product-search"
              placeholder="Поиск ингредиентов по названию, CAS номеру (напр. 13749-38-7) или чистоте..."
              aria-label="Поиск по каталогу"
            />
            <button type="button" class="hero-search-btn" id="hero-search-trigger">
              Искать в каталоге
            </button>
          </div>
          <!-- Hot Search Keyword Tags -->
          <div class="hero-hot-tags">
            <button type="button" class="hero-tag-btn" data-search="Proxylane">🔥 Proxylane</button>
            <button type="button" class="hero-tag-btn" data-search="NMN">⚡ NMN</button>
            <button type="button" class="hero-tag-btn" data-search="PQQ">🌟 PQQ</button>
            <button type="button" class="hero-tag-btn" data-search="Glabridin">🌿 Glabridin</button>
            <button type="button" class="hero-tag-btn" data-search="EGCG">🍃 EGCG</button>
            <button type="button" class="hero-tag-btn" data-search="Liposomal">🧬 Liposomal</button>
            <button type="button" class="hero-tag-btn" data-search="13749-38-7">🧪 CAS 13749-38-7</button>
          </div>
        </div>
      </div>
    </header>

    <div class="container products-layout">
      <!-- Filter bar -->
      <section class="filter-bar glass" aria-label="Фильтры">

        <div class="filter-row">
          <span class="filter-label">Категория:</span>
          <nav class="category-pills" aria-label="Категории продуктов">
            <a 
              href={getFilterUrl(null, mechanism)} 
              class={`cat-pill ${!category ? 'active' : ''}`}
            >
              Все категории
            </a>
            {categoriesList.map((cat) => (
              <a 
                href={getFilterUrl(cat.slug, mechanism)} 
                class={`cat-pill ${category === cat.slug ? 'active' : ''}`}
              >
                <span class="tab-icon">{cat.icon}</span>
                {cat.name}
              </a>
            ))}
          </nav>
        </div>

        <div class="filter-row">
          <span class="filter-label">Целевой механизм:</span>
          <nav class="category-pills" aria-label="Механизмы действия">
            <a 
              href={getFilterUrl(category, null)} 
              class={`cat-pill ${!mechanism ? 'active' : ''}`}
            >
              Все механизмы
            </a>
            {mechanismsList.map((mech) => (
              <a 
                href={getFilterUrl(category, mech.slug)} 
                class={`cat-pill ${mechanism === mech.slug ? 'active' : ''}`}
              >
                <span class="tab-icon">{mech.icon}</span>
                {mech.name}
              </a>
            ))}
          </nav>
        </div>
      </section>

      <!-- Product Grid -->
      <section class="products-section" aria-label="Каталог продуктов">
        <div class="products-count" id="products-count-label">
          Показано {pageStart + 1}–{Math.min(pageStart + PRODUCTS_PER_PAGE, totalProducts)} из {totalProducts} продуктов
        </div>

        <div id="product-grid" class="product-grid" data-current-page={currentPage}>
          {products.map((product: any, index: number) => {
            const localShortDesc = (getLocalizedField(product, 'shortDescription', lang) ?? product.shortDescription) as string | undefined;
            return (
              <article
                class="product-card glass"
                data-name={product.name.toLowerCase()}
                data-cas={product.casNumber ? product.casNumber.toLowerCase() : ''}
                data-desc={localShortDesc ? localShortDesc.toLowerCase() : ''}
                data-page-index={currentPage}
                style="display: flex;"
              >
                {product.featured && (
                  <div class="card-featured-badge">{t('products.featured_badge')}</div>
                )}
                <div class="card-image">
                  <a href={`/ru/products/${product.slug}`} aria-label={`Подробнее о ${product.name}`}>
                    <picture>
                      <source srcset={urlFor(product.heroImage).width(400).format('webp').url()} type="image/webp" />
                      <img
                        src={urlFor(product.heroImage).width(400).url()}
                        alt={product.name}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        fetchpriority={index === 0 ? 'high' : 'low'}
                        width="400"
                        height="300"
                        class="card-img"
                      />
                    </picture>
                  </a>
                </div>
                <div class="card-body">
                  <div class="card-top">
                    <span class="card-category">
                      {product.categories && product.categories.length > 0
                        ? product.categories.map(c => c.name).join(' · ')
                        : product.category?.name}
                    </span>
                    {product.purity && (
                      <span class="card-purity font-mono">{product.purity}</span>
                    )}
                  </div>
                  <h2 class="card-title">
                    <a href={`/ru/products/${product.slug}`}>{product.name}</a>
                  </h2>
                  {product.botanicalName && (
                    <p class="card-botanical">{product.botanicalName}</p>
                  )}
                  {localShortDesc && (
                    <p class="card-desc">{localShortDesc}</p>
                  )}

                  <div class="card-specs">
                    {product.casNumber && (
                      <span class="card-cas">CAS: {product.casNumber}</span>
                    )}
                    {product.applicationDisplay && (
                      <span class={`card-app-badge app--${product.applicationDisplay}`}>
                        {product.applicationDisplay === 'dual' && '● Двойное применение'}
                        {product.applicationDisplay === 'topical' && '● Наружное применение'}
                        {product.applicationDisplay === 'oral' && '● Перорально'}
                      </span>
                    )}
                  </div>

                  <div class="card-actions">
                    <a href={`/ru/products/${product.slug}`} class="btn btn--secondary btn--sm">
                      {t('products.view_details')}
                    </a>
                    <a href="/ru/contact" class="btn btn--gold btn--sm">
                      {t('products.request_sample')}
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <!-- No results message -->
        <div id="no-results" class="no-results" style="display: none;" aria-live="polite">
          <p>{t('products.no_results')}</p>
          <button class="btn btn--gold" id="reset-filters">Сбросить фильтры</button>
        </div>

        <!-- Pagination -->
        {totalPages > 1 && (
          <nav class="pagination" aria-label="Страницы продуктов" id="pagination-nav">
            <a
              href={getPageUrl(currentPage - 1)}
              class={`page-btn page-prev ${currentPage === 1 ? 'disabled' : ''}`}
              aria-disabled={currentPage === 1}
              aria-label="Предыдущая страница"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </a>

            {pageItems.map((item) =>
              item.type === 'ellipsis'
                ? <span class="page-ellipsis">…</span>
                : <a
                    href={item.url}
                    class={`page-btn page-num ${item.active ? 'active' : ''}`}
                    aria-current={item.active ? 'page' : undefined}
                  >{item.page}</a>
            )}

            <a
              href={getPageUrl(currentPage + 1)}
              class={`page-btn page-next ${currentPage === totalPages ? 'disabled' : ''}`}
              aria-disabled={currentPage === totalPages}
              aria-label="Следующая страница"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          </nav>
        )}
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .products-page { padding-block: 0 var(--space-4xl); }

  .page-banner {
    position: relative; padding-block: 8rem 1.5rem;
    background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%);
    overflow: hidden; margin-bottom: 0;
  }
  .banner-gradient {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%);
  }
  .banner-content { position: relative; z-index: 1; text-align: center; max-width: 1100px; margin-inline: auto; }
  .banner-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
  .banner-desc { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.6; }

  .academic-highlight {
    display: block;
    font-style: italic;
    color: var(--color-primary-light);
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* ── Hero Search Widget ── */
  .hero-search-wrapper {
    margin-top: 2rem;
    max-width: 860px;
    margin-inline: auto;
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px 6px 18px;
    background: rgba(12, 14, 12, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(212, 166, 84, 0.4);
    border-radius: 9999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(212, 166, 84, 0.15);
    transition: all 0.3s ease;
  }

  .hero-search-box:focus-within {
    border-color: rgba(212, 166, 84, 0.8);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(212, 166, 84, 0.3);
  }

  .hero-search-icon {
    color: #d4a654;
    flex-shrink: 0;
  }

  .hero-search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: #fff;
    font-family: inherit;
  }

  .hero-search-box input::placeholder {
    color: rgba(245, 239, 224, 0.45);
  }

  .hero-search-btn {
    padding: 0.65rem 1.4rem;
    background: linear-gradient(135deg, #d4a654 0%, #b8860b 100%);
    border: none;
    border-radius: 9999px;
    color: #060503;
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .hero-search-btn:hover {
    background: linear-gradient(135deg, #f0c878 0%, #d4a654 100%);
    box-shadow: 0 4px 15px rgba(212, 166, 84, 0.4);
  }

  .hero-hot-tags {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .hot-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #d4a654;
    margin-right: 4px;
  }

  .hero-tag-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 166, 84, 0.2);
    color: #e0d8c3;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .hero-tag-btn:hover {
    background: rgba(212, 166, 84, 0.2);
    border-color: rgba(212, 166, 84, 0.5);
    color: #f0c878;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero-search-btn { display: none; }
    .hero-search-box { padding-right: 14px; }
  }

  .products-layout { display: flex; flex-direction: column; gap: var(--space-xl); }

  .filter-bar {
    display: flex; flex-direction: column; gap: 0.875rem;
    padding: 1rem 1.25rem; border-radius: var(--radius-lg);
    border: 1px solid rgba(212,166,84,0.18) !important;
  }
  .search-wrap { position: relative; }
  .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--color-text-muted); transition: color var(--transition-fast); }
  .search-wrap:focus-within .search-icon { color: var(--color-primary-light); }
  .search-input {
    width: 100%; padding: 0.75rem 1rem 0.75rem 2.75rem;
    background: rgba(18, 16, 12, 0.7); border: 1.5px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-md); color: var(--color-text); font-size: 0.95rem;
    transition: all var(--transition-fast); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.4);
  }
  .search-input:hover { border-color: rgba(255, 255, 255, 0.4); background: rgba(24, 20, 15, 0.85); }
  .search-input:focus { outline: none; border-color: var(--color-primary-light); box-shadow: 0 0 0 3px rgba(212, 166, 84, 0.25), 0 0 15px rgba(212, 166, 84, 0.15); background: rgba(24, 20, 15, 0.95); }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.625rem;
    margin-top: 0;
    width: 100%;
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .filter-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }

  .filter-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 170px;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .category-pills { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .cat-pill {
    padding: 0.3rem 0.75rem; border-radius: var(--radius-full);
    border: 1px solid transparent; background: transparent;
    color: var(--color-text-secondary); font-size: 0.8125rem; cursor: pointer;
    text-decoration: none;
    transition: all var(--transition-fast);
    line-height: 1.3;
  }
  .cat-pill:hover { border-color: var(--color-primary); color: var(--color-primary-light); }
  .cat-pill.active { background: rgba(212,166,84,0.12); border-color: var(--color-primary); color: var(--color-primary-light); }

  .products-section {
    margin-top: 0;
  }

  .products-count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }

  .product-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;
  }

  .product-card {
    position: relative; display: flex; flex-direction: column;
    border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--color-border) !important;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); border-color: rgba(212,166,84,0.3) !important; }
  .card-featured-badge {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2;
    background: var(--color-primary); color: #000;
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em;
    padding: 0.2rem 0.5rem; border-radius: var(--radius-full); text-transform: uppercase;
  }
  .card-image { aspect-ratio: 4/3; overflow: hidden; }
  .card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .product-card:hover .card-img { transform: scale(1.04); }
  .card-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.625rem; flex: 1; }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .card-category { font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .card-purity { font-size: 0.75rem; color: var(--color-primary-light); background: rgba(212,166,84,0.12); padding: 0.15rem 0.5rem; border-radius: var(--radius-full); border: 1px solid rgba(212,166,84,0.25); }
  .card-title { font-size: 1.125rem; font-weight: 600; line-height: 1.3; }
  .card-title a { color: var(--color-text); text-decoration: none; transition: color var(--transition-fast); }
  .card-title a:hover { color: var(--color-primary-light); }
  .card-botanical { font-style: italic; font-size: 0.8125rem; color: var(--color-text-muted); }
  .card-desc { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-actions { display: flex; gap: 0.5rem; margin-top: auto; padding-top: 0.5rem; flex-wrap: wrap; }
  .card-actions .btn { flex-grow: 1; text-align: center; }

  .no-results { text-align: center; padding: 4rem 2rem; color: var(--color-text-muted); }

  /* ── Pagination ── */
