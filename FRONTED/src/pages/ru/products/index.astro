  .app--oral {
    background: rgba(224, 120, 48, 0.1);
    color: #f39b60;
    border: 1px solid rgba(224, 120, 48, 0.3);
  }
</style>

<script>
  function initFilters() {
    const searchInput  = document.getElementById('product-search') as HTMLInputElement;
    const cards        = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const noResults    = document.getElementById('no-results');
    const grid         = document.getElementById('product-grid');
    const countLabel   = document.getElementById('products-count-label');
    const paginationNav = document.getElementById('pagination-nav');

    let searchTerm     = '';
    const urlParams = new URLSearchParams(window.location.search);
    const pageFromUrl = parseInt(urlParams.get('page') || '');
    const currentPage = !isNaN(pageFromUrl) && pageFromUrl > 0
      ? pageFromUrl
      : parseInt(grid?.getAttribute('data-current-page') || '1');

    function filterProducts() {
      let visible = 0;
      cards.forEach(card => {
        const name = card.dataset.name ?? '';
        const cas  = card.dataset.cas ?? '';
        const desc = card.dataset.desc ?? '';
        const pageIndex = parseInt(card.getAttribute('data-page-index') || '1');

        let matches = false;
        if (searchTerm) {
          matches =
            name.includes(searchTerm) ||
            cas.includes(searchTerm) ||
            desc.includes(searchTerm);
        } else {
          matches = pageIndex === currentPage;
        }

        card.style.display = matches ? 'flex' : 'none';
        if (matches) visible++;
      });

      if (countLabel) {
        if (searchTerm) {
          countLabel.textContent = `Найдено ${visible} продуктов по запросу «${searchTerm}»`;
        } else {
          countLabel.textContent = countLabel.getAttribute('data-original') || '';
        }
      }

      if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
      if (grid) grid.style.display = visible === 0 ? 'none' : 'grid';
      if (paginationNav) paginationNav.style.display = (visible === 0 || searchTerm) ? 'none' : '';
    }

    // Cache original count text
    if (countLabel) countLabel.setAttribute('data-original', countLabel.textContent || '');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchTerm = searchInput.value.toLowerCase().trim();
        const heroInput = document.getElementById('hero-product-search') as HTMLInputElement;
        if (heroInput) heroInput.value = searchInput.value;
        filterProducts();
      });
    }

    const heroSearchInput = document.getElementById('hero-product-search') as HTMLInputElement;
    const heroSearchBtn = document.getElementById('hero-search-trigger');
    const heroTagBtns = document.querySelectorAll('.hero-tag-btn');

    function updateSearchTerm(term: string) {
      searchTerm = term.toLowerCase().trim();
      if (searchInput) searchInput.value = term;
      if (heroSearchInput) heroSearchInput.value = term;
      filterProducts();
    }

    if (heroSearchInput) {
      heroSearchInput.addEventListener('input', (e) => {
        updateSearchTerm((e.target as HTMLInputElement).value);
      });
    }

    if (heroSearchBtn) {
      heroSearchBtn.addEventListener('click', () => {
        const term = heroSearchInput ? heroSearchInput.value : '';
        updateSearchTerm(term);
        const layout = document.querySelector('.products-layout');
        if (layout) layout.scrollIntoView({ behavior: 'smooth' });
      });
    }

    heroTagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const searchKeyword = btn.getAttribute('data-search') || '';
        updateSearchTerm(searchKeyword);
        const layout = document.querySelector('.products-layout');
        if (layout) layout.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Handle URL search parameter (e.g. /ru/products?search=NMN)
    const searchParam = urlParams.get('search');
    if (searchParam) {
      updateSearchTerm(searchParam);
    }

    const resetButton = document.getElementById('reset-filters');
    if (resetButton) {
      resetButton.addEventListener('click', () => {
        updateSearchTerm('');
      });
    }

    filterProducts();
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
