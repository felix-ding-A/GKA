---
// src/pages/insights/index.astro — B2B Industry Insights & Ingredient Research Blog
export const prerender = false; // Disable prerendering so SSR handles searchParams (category, q, page)

import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildListingCanonical } from '../../lib/seo';
import { getPostsPaginated, urlFor } from '../../lib/sanity';
import { getLocalePath } from '../../i18n/utils';

const lang = 'en';
const lp = (path: string) => getLocalePath(lang, path);
const siteUrl = 'https://ginkvora.com';
const selectedCategory = Astro.url.searchParams.get('category');
const searchQuery = Astro.url.searchParams.get('q') || '';
const pageParam = Astro.url.searchParams.get('page');
const pageSize = 6;

const requestedPage = Math.max(1, parseInt(pageParam ?? '1', 10) || 1);
const { posts: allPosts, total } = await getPostsPaginated({
  category: selectedCategory,
  search: searchQuery,
  page: requestedPage,
  pageSize,
});

const totalPages = Math.max(1, Math.ceil(total / pageSize));
const currentPage = Math.min(requestedPage, totalPages);
const canonicalUrl = buildListingCanonical({
  pathname: '/insights', category: selectedCategory, page: currentPage,
});

// Helper function to build page URLs while preserving category and search query params
function getPageHref(pageNum: number) {
  const url = new URL(Astro.url.href);
  if (pageNum <= 1) {
    url.searchParams.delete('page');
  } else {
    url.searchParams.set('page', pageNum.toString());
  }
  const q = url.searchParams.toString();
  return url.pathname + (q ? '?' + q : '');
}

// Breadcrumb structured data
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Insights",
      "item": `${siteUrl}/insights`
    }
  ]
};

// ItemList structured data
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "GINKVORA Industry Insights",
  "description": "Scientific research updates, market trends, and regulatory updates on bioactive ingredients.",
  "url": `${siteUrl}/insights`,
  "numberOfItems": allPosts.length,
  "itemListElement": allPosts.map((post, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${siteUrl}/insights/${post.slug}`,
    "name": post.title,
  }))
};
---

<BaseLayout
  title={selectedCategory ? `${selectedCategory} Insights & Research | GINKVORA` : "B2B Bioactive Ingredient Insights & Scientific Research | GINKVORA"}
  description={selectedCategory ? `Browse our expert research, market trends, and quality reports on ${selectedCategory}.` : "Read GINKVORA Insights for research articles, clinical dosage studies & formulation guides on PDRN, NMN, Glabridin & ECM anti-aging bioactives."}
  canonicalUrl={canonicalUrl}
  noindex={Boolean(searchQuery)}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />
  <main class="insights-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">Industry Insights</span>
        <h1 class="banner-title fade-in-up delay-1">Bioactive Ingredient Research & Formulation Insights</h1>
        <p class="banner-desc fade-in-up delay-2">
          In-depth technical spotlights, scientific whitepapers, and regulatory updates for health brand formulary and procurement officers.
        </p>

        <!-- Search bar inside Banner -->
        <form action="/insights" method="GET" class="search-form">
          <div class="search-input-wrapper">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input 
              type="text" 
              name="q" 
              value={searchQuery} 
              placeholder="Search by ingredient, product, or keyword..." 
              class="search-input"
            />
            {searchQuery && (
              <a href={selectedCategory ? `/insights?category=${encodeURIComponent(selectedCategory)}` : "/insights"} class="search-clear-btn" aria-label="Clear search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </a>
            )}
          </div>
          {selectedCategory && (
            <input type="hidden" name="category" value={selectedCategory} />
          )}
          <button type="submit" class="btn btn--primary search-submit-btn">Search</button>
        </form>
      </div>
    </header>

    <!-- Filter bar -->
    <div class="container filter-container">
      <nav class="category-tabs" aria-label="Category filter">
        <a 
          href={lp(searchQuery ? `/insights?q=${encodeURIComponent(searchQuery)}` : "/insights")} 
          class:list={['category-tab', { 'category-tab--active': !selectedCategory }]}
        >
          All
        </a>
        {['Ingredient Spotlight', 'Formulation Tips', 'Research', 'Quality & Testing', 'Regulatory', 'Market Trends', 'Industry News'].map(cat => {
          const catSlug = cat.toLowerCase().replace(/[^a-z0-9]/g, '');
          const isActive = selectedCategory && selectedCategory.toLowerCase().replace(/[^a-z0-9]/g, '') === catSlug;
          const rawHref = searchQuery 
            ? `/insights?category=${encodeURIComponent(cat)}&q=${encodeURIComponent(searchQuery)}`
            : `/insights?category=${encodeURIComponent(cat)}`;
          return (
            <a 
              href={lp(rawHref)} 
              class:list={['category-tab', { 'category-tab--active': isActive }]}
              rel="nofollow"
            >
              {cat}
            </a>
          );
        })}
      </nav>
    </div>

    <!-- Blog Grid -->
    <div class="container insights-container">
      {allPosts.length > 0 ? (
        <Fragment>
        <section class="insights-grid" id="insights-grid" data-current-page={currentPage} aria-label="Blog posts list">
          {allPosts.map((post) => {
            return (
              <article
                class="blog-card glass reveal"
                data-page-index={currentPage}
                style="display: flex;"
              >
              <div class="card-image-box">
                <a href={`/insights/${post.slug}`} class="card-image-link" aria-label={`Read ${post.title}`}>
                  <picture style="display: contents;">
                    <source srcset={urlFor(post.coverImage).width(800).format('webp').url()} type="image/webp" />
                    <img
                      src={urlFor(post.coverImage).width(800).url()}
                      alt={post.title}
                      width="800"
                      height="450"
                      loading="lazy"
                      decoding="async"
                      class="card-img"
                    />
                  </picture>
                </a>
                {post.tags && post.tags.length > 0 && (
                  <span class="card-tag">{post.tags[0]}</span>
                )}
              </div>

              <div class="card-body">
                <div class="card-meta">
                  <time datetime={post.publishedAt}>
                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    }) : 'May 2026'}
                  </time>
                  {post.readTime && (
                    <>
                      <span class="meta-dot">·</span>
                      <span>{post.readTime} min read</span>
                    </>
                  )}
                </div>

                <h2 class="card-title">
                  <a href={`/insights/${post.slug}`}>{post.title}</a>
                </h2>

                <p class="card-excerpt">{post.excerpt}</p>

                <div class="card-footer">
                  <a href={`/insights/${post.slug}`} class="read-more">
                    Read Article
                    <span class="sr-only"> about {post.title}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                </div>
              </div>
              </article>
            );
          })}
        </section>

        <!-- Pagination Component -->
        {totalPages > 1 && (
          <nav class="pagination" aria-label="Pagination Navigation">
            {currentPage > 1 ? (
              <a href={getPageHref(currentPage - 1)} class="page-btn page-arrow" aria-label="Go to previous page">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
                Prev
              </a>
            ) : (
              <span class="page-btn page-btn--disabled page-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
                Prev
              </span>
            )}

            <div class="page-numbers">
              {Array.from({ length: totalPages }).map((_, idx) => {
                const pageNum = idx + 1;
                const isCurrent = pageNum === currentPage;
                return isCurrent ? (
                  <span class="page-btn page-btn--active" aria-current="page">
                    {pageNum}
                  </span>
                ) : (
                  <a href={getPageHref(pageNum)} class="page-btn" aria-label={`Go to page ${pageNum}`}>
                    {pageNum}
                  </a>
                );
              })}
            </div>

            {currentPage < totalPages ? (
              <a href={getPageHref(currentPage + 1)} class="page-btn page-arrow" aria-label="Go to next page">
                Next
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </a>
            ) : (
              <span class="page-btn page-btn--disabled page-arrow">
                Next
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </span>
            )}
          </nav>
        )}
        </Fragment>
      ) : (
        <div class="no-posts glass">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <line x1="10" y1="9" x2="8" y2="9"/>
          </svg>
          <h3>No articles found</h3>
          <p>
            {searchQuery 
              ? `We couldn't find any articles matching "${searchQuery}". Please try adjusting your keywords.` 
              : "We haven't published any insights in this category yet. Please check back soon or browse our other research articles."}
          </p>
          <a href="/insights" class="btn btn--secondary">View All Insights</a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .insights-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 7rem 3.5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2rem, 3.8vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 1100px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Filter Tabs ── */
  .filter-container {
    margin-top: -1.75rem;
    position: relative;
    z-index: var(--z-float);
    display: flex;
    justify-content: center;
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    background: rgba(8, 13, 8, 0.6);
    border: 1px solid var(--color-border);
    padding: 0.375rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    max-width: 90%;
    box-shadow: var(--shadow-lg);
  }

  .category-tab {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
    font-weight: 500;
  }

  .category-tab:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .category-tab--active {
    background: var(--color-primary) !important;
    color: var(--color-surface-bg) !important;
  }

  /* ── Empty State ── */
  .no-posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212,166,84,0.15) !important;
    max-width: 600px;
    margin: 2rem auto 0;
    width: 100%;
  }

  .no-posts svg {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .no-posts h3 {
    font-size: 1.625rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .no-posts p {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* ── Grid ── */
  .insights-container {
    margin-top: 3rem;
    position: relative;
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .insights-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .insights-grid { grid-template-columns: 1fr; }
  }

  /* ── Card ── */
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
    border-color: rgba(212,166,84,0.1) !important;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-border-strong) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .card-image-box {
    position: relative;
    height: 200px;
    background: var(--color-surface-2);
    overflow: hidden;
  }

  .card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .meta-dot {
    margin-inline: 0.35rem;
  }

  .card-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .card-title a {
    color: var(--color-text);
  }

  .card-title a:hover {
    color: var(--color-primary-light);
  }

  .card-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-light);
    transition: color var(--transition-fast);
  }

  .read-more:hover {
    color: var(--color-accent-light);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }

  .read-more:hover svg {
    transform: translateX(3px);
  }

  /* ── Pagination ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .page-numbers {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    min-width: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-base);
    text-decoration: none;
    cursor: pointer;
  }

  .page-btn:hover:not(.page-btn--disabled):not(.page-btn--active) {
    color: var(--color-primary-light);
    border-color: var(--color-primary-light);
    background: rgba(212, 166, 84, 0.05);
  }

  .page-btn--active {
    background: var(--color-primary);
    color: var(--color-bg);
    border-color: var(--color-primary);
    cursor: default;
  }

  .page-btn--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .page-arrow {
    gap: 0.25rem;
    padding-inline: 1rem;
  }

  /* ── Search Bar ── */
  .search-form {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    max-width: 600px;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    color: var(--color-text-muted, #7c7c7c);
    pointer-events: none;
    transition: color var(--transition-fast);
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 3rem 0.875rem 3rem;
    border-radius: var(--radius-lg, 8px);
    border: 1px solid var(--color-border, rgba(255,255,255,0.15));
    background: rgba(22, 24, 26, 0.75);
    color: var(--color-text, #ffffff);
    font-size: 1rem;
    transition: all var(--transition-base);
    backdrop-filter: blur(10px);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary-light, #f0c878);
    background: rgba(22, 24, 26, 0.9);
    box-shadow: 0 0 12px rgba(212, 166, 84, 0.25);
  }

  .search-input:focus-within + .search-icon {
    color: var(--color-primary-light, #f0c878);
  }

  .search-clear-btn {
    position: absolute;
    right: 1.25rem;
    color: var(--color-text-muted, #7c7c7c);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0;
    transition: color var(--transition-fast);
  }

  .search-clear-btn:hover {
    color: var(--color-text, #ffffff);
  }

  .search-submit-btn {
    padding-inline: 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    border-radius: var(--radius-lg, 8px);
    cursor: pointer;
  }

  @media (max-width: 576px) {
    .search-form {
      gap: 0.5rem;
    }
    .search-input {
      padding: 0.75rem 2.5rem 0.75rem 2.5rem;
      font-size: 0.875rem;
    }
    .search-icon {
      left: 0.875rem;
    }
    .search-clear-btn {
      right: 0.875rem;
    }
    .search-submit-btn {
      padding-inline: 1.25rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Programmatically handle mobile keyboard enter/go submit to guarantee compatibility
  document.querySelectorAll('.search-input').forEach(el => {
    const input = el as HTMLInputElement;
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const form = input.closest('form');
        if (form) {
          form.submit();
        }
      }
    });
  });

  function initInsightsPagination() {
    const grid = document.getElementById('insights-grid');
    const paginationNav = document.querySelector('.insights-container .pagination');
    if (!grid) return;

    const cards = grid.querySelectorAll('.blog-card');
    const urlParams = new URLSearchParams(window.location.search);
    const pageFromUrl = parseInt(urlParams.get('page') || '');
    const currentPage = !isNaN(pageFromUrl) && pageFromUrl > 0
      ? pageFromUrl
      : parseInt(grid.getAttribute('data-current-page') || '1');

    cards.forEach((card) => {
      (card as HTMLElement).style.display = 'flex';
    });

    if (paginationNav) {
      const pageButtons = paginationNav.querySelectorAll('.page-numbers .page-btn');
      pageButtons.forEach((btn) => {
        const pageNum = parseInt(btn.textContent || '1');
        if (pageNum === currentPage) {
          btn.classList.add('page-btn--active', 'active');
          btn.setAttribute('aria-current', 'page');
        } else {
          btn.classList.remove('page-btn--active', 'active');
          btn.removeAttribute('aria-current');
        }
      });
    }
  }

  initInsightsPagination();
  document.addEventListener('astro:page-load', initInsightsPagination);
</script>
