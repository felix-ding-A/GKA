---
// src/pages/es/custom-formulation.astro — Premium B2B Custom Formulation & OEM Page (Spanish)
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://ginkvora.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Desarrollo de Fórmulas', item: 'https://ginkvora.com/es/custom-formulation' },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Desarrollo de Fórmulas Personalizadas y Fabricación por Contrato | GINKVORA',
  'description': 'Servicios de fabricación por contrato y desarrollo de fórmulas personalizadas para películas de dispersión oral (OTF) y encapsulación liposomal avanzada. Soluciones B2B OEM/ODM.',
  'url': 'https://ginkvora.com/es/custom-formulation',
};
---

<BaseLayout
  title="Desarrollo de Fórmulas y Fabricación por Contrato B2B | GINKVORA"
  description="Servicios de desarrollo por contrato de GINKVORA: encapsulación liposomal, películas dispersables en boca (OTF), microencapsulación y extractos OEM/ODM."
  lang="es"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} slot="head" />

  <main class="formulation-page bg-noise">
    <!-- Hero Section -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <div class="hero-columns">
          <div class="hero-text-col reveal">
            <span class="section-label">SOLUCIONES B2B OEM/ODM</span>
            <h1 class="banner-title">Desarrollo de Fórmulas Personalizadas: <span class="gradient-text--gold">de la innovación al producto terminado</span></h1>
            <p class="banner-desc">
              Potenciamos su marca con tecnologías avanzadas de películas de dispersión oral (OTF) y microencapsulación. Desarrollo adaptado a sus necesidades específicas de ingredientes, optimizado para una máxima eficacia.
            </p>
            <div class="hero-actions">
              <a href="#inquiry-form-section" class="btn btn--gold">Solicitar presupuesto de fórmula</a>
            </div>
          </div>
          <div class="hero-visual-col reveal reveal-delay-2">
            <div class="image-showcase glass hero-carousel">
              <div class="carousel-slides">
                <div class="carousel-slide active">
                  <img
                    src="/images/ginkvora-cleanroom-manufacturing-machinery.webp"
                    alt="Equipos de producción en sala limpia clase 100,000 GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Salas limpias clase 100,000</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-gmp-capsule-bottle-filling-line.webp"
                    alt="Línea de envasado automático GMP GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Línea de envasado automático GMP</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-otf-strip-packaging-cleanroom-line.webp"
                    alt="Línea de envasado de tiras OTF GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Envasado de precisión de tiras OTF</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora%20QC%20Laboratory.webp"
                    alt="Laboratorio moderno de control de calidad QC GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Laboratorio de Control de Calidad (QC)</div>
                </div>
                <div class="carousel-slide">
                  <img
                    src="/images/ginkvora-rd-analytical-laboratory.webp"
                    alt="Laboratorio analítico de I+D GINKVORA"
                    class="showcase-img"
                    width="600"
                    height="400"
                  />
                  <div class="showcase-caption">Centro de I+D y análisis</div>
                </div>
              </div>
              
              <!-- Carousel Indicators -->
              <div class="carousel-indicators">
                <span class="indicator active" data-index="0"></span>
                <span class="indicator" data-index="1"></span>
                <span class="indicator" data-index="2"></span>
                <span class="indicator" data-index="3"></span>
                <span class="indicator" data-index="4"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- The Core Focus: OTF -->
    <section class="section otf-section bg-deep" id="otf-focus" aria-label="Oral Thin Film Technology">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Especialización clave</span>
          <h2 class="section-title">Películas de Dispersión Oral (OTF) de Alta Tecnología</h2>
          <p class="section-desc">
            Aproveche nuestra tecnología avanzada de administración en películas delgadas para diferenciar su marca de las cápsulas y tabletas tradicionales.
          </p>
        </div>

        <div class="grid-2-columns">
          <div class="visual-panel reveal">
            <div class="image-showcase glass">
              <img
                src="/images/oral-dissolving-film-benefits.webp"
                alt="Beneficios de las películas de dispersión oral (OTF) GINKVORA, incluyendo absorción rápida, matriz personalizable y alta capacidad de activos"
                class="showcase-img"
                width="600"
                height="400"
              />
            </div>
          </div>

          <div class="content-panel">
            <div class="feature-card glass reveal reveal-delay-1">
              <div class="feature-icon">⚡</div>
              <div class="feature-body">
                <h3>Rápida absorción y biodisponibilidad</h3>
                <p>
                  Evita el metabolismo de primer paso en el hígado. Se disuelve de manera instantánea en la cavidad bucal para una rápida absorción a través de la mucosa y una acción sistémica directa.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-2">
              <div class="feature-icon">🧪</div>
              <div class="feature-body">
                <h3>Matriz polimérica personalizable</h3>
                <p>
                  Tecnologías de enmascaramiento del sabor, perfiles de disolución a medida (desde instantánea hasta liberación controlada) y dosificación de componentes activos de hasta 150 mg por película.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-3">
              <div class="feature-icon">💧</div>
              <div class="feature-body">
                <h3>No requiere agua</h3>
                <p>
                  No se necesita agua para su ingesta. Proporciona la máxima comodidad para el consumo en movimiento, aumentando la adherencia y la lealtad a la marca.
                </p>
              </div>
            </div>

            <div class="feature-card glass reveal reveal-delay-4">
              <div class="feature-icon">🌿</div>
              <div class="feature-body">
                <h3>Áreas de aplicación: Anti-edad, nootrópicos y belleza</h3>
                <p>
                  Ideal para precursores de NAD+ (NMN), PQQ, glutatión y extractos botánicos. Nuestra tecnología OTF proporciona una entrega óptima de ingredientes bioactivos rejuvenecedores, apoyando la salud celular desde el interior (ECM).
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Diversified Solutions: Encapsulation -->
    <section class="container section encapsulation-section" aria-label="Encapsulation Services">
      <div class="section-header reveal">
        <span class="section-label">Sistemas de entrega diversos</span>
        <h2 class="section-title">Servicios Avanzados de Encapsulación</h2>
        <p class="section-desc">
          Además de películas delgadas, GINKVORA ofrece diversos formatos modernos de encapsulación para estabilizar sustancias sensibles y controlar la cinética de su liberación.
        </p>
      </div>

      <div class="grid-3">
        <div class="cap-card glass reveal">
          <div class="cap-icon">🧬</div>
          <h3>Encapsulación liposomal</h3>
          <p>
            Las microesferas de bicapa lipídica protegen moléculas frágiles (como la vitamina C o la glabridina) de los ácidos gástricos, maximizando la absorción intestinal.
          </p>
          <div class="cap-tag">Estabilidad y biodisponibilidad</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-1">
          <div class="cap-icon">⚪</div>
          <h3>Fabricación de Comprimidos Personalizados</h3>
          <p>
            Compresión rotativa de alta precisión para comprimidos recubiertos, masticables, sublinguales y efervescentes. Formas a medida, grabado de logo y disolución controlada.
          </p>
          <div class="cap-tag">Compresión de precisión</div>
        </div>

        <div class="cap-card glass reveal reveal-delay-2">
          <div class="cap-icon">💊</div>
          <h3>Cápsulas personalizadas</h3>
          <p>
            Llenado de precisión en cápsulas vegetarianas de HPMC y pululano. Capacidad de mezclar extractos secos complejos con un uso mínimo de excipientes.
          </p>
          <div class="cap-tag">Producción a escala</div>
        </div>
      </div>

      <div class="encap-footer-visual reveal mt-6">
        <div class="image-showcase glass">
          <img
            src="/images/ginkvora-advanced-delivery-systems-microencapsulation.webp"
            alt="Tecnologías avanzadas de formulación que combinan microencapsulación, sistemas lipoidales y formas sólidas de precisión para optimizar la biodisponibilidad"
            class="showcase-img"
            width="1632"
            height="656"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Technical Capabilities -->
    <section class="section capabilities-section bg-deep" aria-label="Technical Capabilities">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Por qué elegir GINKVORA</span>
          <h2 class="section-title">Capacidades Técnicas e I+D</h2>
          <p class="section-desc">
            Le ayudamos a trasladar las innovaciones del laboratorio a las líneas industriales de producción GMP bajo contrato.
          </p>
        </div>

        <div class="grid-3">
          <div class="capability-item reveal">
            <div class="cap-num">01</div>
            <h3>Excelencia en I+D</h3>
            <p>
              Nuestros científicos ajustan la elasticidad, el grosor, el sabor de las películas y la capacidad de carga de activos de acuerdo con sus fórmulas personalizadas.
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-1">
            <div class="cap-num">02</div>
            <h3>Estándares de calidad GMP</h3>
            <p>
              Instalaciones de salas limpias con control de temperatura y humedad que cumplen totalmente con los estándares GMP. Todos los lotes piloto y comerciales pasan por un estricto control de calidad (HPLC/ICP-MS).
            </p>
          </div>

          <div class="capability-item reveal reveal-delay-2">
            <div class="cap-num">03</div>
            <h3>Soporte integral</h3>
            <p>
              Desde el abastecimiento y análisis de materias primas hasta el desarrollo de fórmulas, pruebas piloto y el envasado en blíster final.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How We Work -->
    <section class="container section timeline-section" aria-label="Process Flow">
      <div class="section-header reveal">
        <span class="section-label">Integración paso a paso</span>
        <h2 class="section-title">Nuestro Proceso de Colaboración</h2>
        <p class="section-desc">
          Cómo guiamos el desarrollo de su producto desde la idea hasta el envío de los lotes terminados.
        </p>
      </div>

      <div class="process-timeline" role="list">
        <!-- Step 1 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">01</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal">
            <div class="step-icon-emoji">💬</div>
            <div class="step-body">
              <h3>Consulta y concepto</h3>
              <p>Discusión sobre los componentes activos (p. ej., NMN, PQQ), objetivos de dosificación, requisitos de liberación y normativas de la región de destino.</p>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">02</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-1">
            <div class="step-icon-emoji">🔬</div>
            <div class="step-body">
              <h3>Desarrollo de fórmulas</h3>
              <p>Nuestro laboratorio diseña la matriz polimérica, selecciona los agentes enmascaradores y crea muestras físicas para evaluar la estabilidad y desintegración.</p>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="process-step" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">03</span></div>
            <div class="step-line" aria-hidden="true"></div>
          </div>
          <div class="step-content glass reveal reveal-delay-2">
            <div class="step-icon-emoji">⚙️</div>
            <div class="step-body">
              <h3>Escalado y lote piloto</h3>
              <p>Trasladamos la fórmula del laboratorio a la línea piloto, probando parámetros del proceso, cinética de secado y uniformidad de la dosificación.</p>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="process-step process-step--last" role="listitem">
          <div class="step-connector">
            <div class="step-node"><span class="step-num">04</span></div>
          </div>
          <div class="step-content glass reveal reveal-delay-3">
            <div class="step-icon-emoji">📦</div>
            <div class="step-body">
              <h3>Producción industrial GMP</h3>
              <p>Tras la aprobación del lote piloto, iniciamos la producción a gran escala bajo estándares GMP, emitimos los COA y envasamos el producto terminado en tambores o blísteres.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA & Form Section -->
    <section class="section form-section bg-deep" id="inquiry-form-section" aria-label="Formulation Inquiry Form">
      <div class="container">
        <div class="grid-cta">
          <!-- Left info -->
          <div class="cta-info reveal">
            <span class="section-label">Suministro comercial</span>
            <h2>¿Listo para dar vida a su concepto?</h2>
            <p class="cta-desc">
              Póngase en contacto con nuestro equipo de desarrollo. Ofrecemos fabricación por contrato, servicios OEM/ODM (marca privada) y lotes piloto de muestras para socios calificados.
            </p>

            <div class="contact-list">
              <div class="contact-item">
                <span class="icon">📧</span>
                <div>
                  <strong>Email para consultas directas</strong>
                  <a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">📞</span>
                <div>
                  <strong>Soporte de ventas por WhatsApp</strong>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer">+86 13201818603</a>
                </div>
              </div>
            </div>

            <div class="policy-card glass mt-6">
              <h3>Guía para OEM y Marca Privada</h3>
              <ul class="policy-list">
                <li><strong>Muestras:</strong> Muestras de prueba de películas disponibles para marcas de cosméticos calificadas y fabricantes de suplementos.</li>
                <li><strong>Documentación:</strong> Con cada presupuesto se entregan certificados de análisis (COA), pruebas de metales pesados y especificaciones del proceso.</li>
                <li><strong>Materias primas:</strong> Podemos trabajar con materias primas proporcionadas por el cliente o adquirirlas a través de nuestros proveedores aprobados.</li>
              </ul>
            </div>
          </div>

          <!-- Right form -->
          <div class="cta-form-wrapper reveal reveal-delay-1">
            <div class="form-card glass">
              <h3>Solicitar presupuesto de fórmula</h3>
              <p class="form-sub">Los campos marcados con asterisco (*) son obligatorios.</p>

              <form id="formulation-quote-form" class="custom-form">
                <!-- Honeypot -->
                <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />

                <div class="form-field">
                  <label for="name" class="form-label">Nombre / Compañía *</label>
                  <input type="text" id="name" name="name" required class="form-input" placeholder="Juan Pérez / Nombre de la empresa" />
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="email" class="form-label">Email / Correo de trabajo *</label>
                    <input type="email" id="email" name="email" required class="form-input" placeholder="nombre@empresa.com" />
                  </div>
                  <div class="form-field">
                    <label for="phone" class="form-label">Teléfono / WhatsApp *</label>
                    <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+34 600 123 456" />
                  </div>
                </div>

                <div class="form-row-2">
                  <div class="form-field">
                    <label for="productConcept" class="form-label">Concepto del producto *</label>
                    <input type="text" id="productConcept" name="productConcept" required class="form-input" placeholder="Ej. película de dispersión oral, liposomas" />
                  </div>
                  <div class="form-field">
                    <label for="expectedVolume" class="form-label">Volumen esperado *</label>
                    <select id="expectedVolume" name="expectedVolume" required class="form-input form-select">
                      <option value="" disabled selected>Seleccione el volumen de pedido...</option>
                      <option value="under-100k">&lt; 100k unidades</option>
                      <option value="100k-500k">100k - 500k unidades</option>
                      <option value="over-500k">&gt; 500k unidades</option>
                    </select>
                  </div>
                </div>

                <div class="form-field">
                  <label for="message" class="form-label">Detalles de los requisitos de la fórmula</label>
                  <textarea id="message" name="message" class="form-input" rows="4" placeholder="Opcional. Describa los ingredientes activos, dosis, velocidad de disolución deseada y otras preferencias..."></textarea>
                </div>

                <button type="submit" class="btn btn--gold btn--lg btn--block" id="submit-btn">
                  Enviar solicitud de fórmula
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                  </svg>
                </button>

                <div id="success-msg" class="success-message" style="display: none;" role="alert">
                  ✓ Solicitud enviada con éxito. Nuestro equipo de I+D se pondrá en contacto con usted en un plazo de 12 horas.
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulation-page {
    padding-bottom: 0;
  }

  /* --- Hero Banner --- */
  .page-banner {
    position: relative;
    padding-block: 8rem 5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 45% 60% at 85% 20%, rgba(212, 166, 84, 0.09) 0%, transparent 100%);
  }

  .hero-columns {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .banner-desc {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .image-showcase {
    position: relative;
    width: 100%;
    max-width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.15) !important;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .showcase-img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 3/2;
    transition: transform 0.6s ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.03);
  }

  .showcase-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-primary-light);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* --- Grid layouts --- */
  .grid-2-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    margin-top: 3rem;
  }

  .content-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .grid-cta {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 4rem;
    align-items: start;
  }

  /* --- Feature Cards --- */
  .feature-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.08) !important;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .feature-card:hover {
    border-color: rgba(212, 166, 84, 0.22) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .feature-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .feature-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-light);
    margin-bottom: 0.5rem;
  }

  .feature-body p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* --- Encapsulation Cards --- */
  .cap-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
