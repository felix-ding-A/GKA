---
// src/pages/es/about.astro — Spanish About page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { getAllAuthors, urlFor, getLocalizedField } from '../../lib/sanity';

const lang = 'es';
const t = useTranslations(lang);
const authors = await getAllAuthors();

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Sobre GINKVORA",
  "description": "GINKVORA suministra ingredientes botánicos y bioactivos y ofrece personalización OEM. Conozca nuestros datos empresariales y proceso de suministro.",
  "url": "https://ginkvora.com/es/about",
  "mainEntity": authors.map(author => ({
    "@type": "Person",
    "name": getLocalizedField(author, 'name', lang) || author.name,
    "jobTitle": getLocalizedField(author, 'title', lang) || author.title || undefined,
    "description": getLocalizedField(author, 'bio', lang) || author.bio || undefined,
    "image": author.avatar ? urlFor(author.avatar).url() : undefined
  }))
};
---

<BaseLayout
  lang={lang}
  title="Proveedor de ingredientes bioactivos | Sobre GINKVORA"
  description="GINKVORA suministra ingredientes botánicos y bioactivos y ofrece personalización OEM. Conozca nuestros datos empresariales y proceso de suministro."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} slot="head" />
  <main class="about-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Encabezado de página">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">{t('about.label')}</span>
        <h1 class="banner-title fade-in-up delay-1">Experiencia Botánica. Suministro de Ingredientes Bioactivos.</h1>
        <p class="banner-desc fade-in-up delay-2">Extractos botánicos, activos cosméticos, péptidos e ingredientes funcionales, con personalización OEM para el cuidado de la piel, la nutrición y el bienestar.</p>
      </div>
    </header>

    <!-- Company Intro -->
    <section class="container section intro-section" aria-label="Descripción de la empresa">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>Sobre GINKVORA</h2>
          <p>GINKVORA suministra extractos botánicos, activos cosméticos, péptidos e ingredientes funcionales para aplicaciones de cuidado de la piel, nutrición y bienestar, junto con servicios de personalización OEM.</p>
          <p>Atendemos a distribuidores, revendedores, formuladores y fabricantes de todo el mundo. También suministramos materias primas cosméticas a salones de belleza y ofrecemos productos personalizados mediante OEM a organizaciones de gestión de la salud.</p>
          <p>Con sede en Xi&#x27;an, China, coordinamos el abastecimiento de ingredientes, la definición de especificaciones, la documentación y las entregas internacionales. Nuestro objetivo es sencillo: ayudar a los clientes a obtener ingredientes adecuados y desarrollar productos personalizados con requisitos claros, apoyo práctico y un punto de contacto directo.</p>
          <div class="mission-box">
            <span class="mission-title">Nuestra Misión Principal</span>
            <blockquote class="mission-text">
              «Empoderar a las marcas de salud humana mediante la entrega de una pureza absoluta de los componentes activos, registros de control de calidad verificables y soluciones de suministro a granel confiables.»
            </blockquote>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2">
          <div class="image-showcase glass">
            <img
              src="/images/ginkvora-rd-analytical-laboratory.webp"
              alt="Instalaciones del laboratorio de I+D de GINKVORA"
              class="showcase-img"
              width="800"
              height="600"
            />
            <div class="floating-caption">
              <strong>Centro de I+D en Xi'an</strong>
              <span>Análisis por HPLC y Espectrometría de Masas</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Information -->
    <section class="container section company-section" aria-labelledby="company-information">
      <div class="company-grid">
        <div class="reveal">
          <span class="section-label">Datos de la empresa</span>
          <h2 id="company-information">Información de la empresa</h2>
        </div>
        <dl class="company-card glass reveal">
          <div><dt>Razón social</dt><dd>Shaanxi Ginkvora Biotechnology Co., Ltd.</dd></div>
          <div><dt>Número D-U-N-S®</dt><dd>975262249</dd></div>
          <div><dt>Domicilio social</dt><dd><address>Room 502, Unit 1, Building 16,<br />CR Land Future City Chenxi, Gangfeng Road,<br />International Trade &amp; Logistics Park,<br />Xi'an, Shaanxi, China</address></dd></div>
          <div><dt>Correo electrónico comercial</dt><dd><a href="mailto:inquiry@ginkvora.com">inquiry@ginkvora.com</a></dd></div>
        </dl>
      </div>
    </section>

    <!-- Managed Sourcing Stages -->
    <section class="section values-section bg-deep" aria-labelledby="how-we-work">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Cómo trabajamos</span>
          <h2 class="section-title" id="how-we-work">Un punto de contacto. Cuatro etapas coordinadas.</h2>
          <p class="section-desc">Al comprar a GINKVORA, dispone de un único punto de contacto que coordina el abastecimiento, la documentación, la verificación de lotes y la entrega.</p>
        </div>
        <div class="stages-grid">
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">01</div>
            <h3>Evaluación de proveedores y especificaciones</h3><p>Evaluamos a los productores y confirmamos el grado del ingrediente, las especificaciones y los requisitos del pedido antes de la compra.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">02</div>
            <h3>Documentación del lote</h3><p>Coordinamos el COA específico de cada lote y la documentación complementaria pertinente, incluidas MSDS, TDS e informes de ensayo disponibles, según el producto y sus requisitos documentales.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">03</div>
            <h3>Verificación de calidad</h3><p>Revisamos los resultados del lote frente a las especificaciones acordadas antes del despacho. Según el ingrediente, pueden incluir pureza y contenido por HPLC, metales pesados, disolventes residuales y límites microbiológicos. Los requisitos de ensayos adicionales se acuerdan antes de confirmar el pedido.</p>
          </article>
          <article class="value-card glass reveal">
            <div class="value-icon" aria-hidden="true">04</div>
            <h3>Embalaje y entrega</h3><p>Organizamos envíos por mensajería exprés, transporte aéreo o marítimo conforme a los Incoterms acordados y confirmamos con usted los requisitos de embalaje y los plazos de despacho. Se puede coordinar el envasado con barrido de nitrógeno para los activos sensibles que lo requieran y sean compatibles con este método.</p>
          </article>
        </div>
        <p class="process-note">Durante todo el proceso, dispone de un contacto directo para las especificaciones, la documentación y las actualizaciones de entrega.</p>
      </div>
    </section>

    <!-- Authors Section -->
    <section class="container section authors-section" aria-label="Nuestros asesores y colaboradores técnicos">
      <div class="section-header">
        <span class="section-label">Experiencia y colaboración</span>
        <h2>Nuestros asesores y colaboradores técnicos</h2>
        <p class="section-desc">Conozca a los profesionales independientes que colaboran con GINKVORA en proyectos científicos, de formulación, regulatorios y comerciales.</p>
      </div>

      <div class="authors-grid">
        {authors.map((author) => (
          <div class="author-card glass reveal">
            <div class="author-avatar-wrapper">
              <img
                src={urlFor(author.avatar).width(160).height(160).fit('crop').url()}
                alt={author.name}
                class="author-avatar"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="author-info">
              <h3>{getLocalizedField(author, 'name', lang) || author.name}</h3>
              {(getLocalizedField(author, 'title', lang) || author.title) && <p class="author-title">{getLocalizedField(author, 'title', lang) || author.title}</p>}
              {(getLocalizedField(author, 'credentials', lang) || author.credentials) && <span class="author-creds">{getLocalizedField(author, 'credentials', lang) || author.credentials}</span>}
              {(getLocalizedField(author, 'bio', lang) || author.bio) && <p class="author-bio">{getLocalizedField(author, 'bio', lang) || author.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline/History Section -->
    <section class="container section history-section" aria-label="Nuestra historia">
      <div class="section-header">
        <span class="section-label">Nuestro Viaje</span>
        <h2>Crecimiento e Hitos</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-badge">2023</div>
          <div class="timeline-content glass">
            <h3>Establecimiento e I+D Inicial</h3>
            <p>GINKVORA fundada en Xi'an, especializándose en investigación de cofactores mitocondriales y lanzamiento de canales de suministro de PQQ y NMN de alta pureza.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-1">
          <div class="timeline-badge">2024</div>
          <div class="timeline-content glass">
            <h3>Certificación GMP e ISO</h3>
            <p>Finalización de la construcción de nuestra planta de extracción asociada. Obtención de certificaciones GMP, ISO 9001:2015, Halal y Kosher para el cumplimiento alimentario global.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-2">
          <div class="timeline-badge">2025</div>
          <div class="timeline-content glass">
            <h3>Lanzamiento de Línea Cosmética y de Mascotas</h3>
            <p>Ampliación de nuestro catálogo químico para incluir activos blanqueadores de Glabridina, flavonoides naturales e ingredientes nutricionales especializados para el sector del bienestar de las mascotas.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-3">
          <div class="timeline-badge">2026</div>
          <div class="timeline-content glass">
            <h3>Logística global y lanzamiento de la plataforma digital</h3>
            <p>Lanzamiento de una red de suministro internacional de alto rendimiento que atiende a marcas de suplementos, cuidado de la piel y nutrición deportiva en más de 50 países a través de centros logísticos optimizados.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="container section cta-section">
      <div class="cta-box glass">
        <h2>¿Listo para una Alianza?</h2>
        <p>Póngase en contacto con nuestro departamento comercial para obtener la lista de precios, hojas de especificaciones y muestras.</p>
        <div class="cta-btns">
          <a href="/es/contact" class="btn btn--gold btn--lg">Contáctenos</a>
          <a href="/es/products" class="btn btn--primary btn--lg">Catálogo de Productos</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .company-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start; }
  .company-grid h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-top: 0.5rem; }
  .company-card { margin: 0; padding: 2rem; border-radius: var(--radius-lg); min-width: 0; }
  .company-card > div { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .company-card > div:first-child { padding-top: 0; }
  .company-card > div:last-child { padding-bottom: 0; border-bottom: 0; }
  .company-card dt { color: var(--color-primary-light); font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem; }
  .company-card dd { margin: 0; color: var(--color-text); line-height: 1.75; overflow-wrap: anywhere; }
  .company-card address { font-style: normal; }
  .company-card a:hover { text-decoration: underline; }
  .stages-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .stages-grid .value-card { text-align: start; }
  .stages-grid .value-icon { color: var(--color-primary-light); font-family: var(--font-mono); font-size: 1.5rem; }
  .process-note { text-align: center; max-width: 760px; margin: 2rem auto 0; color: var(--color-text-secondary); }
  @media (max-width: 768px) {
    .company-grid, .stages-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .company-card { padding: 1.5rem; }
  }


  .about-page { padding-block: 0 var(--space-4xl); }
  .page-banner { position: relative; padding-block: 8rem 5rem; background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%); overflow: hidden; margin-bottom: var(--space-2xl); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%); }
  .banner-content { position: relative; z-index: 1; text-align: center; max-width: 700px; margin-inline: auto; }
  .banner-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
  .banner-desc { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.75; }

  .section { padding-block: var(--space-2xl); }
  .intro-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; } }

  .intro-left { display: flex; flex-direction: column; gap: 1.25rem; }
  .intro-left h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); font-family: var(--font-display); font-weight: 600; color: var(--color-text); }
  .intro-left p { color: var(--color-text-secondary); line-height: 1.8; font-size: 1rem; }

  .mission-box {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .mission-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary-light); font-weight: 600; display: block; margin-bottom: 0.5rem; }
  .mission-text { font-family: var(--font-display); font-size: 1.125rem; font-style: italic; color: var(--color-text); line-height: 1.6; }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
    cursor: pointer;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 400ms) ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.05);
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Values Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212,166,84,0.1) !important;
    text-align: center;
    transition: all var(--transition-base, 250ms) ease;
  }

  .value-card:hover {
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-6px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 3rem auto 0;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-badge {
    position: absolute;
    left: calc(-2rem - 13px);
    top: 0.5rem;
    width: 26px;
    height: 26px;
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-primary-light);
    box-shadow: 0 0 10px rgba(212,166,84,0.3);
  }

  .timeline-content {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border-color: rgba(212,166,84,0.12) !important;
    transition: all var(--transition-base, 250ms) ease;
  }

  .timeline-content:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-gold);
  }

  .timeline-content h3 {
    font-size: 1.125rem;
    color: var(--color-primary-light);
    margin-bottom: 0.25rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .section-header { text-align: center; margin-bottom: var(--space-xl); }
  .section-title { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-family: var(--font-display); font-weight: 600; }
  .section-desc { color: var(--color-text-secondary); margin-top: 0.5rem; }

  .certs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem; }
  .cert-card {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border: 1px solid rgba(212,166,84,0.15) !important;
    transition: all var(--transition-base, 250ms) ease;
  }
  .cert-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow-gold);
  }
  .cert-icon { font-size: 1.5rem; color: var(--color-primary); }
  .cert-name { font-family: var(--font-mono); font-size: 0.875rem; font-weight: 600; color: var(--color-text); }

  .cta-box { padding: 3.5rem; border-radius: var(--radius-xl); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; border: 1px solid rgba(212,166,84,0.2) !important; }
  .cta-box h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-family: var(--font-display); }
  .cta-box p { color: var(--color-text-secondary); max-width: 520px; line-height: 1.75; }
  .cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

  /* ── Authors Section ── */
  .authors-section {
    margin-top: 2rem;
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .authors-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .author-card {
    display: flex;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    align-items: center;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (max-width: 540px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
    }
  }

  .author-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow-gold);
  }

  .author-avatar-wrapper {
    flex-shrink: 0;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary-light);
    box-shadow: 0 0 15px rgba(212, 166, 84, 0.15);
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base, 250ms) ease;
  }

  .author-card:hover .author-avatar {
    transform: scale(1.08);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-info h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .author-title {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    font-weight: 500;
  }

  .author-creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: rgba(212, 166, 84, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    align-self: start;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 540px) {
    .author-creds {
      align-self: center;
    }
  }

  .author-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }
</style>
